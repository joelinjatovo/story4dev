<tr data-row="0" class="kt-datatable__row graph-item" style="left: 0px;">
    <td data-field="User" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="width: 222px;">
            <div class="kt-user-card-v2">
                <div class="kt-user-card-v2__details">
                    <a class="kt-user-card-v2__name" href="{{ path('graph_show', { 'slug': graph.project.slug, 'graph_id': graph.id }) }}">{{ graph.title }}</a>
                </div>
            </div>
        </span>
    </td>
    <td data-field="Début" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="btn btn-bold btn-sm btn-font-sm  btn-label-success">{{ graph.project.startat|date("Y-m-d") }}</span></span>
    </td>
    <td data-field="Fin" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="btn btn-bold btn-sm btn-font-sm  btn-label-danger">{{ graph.project.endat|date("Y-m-d") }}</span></span>
    </td>
    <td data-field="Data" class="kt-datatable__cell">
        <span style="width: 100px;">{{ graph.axes.count }} axes</span>
    </td>
    <td data-field="Actions" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="overflow: visible; position: relative; width: 150px;">
            {% if is_granted('edit', graph) %}
                <a href="{{ path('graph_edit', { 'slug': graph.project.slug, 'graph_id': graph.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                    <i class="la la-edit"></i>
                </a>
            {% endif %}
            {% if is_granted('view', graph) %}
                <a href="{{ path('graph_show', { 'slug': graph.project.slug, 'graph_id': graph.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                    <i class="la la-eye"></i>
                </a>
            {% endif %}
            {% if is_granted('remove', graph) %}
                <a title="Supprimer cette activité" data-id="{{ graph.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-remove">
                    <i class="la la-trash"></i>
                </a>
            {% endif %}
        </span>
    </td>
</tr>