{% extends 'base.html.twig' %}

{% block title %}Graphe #{{ graph.id }} - Projet #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{{ graph.title }}</h3>
        </div>
        <div class="kt-subheader__toolbar">
            <div class="kt-subheader__wrapper">
                <a href="{{ path('project_show', { slug : project.slug } ) }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i>Retour</a>
                {% if is_granted('edit', graph) %}
                    <a href="{{ path('graph_edit', { 'graph_id' : graph.id, 'slug' : graph.project.slug } ) }}" class="btn kt-subheader__btn-primary">Modifier &nbsp;</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-xl-12">
        <div class="kt-portlet kt-portlet--height-fluid" id="statistic">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label">
                    <h3 class="kt-portlet__head-title">
                        Statistiques
                    </h3>
                </div>
                <div class="kt-portlet__head-toolbar">
					<div class="kt-portlet__head-actions">
						<div class="dropdown dropdown-inline">
							<a href="#" class="btn btn-default btn-pill btn-sm" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
								<i class="flaticon2-settings"></i> Exporter 
							</a>
							<div class="dropdown-menu dropdown-menu-right" x-placement="top-end" style="position: absolute; will-change: transform; top: 0px; left: 0px; transform: translate3d(32px, 0px, 0px);">
								<ul class="kt-nav" id="chart-selector">
                                    <li class="kt-nav__item" data-click="PNG">
                                        <a href="#" class="kt-nav__link">
                                            <i class="kt-nav__link-icon flaticon2-line-chart"></i>
                                            <span class="kt-nav__link-text">Image</span>
                                        </a>
                                    </li>
                                    <li class="kt-nav__item" data-click="PDF">
                                        <a href="#" class="kt-nav__link">
                                            <i class="kt-nav__link-icon flaticon2-send"></i>
                                            <span class="kt-nav__link-text">PDF</span>
                                        </a>
                                    </li>
                                    <li class="kt-nav__item" data-click="PRINT">
                                        <a href="#" class="kt-nav__link">
                                            <i class="kt-nav__link-icon flaticon2-pie-chart-1"></i>
                                            <span class="kt-nav__link-text">Impression</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
						</div>
					</div>
				</div>
            </div>
            <div class="kt-portlet__body">
                <div class="form-group form-group-last row">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <select class="form-control kt-select2" id="select_indicator"  multiple="multiple">
                            {% for indicator in indicators %}
                                <option value="{{ indicator.id }}" {{ indicator in chart.indicators ? 'selected' : '' }}>{{ indicator.title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div id="chartdiv" style="width: 100%; height: 500px;"></div>
            </div>
        </div>
    </div>
</div>
{% endblock %}


{% block javascripts %}
<!-- Resources -->
<script src="{{ asset('js/am4chart/core.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/am4chart/charts.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/am4chart/animated.js') }}" type="text/javascript" ></script>

<!-- Chart code -->
<script>
var KTAppMessages = {"waiting": "Veuillez patientez s'il vous plaît..."};
am4core.ready(function() {
    // Themes begin
    am4core.useTheme(am4themes_animated);
    // Themes end

    // Create chart instance
    var chart = am4core.create("chartdiv", am4charts.XYChart);

    chart.data = {{ chart.data|json|raw }};

    var categoryAxis = chart.xAxes.push(new am4charts.CategoryAxis());
    categoryAxis.dataFields.category = "iteration";
    
    var valueAxis1 = chart.yAxes.push(new am4charts.ValueAxis());
    valueAxis1.title.text = "Valeur par unité";

    // Create series
    var series4 = chart.series.push(new am4charts.LineSeries());
        series4.dataFields.valueY = "value";
        series4.dataFields.categoryX = "iteration";
        series4.yAxis = valueAxis1;
        series4.name = "Total";
        series4.tooltipText = "{name}\n[bold font-size: 20]{valueY}[/] unités";
        series4.fill = chart.colors.getIndex(0).lighten(0.5);
        series4.strokeWidth = 2;

        var bullet4 = series4.bullets.push(new am4charts.CircleBullet());
            bullet4.circle.radius = 3;
            bullet4.circle.strokeWidth = 2;
            bullet4.circle.fill = am4core.color("#fff");
    
    // Add cursor
    chart.cursor = new am4charts.XYCursor();

    // Add legend
    chart.legend = new am4charts.Legend();
    chart.legend.position = "top";
    
    // var
    var ajaxRequest;
    var activitySeries = [];
    activitySeries = [];
    
    var dataSeries = {{ chart.series|json|raw }};
    jQuery.each(dataSeries, function(index, value) {
        activitySeries[index] = chart.series.push(new am4charts.ColumnSeries());
        activitySeries[index].dataFields.valueY = value.id;
        activitySeries[index].dataFields.categoryX = "iteration";
        activitySeries[index].name = value.title;
        activitySeries[index].unit = value.unit;
        activitySeries[index].strokeWidth = 2;
        //activitySeries[index].tensionX = 0.7;
        activitySeries[index].yAxis = valueAxis1;
        activitySeries[index].tooltipText = "{name}\n[bold font-size: 20]{valueY}[/] {unit}";
        //activitySeries[index].stroke = chart.colors.getIndex(0).lighten(0.5);
        //activitySeries[index].strokeDasharray = "3,3";
        //activitySeries[index].hidden = true;
        activitySeries[index].hiddenInLegend = true; 

        /*
        var bullet4 = activitySeries[index].bullets.push(new am4charts.CircleBullet());
            bullet4.circle.radius = 3;
            bullet4.circle.strokeWidth = 2;
            bullet4.circle.fill = am4core.color("#fff");
        */
    });
    
    // Selector
    jQuery("#select_indicator").select2({placeholder:"Séléctionnez les indicateurs à afficher sur le graphe."});
    jQuery('#select_indicator').on('change', function (evt) {
        if (jQuery('#select_indicator').select2('val') != null){
            var container = jQuery("#statistic");
            var $datas = jQuery('#select_indicator').select2('data');
            
            var ids = [];
            jQuery.each($datas, function(index, $data) {
                ids.push(parseInt($data.id));
            });
            
            KTApp.block(container,{overlayColor:"#000000",type:"v2",state:"primary",message: KTAppMessages.waiting});
            
            if (typeof ajaxRequest !== 'undefined'){
                ajaxRequest.abort();
            }
      
            ajaxRequest = jQuery.get({
                url:"{{ path('graph_show', {slug:project.slug, graph_id: graph.id}) }}",
                data: {'indicators': ids},
                error:function(d){
                    KTApp.unblock(container);
                },
                success:function(t,s,r,a){
                    console.log(t);
                    KTApp.unblock(container);
                    if(t.success===true){
                        window.history.pushState(null, null, t.url);
                        
                        chart.data = t.chart.data;
                        
                        // remove old series
                        jQuery.each(activitySeries, function(index, serie) {
                            console.log(index);
                            console.log(serie);
                            chart.series.removeIndex(
                              chart.series.indexOf(serie)
                            );
                        });
                        
                        // new series
                        activitySeries = [];
                        jQuery.each(t.chart.series, function(index, value) {
                            activitySeries[index] = chart.series.push(new am4charts.ColumnSeries());
                            activitySeries[index].dataFields.valueY = value.id;
                            activitySeries[index].dataFields.categoryX = "iteration";
                            activitySeries[index].name = value.title;
                            activitySeries[index].unit = value.unit;
                            activitySeries[index].strokeWidth = 2;
                            //activitySeries[index].tensionX = 0.7;
                            activitySeries[index].yAxis = valueAxis1;
                            activitySeries[index].tooltipText = "{name}\n[bold font-size: 20]{valueY}[/] {unit}";
                            //activitySeries[index].stroke = chart.colors.getIndex(0).lighten(0.5);
                            //activitySeries[index].strokeDasharray = "3,3";
                            //activitySeries[index].hidden = true;
                            activitySeries[index].hiddenInLegend = true; 

                            /*
                            var bullet4 = activitySeries[index].bullets.push(new am4charts.CircleBullet());
                                bullet4.circle.radius = 3;
                                bullet4.circle.strokeWidth = 2;
                                bullet4.circle.fill = am4core.color("#fff");
                            */
                        });
                        
                        chart.invalidateData();
                    }else{
                    }
                }
            });
        }
    });

    jQuery('#chart-selector .kt-nav__item').on('click', function(e) {
        var format = jQuery(this).data('click');
        chart.exporting.export(format.toLowerCase());
    });

}); // end am4core.ready()
    
</script>
{% endblock %}
