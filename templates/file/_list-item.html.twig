<div class="col-xl-3 col-lg-6 col-md-6">
    <div class="kt-portlet">
        <div class="kt-portlet__head kt-portlet__head--noborder">
            <div class="kt-portlet__head-label">
                <h3 class="kt-portlet__head-title"></h3>
            </div>
            <div class="kt-portlet__head-toolbar">
                <a href="#" class="btn btn-clean btn-sm btn-icon btn-icon-md" data-toggle="dropdown">
                    <i class="flaticon-more-1"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right">
                    <ul class="kt-nav">
                        <li class="kt-nav__item">
                            <a href="{{ path( 'file_show', { file_id: file.id } ) }}" class="kt-nav__link">
                            <i class="kt-nav__link-icon flaticon2-line-chart"></i>
                            <span class="kt-nav__link-text">Ouvrir</span>
                            </a>
                        </li>
                        <li class="kt-nav__item">
                            <a href="#" class="kt-nav__link">
                            <i class="kt-nav__link-icon flaticon2-send"></i>
                            <span class="kt-nav__link-text">Edit</span>
                            </a>
                        </li>
                        <li class="kt-nav__item">
                            <a href="{{ path( 'file_download', { id: file.id } ) }}" class="kt-nav__link">
                            <i class="kt-nav__link-icon flaticon2-pie-chart-1"></i>
                            <span class="kt-nav__link-text">Download</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="kt-portlet__body">
            {% if file.image %}
                <div class="kt-widget__files">
                    <div class="kt-widget__media">
                        <a href="{{ asset(file.icone) | imagine_filter('big') }}" data-toggle="lightbox" data-gallery="gallery"><img class="kt-widget__img kt-hidden-" src="{{ asset(file.icone) | imagine_filter('thumb') }}" alt="image"></a>
                    </div>
                    <a href="{{ asset(file.icone) | imagine_filter('big') }}" class="kt-widget__desc" data-toggle="lightbox" data-gallery="gallery">
                        {{ file.name }}
                    </a>
                </div>
            {% else %}
                <div class="kt-widget__files">
                    <div class="kt-widget__media">
                        <a href="{{ asset(file.icone) }}" data-toggle="lightbox" data-gallery="gallery"><img class="kt-widget__img kt-hidden-" src="{{ asset(file.icone) | imagine_filter('thumb') }}" alt="image"></a>
                    </div>
                    <a href="{{ asset(file.icone) }}" class="kt-widget__desc" data-toggle="lightbox" data-gallery="gallery">
                        {{ file.name }}
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
