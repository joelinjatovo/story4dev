{% extends 'base.html.twig' %}

{% block title %}File Application{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('css/todo.css') }}" rel="stylesheet" type="text/css"/>
{% endblock %}

{% block content %}
<div class="kt-grid kt-grid--desktop kt-grid--ver-desktop  kt-todo" id="kt_todo">
    <!--Begin::Aside Mobile Toggle-->
    <button class="kt-todo__aside-close" id="kt_todo_aside_close">
        <i class="la la-close"></i>
    </button>
    <!--End:: Aside Mobile Toggle-->

    <!--Begin:: Tasks Aside-->
    <div class="kt-grid__item   kt-portlet kt-todo__aside" id="kt_todo_aside">
        
        <div class="kt-todo__nav">
            <ul class="kt-nav">
              <li class="kt-nav__item">
                  <a href="{{ path( 'file_list', { slug: app.user.slug } ) }}" class="kt-nav__link" data-action="list" data-type="inbox">
                      <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-nav__link-icon">
                        <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                            <rect x="0" y="0" width="24" height="24"></rect>
                            <path d="M2.56066017,10.6819805 L4.68198052,8.56066017 C5.26776695,7.97487373 6.21751442,7.97487373 6.80330086,8.56066017 L8.9246212,10.6819805 C9.51040764,11.267767 9.51040764,12.2175144 8.9246212,12.8033009 L6.80330086,14.9246212 C6.21751442,15.5104076 5.26776695,15.5104076 4.68198052,14.9246212 L2.56066017,12.8033009 C1.97487373,12.2175144 1.97487373,11.267767 2.56066017,10.6819805 Z M14.5606602,10.6819805 L16.6819805,8.56066017 C17.267767,7.97487373 18.2175144,7.97487373 18.8033009,8.56066017 L20.9246212,10.6819805 C21.5104076,11.267767 21.5104076,12.2175144 20.9246212,12.8033009 L18.8033009,14.9246212 C18.2175144,15.5104076 17.267767,15.5104076 16.6819805,14.9246212 L14.5606602,12.8033009 C13.9748737,12.2175144 13.9748737,11.267767 14.5606602,10.6819805 Z" fill="#000000" opacity="0.3"></path>
                            <path d="M8.56066017,16.6819805 L10.6819805,14.5606602 C11.267767,13.9748737 12.2175144,13.9748737 12.8033009,14.5606602 L14.9246212,16.6819805 C15.5104076,17.267767 15.5104076,18.2175144 14.9246212,18.8033009 L12.8033009,20.9246212 C12.2175144,21.5104076 11.267767,21.5104076 10.6819805,20.9246212 L8.56066017,18.8033009 C7.97487373,18.2175144 7.97487373,17.267767 8.56066017,16.6819805 Z M8.56066017,4.68198052 L10.6819805,2.56066017 C11.267767,1.97487373 12.2175144,1.97487373 12.8033009,2.56066017 L14.9246212,4.68198052 C15.5104076,5.26776695 15.5104076,6.21751442 14.9246212,6.80330086 L12.8033009,8.9246212 C12.2175144,9.51040764 11.267767,9.51040764 10.6819805,8.9246212 L8.56066017,6.80330086 C7.97487373,6.21751442 7.97487373,5.26776695 8.56066017,4.68198052 Z" fill="#000000"></path>
                        </g>
                      </svg>
                      <span class="kt-nav__link-text">Tous les fichiers</span>

                  </a>
              </li>

              <li class="kt-nav__item kt-margin-t-20 kt-margin-b-20">
                  <span class="kt-nav__link-title">Projects</span>
              </li>

              {% for project in projects %}
              <li class="kt-nav__item">
                  <a href="{{ path( 'file_list_project', { slug: app.user.slug, project_id: project.id } ) }}" class="kt-nav__link" data-action="list" data-type="marked">
                      <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-nav__link-icon">
                        <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                            <polygon points="0 0 24 0 24 24 0 24"></polygon>
                            <path d="M12.2928955,6.70710318 C11.9023712,6.31657888 11.9023712,5.68341391 12.2928955,5.29288961 C12.6834198,4.90236532 13.3165848,4.90236532 13.7071091,5.29288961 L19.7071091,11.2928896 C20.085688,11.6714686 20.0989336,12.281055 19.7371564,12.675721 L14.2371564,18.675721 C13.863964,19.08284 13.2313966,19.1103429 12.8242777,18.7371505 C12.4171587,18.3639581 12.3896557,17.7313908 12.7628481,17.3242718 L17.6158645,12.0300721 L12.2928955,6.70710318 Z" fill="#000000" fill-rule="nonzero"></path>
                            <path d="M3.70710678,15.7071068 C3.31658249,16.0976311 2.68341751,16.0976311 2.29289322,15.7071068 C1.90236893,15.3165825 1.90236893,14.6834175 2.29289322,14.2928932 L8.29289322,8.29289322 C8.67147216,7.91431428 9.28105859,7.90106866 9.67572463,8.26284586 L15.6757246,13.7628459 C16.0828436,14.1360383 16.1103465,14.7686056 15.7371541,15.1757246 C15.3639617,15.5828436 14.7313944,15.6103465 14.3242754,15.2371541 L9.03007575,10.3841378 L3.70710678,15.7071068 Z" fill="#000000" fill-rule="nonzero" opacity="0.3" transform="translate(9.000003, 11.999999) rotate(-270.000000) translate(-9.000003, -11.999999) "></path>
                        </g>
                        </svg>
                      <span class="kt-nav__link-text">{{ project.title }}</span>
                  </a>
              </li>
              {% endfor %}
                
              <li class="kt-nav__item">
                  <a href="#" class="kt-nav__link" data-action="list" data-type="trash">
                      <i class="kt-nav__link-icon kt-nav__link-icon--size fa flaticon2-plus"></i>
                      <span class="kt-nav__link-text">Add Project</span>
                  </a>
              </li>

              <li class="kt-nav__item kt-margin-t-20 kt-margin-b-20">
                  <span class="kt-nav__link-title">Tags</span>
              </li>

              <li class="kt-nav__item">
                  <a href="#" class="kt-nav__link">
                      <i class="kt-nav__link-icon fa fa-genderless kt-font-warning"></i>
                      <span class="kt-nav__link-text">Custom Work</span>
                  </a>
              </li>
              <li class="kt-nav__item">
                  <a href="#" class="kt-nav__link">
                      <i class="kt-nav__link-icon fa fa-genderless kt-font-success"></i>
                      <span class="kt-nav__link-text">Partnership</span>
                  </a>
              </li>
              <li class="kt-nav__item">
                  <a href="#" class="kt-nav__link">
                      <i class="kt-nav__link-icon fa fa-genderless kt-font-info"></i>
                      <span class="kt-nav__link-text">In Progres</span>
                  </a>
              </li>
              <li class="kt-nav__item">
                  <a href="#" class="kt-nav__link">
                      <i class="kt-nav__link-icon fa flaticon2-plus"></i>
                      <span class="kt-nav__link-text">Add Tog</span>
                  </a>
              </li>
            </ul>
        </div>
    </div>
    <!--End:: Tasks Aside-->

    <!--Begin:: Tasks Content-->
    <div class="kt-grid__item kt-grid__item--fluid kt-todo__content" id="kt_todo_content">
        <div class="kt-todo__top">
            <div class="kt-portlet">
              <!--Begin:: Tasks Toolbar-->
              <div class="kt-todo__header">
                <h3 class="kt-todo__title">Tous les fichiers</h3>

                <!--Begin:: Tasks Nav-->
                <div class="kt-todo__nav">
                    <a href="#" class="kt-todo__link kt-todo__link--active">Files</a>
                    
                    <a href="#" class="kt-todo__link ">PDF</a>

                    <a href="#" class="kt-todo__link ">Docs</a>

                    <a href="#" class="btn btn-clean btn-icon" data-toggle="dropdown" aria-expanded="false">
                        <i class="flaticon-more-1"></i>
                    </a>
                </div>
                <!--End:: Tasks Nav-->

                <!--Begin:: Tasks Users-->
                <div class="kt-todo__users">
                    <a href="#" class="kt-media kt-media--xs kt-media--danger" data-toggle="kt-tooltip" data-placement="top" title="" data-original-title="Sean Stone">
                        <span>3</span>
                    </a>
                    <a href="#" class="kt-media kt-media--xs kt-media--danger" data-toggle="kt-tooltip" data-placement="top" title="" data-original-title="Sean Stone">
                        <span>S</span>
                    </a>
                    <a href="#" class="kt-media kt-media--xs  kt-media--info" data-toggle="kt-tooltip" data-placement="top" title="" data-original-title="Anna Krox">
                        <span>A</span>
                    </a>
                    <a href="#" class="kt-media kt-media--xs  kt-bg-success kt-margin-l-10" data-toggle="kt-tooltip" data-placement="top" title="" data-original-title="Add Participants">
                        <span><i class="kt-nav__link-icon fa flaticon2-plus kt-font-light"></i></span>
                    </a>
                </div>
                <!--End:: Tasks Users-->
              </div>
              <!--End:: Tasks Toolbar-->
            </div>
        </div>

        <div class="kt-todo__bottom">
          {% block subcontent %}
          {% endblock %}
        </div>
    </div>
    <!--End:: Tasks Content-->
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/todo.js') }}" type="text/javascript" ></script>
{% endblock %}