{% extends 'file/base.html.twig' %}

{% block title %}Images{% if project is not null %} - Projet #{{ project.id}} {% endif %} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/gallery.css') }}" rel="stylesheet" type="text/css"/>
{% endblock %}
    
{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">Images</h3>
            <span class="kt-subheader__separator kt-hidden"></span>
            <div class="kt-subheader__breadcrumbs kt-hidden">
                <a href="#" class="kt-subheader__breadcrumbs-home"><i class="flaticon2-shelter"></i></a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="" class="kt-subheader__breadcrumbs-link">Apps</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="" class="kt-subheader__breadcrumbs-link">Todo</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="" class="kt-subheader__breadcrumbs-link">Files</a>
                <!-- <span class="kt-subheader__breadcrumbs-link kt-subheader__breadcrumbs-link--active">Active link</span> -->
            </div>
        </div>
    </div>
</div>
{% endblock %}


{% block subcontent %}
<div class="row" id="files-list">
    <div class="col-xl-12">  
        <div id="gallery" style="display:none;">
            {% for file in files %}
                {{ include('file/_image-item.html.twig', {'file': file}) }}
            {% endfor %}
        </div>
    </div>
</div>
    
<div class="row">
    <div class="col-xl-12">       
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <!--begin: Pagination-->
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': files}) }}
                </div>
                <!--end: Pagination-->
            </div>
        </div>
    </div>           
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/gallery.min.js') }}" type="text/javascript" ></script>
    <script src="{{ asset('js/gallery-theme-tiles.js') }}" type="text/javascript" ></script>
    <script type="text/javascript"> 
        jQuery(document).ready(function(){ 
            if( ( jQuery("#gallery") != undefined ) && ( jQuery("#gallery img").length > 0 ) ) {
                jQuery("#gallery").unitegallery(); 
            }
        }); 
    </script>
{% endblock %}
