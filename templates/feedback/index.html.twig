{% extends 'base.html.twig' %}

{% block title %}Demande d'aide {% endblock %}

{% block stylesheets %}
<link href="{{ asset('css/feedback.css') }}" rel="stylesheet" type="text/css"/>
{% endblock %}

{% block subheader %}
    <br>
{% endblock %}

{% block content %}
<div class="kt-sc-faq-3 kt-sc-feedback">
    <div class="kt-sc__title">
        Vous avez besoin d'aide?
    </div>
    <div class="kt-sc__subtitle">
        Soumettez votre demande d'aide à l'un de nos responsables!
    </div>
</div>
<!-- end:: Section -->

<!-- begin:: Section -->
<div class="kt-portlet kt-margin-top-30">
    <div class="kt-portlet__head">
        <div class="kt-portlet__head-label">
            <h3 class="kt-portlet__head-title">
				Envoyez-nous vos demandes
			</h3>
        </div>
    </div>
    <!--begin::Form-->
    {{ form_start( form, { 'method' : 'POST', 'attr' : { 'class' : 'kt-form' } } ) }}
        <div class="kt-portlet__body">
			<div class="row">
				<div class="col-xl-3"></div>
				<div class="col-xl-6">
                    <div class="form-group">
                        <label>Nom</label>
                        {{ form_widget( form.name, { 'attr' : {'placeholder' : 'Entrez votre nom', 'class' : 'form-control' } } ) }}
					</div>
					<div class="form-group">
                        <label>Téléphone</label>
                        {{ form_widget( form.phone, { 'attr' : {'placeholder' : 'Entrez votre téléphone', 'class' : 'form-control' } } ) }}
                    </div>
                    <div class="form-group">
                        <label>Adresse email</label>
                        {{ form_widget( form.email, { 'attr' : {'placeholder' : 'Entrez votre adresse email', 'class' : 'form-control' } } ) }}
					</div>
					<div class="form-group">
						<label for="exampleTextarea">Message</label>
                        {{ form_widget( form.message, { attr : {class : 'form-control', row: 3 } } ) }}
						<span class="form-text text-muted kt-hidden">We'll never share your email with anyone else.</span>
					</div>
				</div>
				<div class="col-xl-3"></div>
			</div>
		</div>
		
        <div class="kt-portlet__foot">
            <div class="kt-form__actions">
				<div class="row">
					<div class="col-xl-3"></div>
					<div class="col-xl-6">
						<button type="submit" class="btn btn-brand">Envoyer</button>&nbsp;
						<button type="reset" class="btn btn-secondary">Annuler</button>
					</div>
					<div class="col-xl-3"></div>
				</div>
            </div>
        </div>
        {{ form_row( form._token ) }}
    {{ form_end( form, {'render_rest': false}) }}
    <!--end::Form-->
</div>
<!-- end:: Section -->
{% endblock %}