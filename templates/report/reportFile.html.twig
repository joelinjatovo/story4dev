<div class="kt-widget4__item">
    <div class="kt-widget4__pic kt-widget4__pic--icon">
        <img src="{{ asset( reportFile.file.icone | imagine_filter('thumb') ) }}" alt="icone">  
    </div>
    {% if reportFile.file.image %}
        <a href="{{ asset( reportFile.file.icone) | imagine_filter('big') }}" data-toggle="lightbox" data-gallery="gallery" class="kt-widget4__title">
            {{ reportFile.file.name }}
        </a>
    {% else %}
        <a href="{{ path( 'file_download', {id:reportFile.file.id}) }}" target="_blank"  class="kt-widget4__title">
            {{ reportFile.file.name }}
        </a>
    {% endif %}
    <div class="kt-widget4__tools">
        <a href="{{ path( 'file_download', {id:reportFile.file.id}) }}" target="_blank" class="btn btn-clean btn-icon btn-sm">
            <i class="flaticon2-download"></i>
        </a>
    </div>				
</div>