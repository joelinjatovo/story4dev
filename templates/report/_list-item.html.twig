<tr data-row="0" class="kt-datatable__row report-item" style="left: 0px;">
    <td data-field="Rapports" class="kt-datatable__cell">
        <span style="width: 250px;">
            <div class="kt-user-card-v2">
                <div class="kt-user-card-v2__details">
                    <a class="kt-user-card-v2__name" href="{{ is_granted('view', report) ? path('report_show', { 'slug': report.activity.project.slug, 'activity_id': report.activity.id, 'report_id': report.id }) : '#' }}">{{ report.title }}</a>
                    <span class="kt-user-card-v2__email">{{ report.description|excerpt(50) }}</span>
                </div>
            </div>
        </span>
    </td>
    <td data-field="Auteurs" class="kt-datatable__cell">
        <span style="width: 222px;">
            <div class="kt-user-card-v2">
                <div class="kt-user-card-v2__pic">
                    <img alt="avatar" src="{{ report.author.avatar ? vich_uploader_asset(report.author, 'avatarFile') | imagine_filter('thumb') : default_avatar }}">
                </div>
                <div class="kt-user-card-v2__details">
                    <a class="kt-user-card-v2__name" href="{{ path('user_show', {'slug': report.author.slug}) }}">{{ report.author.fullname }}</a>
                    <span class="kt-user-card-v2__email">{{ report.author.email }}</span>
                    {% if report.author.verified %}
                        <i class="flaticon2-correct"></i>    
                    {% endif %}   
                </div>
            </div>
        </span>
    </td>
    <td data-field="Date" class="kt-datatable__cell">
        <span style="width: 100px;" class="kt-font-bold">{{ report.createdat | date('Y-m-d H:i:s') }}</span>
    </td>
    <td data-field="Statut" class="kt-datatable__cell">
        <span style="width: 100px;" class="kt-font-{{ report.statusClass }} kt-font-bold">{{ report.statusLabel }}</span>
    </td>
    <td data-field="Documents" class="kt-datatable__cell">
        <div style="width: 200px;">
            <div class="kt-media-group">
                {% for reportFile in report.reportFiles.slice(0, 5) %}
                    {% if reportFile.file %}
                        {% if reportFile.file.image %}
                            <a href="#" class="kt-media kt-media--sm kt-media--circle" data-toggle="kt-tooltip" data-skin="brand" data-placement="top" title="" data-original-title="Fichier attaché">
                                <img src="{{ asset( reportFile.file.icone ) | imagine_filter('thumb') }}" alt="image">
                            </a>
                        {% else %}
                            <a href="{{ path( 'file_download', {id:reportFile.file.id}) }}" target="_blank" class="kt-media kt-media--sm kt-media--circle" data-toggle="kt-tooltip" data-skin="brand" data-placement="top" title="" data-original-title="Cliquez pour le télécharger.">
                                <img src="{{ asset( reportFile.file.icone ) }}" alt="image">
                            </a>
                        {% endif %}
                    {% endif %}
                {% else %}
                    Aucun fichier
                {% endfor %}
            </div>       
        </div>
    </td>
    <td data-field="Actions" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="overflow: visible; position: relative; width: 150px;">
            {% if is_granted('edit', report) %}
                <a href="{{ path('report_edit', { 'slug': report.activity.project.slug, 'activity_id': report.activity.id, 'report_id': report.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                    <i class="la la-edit"></i>
                </a>
            {% endif %}
            {% if is_granted('view', report) %}
                <a href="{{ path('report_show', { 'slug': report.activity.project.slug, 'activity_id': report.activity.id, 'report_id': report.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                    <i class="la la-eye"></i>
                </a>
            {% endif %}
            {% if is_granted('remove', report) %}
                <a title="Supprimer ce rapport" data-id="{{ report.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-remove">
                    <i class="la la-trash"></i>
                </a>
            {% endif %}
        </span>
    </td>
</tr>