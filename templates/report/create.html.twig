{% extends 'base.html.twig' %}

{% block title %}Nouveau rapport - Projet #{{ project.id }} - {{ app.user.fullname }} {% endblock %}

{% block stylesheets %}{% endblock %}

{% block subheader %}
<div class="kt-subheader kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">Nouveau rapport</h3>
        </div>
        <div class="kt-subheader__toolbar">
            <div class="kt-subheader__wrapper">
                <a href="{{ path('project_show', { slug : project.slug } ) }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i>Retour</a>
                <div class="btn-group">
                    <button type="submit" form="report" name="submit" value="save-default" class="btn btn-brand">
                        <i class="la la-check"></i> 
                        <span class="kt-hidden-mobile">Enregistrer</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
   	<div class="col-lg-12">	
		<!--begin::Portlet-->
		<div class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
			<div class="kt-portlet__body">
                {{ form_start( form, { 'method' : 'POST', 'attr' : { 'id' : 'report', 'class' : 'kt-form kt-form--label-right' } } ) }}
					<div class="row">
						<div class="col-xl-2"></div>
						<div class="col-xl-8">
							<div class="kt-section kt-section--first">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Info:</h3>
									<div class="form-group row">
                    					{{ form_label( form.title, "Titre du rapport", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
                                            {{ form_widget( form.title, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
									<div class="form-group row">
                    					{{ form_label( form.description, "Description du rapport", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
                                            {{ form_widget( form.description, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
									{% if is_granted('edit', project) %}
										<div class="form-group row">
											{{ form_label( form.createdAt, "Date du rapport", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
											<div class="col-9 col-lg-9 col-xl-6">
												<div class="input-group date">
													{{ form_widget( form.createdAt, { 'attr' : { 'class' : 'form-control js-datepicker', 'autocomplete':'off' } } ) }}
													<div class="input-group-append">
														<span class="input-group-text">
															<i class="la la-calendar-check-o"></i>
														</span>
													</div>
												</div>
											</div>
										</div>
									{% else %}
										<input type="hidden" name="report[createdAt]" value="{{ report.createdAt|date('Y-m-d h:i:s') }}">
									{% endif %}
                                    
                                    <div class="form-group row">
                                        {{ form_label( form.status, "Statut", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                        <div class="col-lg-9 col-xl-6">
                                            <div class="input-group">
                                                {{ form_widget( form.status, { 'attr' : { 'class' : 'form-control' } } ) }}
                                            </div>
                                        </div>
                                    </div>
                                    
									{% if is_granted('edit', project) %}
                                        <div class="form-group row">
                                            <label class="col-3 col-form-label">Flux Externe</label>
                                            <div class="col-9">
                                                <div class="kt-checkbox-inline">
                                                    <label class="kt-checkbox">
                                                        {{ form_widget( form.publishExternally ) }} Publiez le rapport sur le blog 
                                                    <span></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
									{% else %}
										<input type="hidden" name="report[publishExternally]" value="{{ report.publishExternally }}">
									{% endif %}
								</div>
							</div>
							<div class="kt-separator kt-separator--border-dashed kt-separator--space-lg"></div>
							<div class="kt-section">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Suivi des résultats avec indicateur:</h3>
									<div class="form-group row">
										<label class="col-3 col-form-label">Résultat</label>
										<div class="col-9">
                                            <div id="kt_repeater">
                                                <div class="form-group row">
                                                    <div data-repeater-list="report[results]" class="col-lg-12">
                                                        
                                                        {% if form.results is empty %}
                                                            <div data-repeater-item="" class="kt-margin-b-10">
                                                                <div class="input-group">
                                                                    {{ form_widget(form.results.vars.prototype.indicator, { 'attr' : { 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    {{ form_widget(form.results.vars.prototype.value, { 'attr' : { placeholder: 'Saisissez la valeur ici', 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    <div class="input-group-append">
                                                                        <a href="javascript:;" data-repeater-delete class="btn btn-danger btn-icon">
                                                                            <i class="la la-close"></i>
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        
                                                        {% for result in form.results %}
                                                            <div data-repeater-item="" class="kt-margin-b-10">
                                                                <div class="input-group">
                                                                    {{ form_widget( result.id ) }}
                                                                    {{ form_widget( result.indicator, { 'attr' : { 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    {{ form_widget( result.value, { 'attr' : { placeholder: 'Saisissez la valeur ici', 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    <div class="input-group-append">
                                                                        <a href="javascript:;" data-repeater-delete class="btn btn-danger btn-icon">
                                                                            <i class="la la-close"></i>
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div> 
                                                        {% endfor %}                                                       
                                                    </div>                 
                                                </div>
                                                <div class="row">
                                                    <div class="col">
                                                        <div data-repeater-create="" class="btn btn btn-warning">
                                                            <span>
                                                                <i class="la la-plus"></i>
                                                                <span>Ajouter un résultat</span>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div> 
                                            </div>
										</div>
									</div>
								</div>
							</div>
                            <div class="kt-separator kt-separator--border-dashed kt-separator--space-lg"></div>
                            <div class="kt-section kt-section--last">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Attacher des fichiers:</h3>
                                    <button class="btn btn-label-success btn-bold btn-sm btn-upload">Téléverser un fichier</button>
									<div class="kt-widget4" id="file-list" data-name="report[reportFiles]" data-count="{{ report.reportFiles.count }}">
                                        {% set i = 0 %}
                                        {% for reportFile in report.reportFiles %}
											<div class="file-list-item">
												<input type="hidden" name="report[reportFiles][{{i}}][type]" value="{{reportFile.type}}">
												<input type="hidden" name="report[reportFiles][{{i}}][file]" value="{{reportFile.file.id}}">
												{% set i = i + 1 %}
												{{ include('upload/file.html.twig', {'file': reportFile.file}) }}
											</div>
                                        {% endfor %}
                                    </div>
								</div>
							</div>
						</div>
						<div class="col-xl-2"></div>
					</div>
                    {{ form_widget( form.latitude ) }}
                    {{ form_widget( form.longitude ) }}
                    {{ form_widget( form.altitude ) }}
                    {{ form_row( form._token ) }}
                {{ form_end( form, {'render_rest': false}) }}
			</div>
		</div>	
		<!--end::Portlet-->
	</div>
</div>
{% endblock %}

{% block javascripts %}
{% if report.id <= 0 %}
<script src="{{ asset('js/gmaps.js') }}" type="text/javascript" ></script>
<script type="text/javascript">
jQuery(document).ready(function($){
    GMaps.geolocate({
        success:function(e){
            jQuery('#report_latitude').val(e.coords.latitude);
            jQuery('#report_longitude').val(e.coords.longitude);
            jQuery('#report_altitude').val(e.coords.altitude);
        },
        error:function(t){toastr.error("Erreur de géolocalisation<br>"+t.message);},
        not_supported:function(){toastr.error("Votre navigateur ne supporte pas la géolocalisation.")},
        always:function(){}
    })
});
</script>
{% endif %}
<script type="text/javascript">
jQuery(document).ready(function($){
	jQuery('.js-datepicker').datetimepicker({format: 'yyyy-mm-dd hh:ii:ss'});
	$("#kt_repeater").repeater({initEmpty:!1,defaultValues:{"text-input":"foo"},show:function(){$(this).slideDown()},hide:function(e){confirm("Are you sure you want to delete this element?")&&$(this).slideUp(e)}});
    $(document).on('click', '.btn-delete-file', function(e){
        e.preventDefault();
        var $this = $(this);
		$this.closest('.file-list-item').remove();
    });
});
</script>
{% endblock %}
