{% extends 'report/base.html.twig' %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<br>
{% endblock %}

{% block content %}
<div class="row">
   	<div class="col-lg-12">	
		<!--begin::Portlet-->
		<div class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
			<div class="kt-portlet__head kt-portlet__head--lg">
				<div class="kt-portlet__head-label">
                    {% block headtitle %}
					   <h3 class="kt-portlet__head-title">Report your activities <small>report project activity here and save changes</small></h3>
                    {% endblock %}
				</div>
				<div class="kt-portlet__head-toolbar">
					<a href="javascript:history.back();" class="btn btn-clean kt-margin-r-10">
						<i class="la la-arrow-left"></i>
						<span class="kt-hidden-mobile">Back</span>
					</a>
					<div class="btn-group">
						<button type="submit" form="report" name="submit" value="save-default" class="btn btn-brand">
							<i class="la la-check"></i> 
							<span class="kt-hidden-mobile">Save</span>
						</button>
						<button type="button" class="btn btn-brand dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
						</button>
						<div class="dropdown-menu dropdown-menu-right">
							<ul class="kt-nav">
								<li class="kt-nav__item">
									<button type="submit" form="report" name="submit" value="save-continue" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-reload"></i>
										<span class="kt-nav__link-text">Save &amp; continue</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="report" name="submit" value="save-exit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-power"></i>
										<span class="kt-nav__link-text">Save &amp; exit</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="report" name="submit" value="save-edit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-edit-interface-symbol-of-pencil-tool"></i>
										<span class="kt-nav__link-text">Save &amp; edit</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="report" name="submit" value="save-create" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-add-1"></i>
										<span class="kt-nav__link-text">Save &amp; add new</span>
									</button>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="kt-portlet__body">
                {{ form_start( form, { 'method' : 'POST', 'attr' : { 'id' : 'report', 'class' : 'kt-form kt-form--label-right' } } ) }}
					<div class="row">
						<div class="col-xl-2"></div>
						<div class="col-xl-8">
							<div class="kt-section kt-section--first">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Report Info:</h3>
									<div class="form-group row">
                    					{{ form_label( form.title, null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
                                            {{ form_widget( form.title, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
									<div class="form-group row">
                    					{{ form_label( form.description, null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
                                            {{ form_widget( form.description, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
								</div>
							</div>
							<div class="kt-separator kt-separator--border-dashed kt-separator--space-lg"></div>
							<div class="kt-section">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Add result:</h3>
									<div class="form-group row">
										<label class="col-3 col-form-label">Result</label>
										<div class="col-9">
                                            <div id="kt_repeater">
                                                <div class="form-group row">
                                                    <div data-repeater-list="report[results]" class="col-lg-12">
                                                        
                                                        {% if form.results is empty %}
                                                            <div data-repeater-item="" class="kt-margin-b-10">
                                                                <div class="input-group">
                                                                    {{ form_widget(form.results.vars.prototype.indicator, { 'attr' : { 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    {{ form_widget(form.results.vars.prototype.value, { 'attr' : { 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    <div class="input-group-append">
                                                                        <a href="javascript:;" data-repeater-delete class="btn btn-danger btn-icon">
                                                                            <i class="la la-close"></i>
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        
                                                        {% for result in form.results %}
                                                            <div data-repeater-item="" class="kt-margin-b-10">
                                                                <div class="input-group">
                                                                    {{ form_widget( result.indicator, { 'attr' : { 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    {{ form_widget( result.value, { 'attr' : { 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    <div class="input-group-append">
                                                                        <a href="javascript:;" data-repeater-delete class="btn btn-danger btn-icon">
                                                                            <i class="la la-close"></i>
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div> 
                                                        {% endfor %}                                                       
                                                    </div>                 
                                                </div>
                                                <div class="row">
                                                    <div class="col-lg-3"></div>
                                                    <div class="col">
                                                        <div data-repeater-create="" class="btn btn btn-warning">
                                                            <span>
                                                                <i class="la la-plus"></i>
                                                                <span>Add</span>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div> 
                                            </div>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-xl-2"></div>
					</div>
                    {{ form_row( form._token ) }}
                {{ form_end( form, {'render_rest': false}) }}
			</div>
		</div>	
		<!--end::Portlet-->
	</div>
</div>
{% endblock %}


{% block javascripts %}
<script type="text/javascript">
    $(document).ready(function() {
        $("#kt_repeater").repeater({initEmpty:!1,defaultValues:{"text-input":"foo"},show:function(){$(this).slideDown()},hide:function(e){confirm("Are you sure you want to delete this element?")&&$(this).slideUp(e)}});
    });
</script>
{% endblock %}
