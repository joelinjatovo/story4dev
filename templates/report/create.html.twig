{% extends 'report/base.html.twig' %}

{% block title %}Nouveau rapport - Activité #{{ activity.id }} - Projet #{{ project.id }} - {{ app.user.fullname }} {% endblock %}

{% block stylesheets %}{% endblock %}

{% block subheader %}
<div class="kt-subheader kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{{ activity.title }}</h3>
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__breadcrumbs">
                <a href="{{ path('project_list', { page : 1 }) }}" class="kt-subheader__breadcrumbs-link">Projects</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ path('project_show', { id: activity.project.id })}}" class="kt-subheader__breadcrumbs-link">{{ activity.project.title }}</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ path('activity_show', { project_id: activity.project.id, activity_id: activity.id })}}" class="kt-subheader__breadcrumbs-link">{{ activity.title }}</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <span class="kt-subheader__breadcrumbs-link kt-subheader__breadcrumbs-link--active">Nouveau rapport</span>
            </div>
        </div>
        <div class="kt-subheader__toolbar">
            <div class="kt-subheader__wrapper">
                <div class="dropdown dropdown-inline" data-toggle="kt-tooltip" title="" data-placement="left" data-original-title="Actions: {{ activity.title }}">
                    <a href="#" class="btn btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                                <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                                <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                            </g>
                        </svg>
                        <!--<i class="flaticon2-plus"></i>-->
                    </a>
                    <div class="dropdown-menu dropdown-menu-fit dropdown-menu-md dropdown-menu-right">
                        <!--begin::Nav-->
                        <ul class="kt-nav">
                            <li class="kt-nav__head">
                                Nouveau
                                <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                            </li>
                            <li class="kt-nav__separator"></li>
                            {% if is_granted('create_indicator', activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('indicator_index', { 'activity_id' : activity.id, 'project_id' : activity.project.id } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-drop"></i>
                                        <span class="kt-nav__link-text">Indicateur</span>
                                    </a>
                                </li>
                            {% endif %}
                            <li class="kt-nav__item">
                                <a href="{{ path('report_index', { 'activity_id' : activity.id, 'project_id' : project.id } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                    <span class="kt-nav__link-text">Rapport</span>
                                </a>
                            </li>
                            <li class="kt-nav__separator"></li>
                            <li class="kt-nav__head">
                                Aller dans
                                <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                            </li>
                            <li class="kt-nav__separator"></li>
                            <li class="kt-nav__item">
                                <a href="{{ path('report_list', { 'activity_id' : activity.id, 'project_id' : project.id } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                    <span class="kt-nav__link-text">Les rapports</span>
                                </a>
                            </li>
                            <li class="kt-nav__item">
                                <a href="{{ path('file_list_activity', { 'activity_id' : activity.id, 'project_id' : project.id } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                    <span class="kt-nav__link-text">Les documents</span>
                                </a>
                            </li>
                            <li class="kt-nav__item">
                                <a href="{{ path('report_index', { 'activity_id' : activity.id, 'project_id' : project.id } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                    <span class="kt-nav__link-text">Les indicateurs</span>
                                </a>
                            </li>
                        </ul>
                        <!--end::Nav-->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
   	<div class="col-lg-12">	
		<!--begin::Portlet-->
		<div class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
			<div class="kt-portlet__head kt-portlet__head--lg">
				<div class="kt-portlet__head-label">
                    {% block headtitle %}
					   <h3 class="kt-portlet__head-title">Rapporter une activité <small>entrer les détails du rapport puis enregistrer</small></h3>
                    {% endblock %}
				</div>
				<div class="kt-portlet__head-toolbar">
                    {% if report is defined and report is not null and (report.id>0) %}
					   <a href="{{ url('report_show', { 'project_id' : report.activity.project.id, 'activity_id' : report.activity.id, 'report_id' : report.id }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">Retour</span></a>
                    {% else %}
					   <a href="{{ url('activity_show', { 'project_id' : activity.project.id, 'activity_id' : activity.id }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">Retour</span></a>
                    {% endif %}
					<div class="btn-group">
						<button type="submit" form="report" name="submit" value="save-default" class="btn btn-brand">
							<i class="la la-check"></i> 
							<span class="kt-hidden-mobile">Enregistrer</span>
						</button>
						<button type="button" class="btn btn-brand dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
						</button>
						<div class="dropdown-menu dropdown-menu-right">
							<ul class="kt-nav">
								<li class="kt-nav__item">
									<button type="submit" form="report" name="submit" value="save-continue" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-reload"></i>
										<span class="kt-nav__link-text">Enregistrer &amp; Continuer</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="report" name="submit" value="save-edit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-edit"></i>
										<span class="kt-nav__link-text">Enregistrer &amp; Modifier</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="report" name="submit" value="save-create" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-add-1"></i>
										<span class="kt-nav__link-text">Enregistrer &amp; Ajouter</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="report" name="submit" value="save-exit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon-close"></i>
										<span class="kt-nav__link-text">Enregistrer &amp; Quitter</span>
									</button>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="kt-portlet__body">
                {{ form_start( form, { 'method' : 'POST', 'attr' : { 'id' : 'report', 'class' : 'kt-form kt-form--label-right' } } ) }}
					<div class="row">
						<div class="col-xl-2"></div>
						<div class="col-xl-8">
							<div class="kt-section kt-section--first">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Info:</h3>
									<div class="form-group row">
                    					{{ form_label( form.title, "Titre du rapport", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
                                            {{ form_widget( form.title, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
									<div class="form-group row">
                    					{{ form_label( form.description, "Description du rapport", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
                                            {{ form_widget( form.description, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
									{% if is_granted('edit', project) %}
										<div class="form-group row">
											{{ form_label( form.createdAt, "Date du rapport", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
											<div class="col-9 col-lg-9 col-xl-6">
												<div class="input-group date">
													{{ form_widget( form.createdAt, { 'attr' : { 'class' : 'form-control js-datepicker', 'autocomplete':'off' } } ) }}
													<div class="input-group-append">
														<span class="input-group-text">
															<i class="la la-calendar-check-o"></i>
														</span>
													</div>
												</div>
											</div>
										</div>
									{% else %}
										<input type="hidden" name="report[createdAt]" value="{{ report.createdAt|date('Y-m-d h:i:s') }}">
									{% endif %}
                                    
                                    <div class="form-group row">
                                        {{ form_label( form.status, "Statut", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                        <div class="col-lg-9 col-xl-6">
                                            <div class="input-group">
                                                {{ form_widget( form.status, { 'attr' : { 'class' : 'form-control' } } ) }}
                                            </div>
                                        </div>
                                    </div>
                                    
									{% if is_granted('edit', project) %}
                                        <div class="form-group row">
                                            <label class="col-3 col-form-label">Flux Externe</label>
                                            <div class="col-9">
                                                <div class="kt-checkbox-inline">
                                                    <label class="kt-checkbox">
                                                        {{ form_widget( form.publishExternally ) }} Publiez le rapport sur le blog 
                                                    <span></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
									{% else %}
										<input type="hidden" name="report[publishExternally]" value="{{ report.publishExternally }}">
									{% endif %}
								</div>
							</div>
							<div class="kt-separator kt-separator--border-dashed kt-separator--space-lg"></div>
							<div class="kt-section">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Suivi des résultats avec indicateur:</h3>
									<div class="form-group row">
										<label class="col-3 col-form-label">Résultat</label>
										<div class="col-9">
                                            <div id="kt_repeater">
                                                <div class="form-group row">
                                                    <div data-repeater-list="report[results]" class="col-lg-12">
                                                        
                                                        {% if form.results is empty %}
                                                            <div data-repeater-item="" class="kt-margin-b-10">
                                                                <div class="input-group">
                                                                    {{ form_widget(form.results.vars.prototype.indicator, { 'attr' : { 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    {{ form_widget(form.results.vars.prototype.value, { 'attr' : { placeholder: 'Saisissez la valeur ici', 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    <div class="input-group-append">
                                                                        <a href="javascript:;" data-repeater-delete class="btn btn-danger btn-icon">
                                                                            <i class="la la-close"></i>
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        
                                                        {% for result in form.results %}
                                                            <div data-repeater-item="" class="kt-margin-b-10">
                                                                <div class="input-group">
                                                                    {{ form_widget( result.id ) }}
                                                                    {{ form_widget( result.indicator, { 'attr' : { 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    {{ form_widget( result.value, { 'attr' : { placeholder: 'Saisissez la valeur ici', 'form' : 'report', 'class' : 'form-control' } } ) }}
                                                                    <div class="input-group-append">
                                                                        <a href="javascript:;" data-repeater-delete class="btn btn-danger btn-icon">
                                                                            <i class="la la-close"></i>
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div> 
                                                        {% endfor %}                                                       
                                                    </div>                 
                                                </div>
                                                <div class="row">
                                                    <div class="col">
                                                        <div data-repeater-create="" class="btn btn btn-warning">
                                                            <span>
                                                                <i class="la la-plus"></i>
                                                                <span>Ajouter un résultat</span>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div> 
                                            </div>
										</div>
									</div>
								</div>
							</div>
                            <div class="kt-separator kt-separator--border-dashed kt-separator--space-lg"></div>
                            <div class="kt-section kt-section--last">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Attacher des fichiers:</h3>
                                    <button class="btn btn-label-success btn-bold btn-sm btn-upload">Téléverser un fichier</button>
									<div class="kt-widget4" id="file-list" data-name="report[reportFiles]" data-count="{{ report.reportFiles.count }}">
                                        {% set i = 0 %}
                                        {% for reportFile in report.reportFiles %}
											<div class="file-list-item">
												<input type="hidden" name="report[reportFiles][{{i}}][type]" value="{{reportFile.type}}">
												<input type="hidden" name="report[reportFiles][{{i}}][file]" value="{{reportFile.file.id}}">
												{% set i = i + 1 %}
												{{ include('upload/file.html.twig', {'file': reportFile.file}) }}
											</div>
                                        {% endfor %}
                                    </div>
								</div>
							</div>
						</div>
						<div class="col-xl-2"></div>
					</div>
                    {{ form_widget( form.latitude ) }}
                    {{ form_widget( form.longitude ) }}
                    {{ form_widget( form.altitude ) }}
                    {{ form_row( form._token ) }}
                {{ form_end( form, {'render_rest': false}) }}
			</div>
		</div>	
		<!--end::Portlet-->
	</div>
</div>
{% endblock %}


{% block javascripts %}
{% if report.id <= 0 %}
<script src="{{ asset('js/gmaps.js') }}" type="text/javascript" ></script>
<script type="text/javascript">
jQuery(document).ready(function($){
    GMaps.geolocate({
        success:function(e){
            jQuery('#report_latitude').val(e.coords.latitude);
            jQuery('#report_longitude').val(e.coords.longitude);
            jQuery('#report_altitude').val(e.coords.altitude);
        },
        error:function(t){toastr.error("Erreur de géolocalisation<br>"+t.message);},
        not_supported:function(){toastr.error("Votre navigateur ne supporte pas la géolocalisation.")},
        always:function(){}
    })
});
</script>
{% endif %}
<script type="text/javascript">
jQuery(document).ready(function($){
	jQuery('.js-datepicker').datepicker({format: 'yyyy-mm-dd'});
	$("#kt_repeater").repeater({initEmpty:!1,defaultValues:{"text-input":"foo"},show:function(){$(this).slideDown()},hide:function(e){confirm("Are you sure you want to delete this element?")&&$(this).slideUp(e)}});
    $(document).on('click', '.btn-delete-file', function(e){
        e.preventDefault();
        var $this = $(this);
		$this.closest('.file-list-item').remove();
    });
});
</script>
{% endblock %}
