{% extends 'base.html.twig' %}

{% block title %}Rapports - Projet #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">Tous les rapports</h3>
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__group" id="kt_subheader_search">
                <span class="kt-subheader__desc" id="kt_subheader_total">{{ reports.count }} Rapports </span>
            </div>
            <a href="{{ path('report_activities', { slug: project.slug } ) }}" class="btn btn-label-brand btn-bold"><i class="la la-plus"></i> {% trans %}button.add{% endtrans %}</a>
        </div>
        <div class="kt-subheader__toolbar">
            <a href="{{ path('report_list_type', { slug: project.slug, type: 'list', s: search, status: status }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-list"></i> Liste </a>
            <a href="{{ path('report_list_type', { slug: project.slug, type: 'grid', s: search, status: status }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-large"></i> Grille</a>
            <a href="{{ path('project_show', { slug : project.slug } ) }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i>Retour</a>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<!--begin::Notice-->
<div class="alert alert-custom alert-white alert-shadow gutter-b" role="alert">
	<div class="alert-text">
        <form class="form" id="filter">
            <div class="row">
                <div class="col-lg-3 col-md-3 col-sm-6">
                    {{ include('_common/_search.html.twig') }}
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <select class="form-control select2" id="kt_select2_activity" name="activity_id">
                        <option>Toutes</option>
                        {% for _activity in activities %}
                            <option value="{{ _activity.id }}" {{ activity != null and activity.id == _activity.id ? 'selected="selected"' : '' }}>{{ _activity.title }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <select class="form-control select2" id="kt_select2_status" name="status">
                        <option>Tous</option>
                        <option value="opened">Editable</option>
                        <option value="closed">Clôturé</option>
                        <option value="terminated">Términé</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <button type="submit" class="btn btn-label-primary font-weight-bold"><i class="la la-filter"></i> Filtrer</button>
                </div>
            </div>
        </form>
    </div>
</div>
<!--end::Notice-->

<div class="row">
	<div class="col-xl-12 col-lg-12">
		<div class="kt-portlet kt-portlet--height-fluid kt-portlet--mobile ">
            <div class="kt-portlet__body kt-portlet__body--fit">
                <div class="kt-datatable kt-datatable--default kt-datatable--brand kt-datatable--loaded" >
                    <table class="kt-datatable__table" style="display: block;">
                        <thead class="kt-datatable__head">
                            <tr class="kt-datatable__row" style="left: 0px;">
                                <th data-field="{% trans %}reports{% endtrans %}" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 250px;">{% trans %}reports{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}authors{% endtrans %}" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 222px;">{% trans %}authors{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}date{% endtrans %}" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 100px;">{% trans %}date{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}status{% endtrans %}" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 100px;">{% trans %}status{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}documents{% endtrans %}" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 200px;">{% trans %}documents{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}actions{% endtrans %}" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 150px;">{% trans %}actions{% endtrans %}</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="kt-datatable__body">
                            {% for report in reports %}
                                {{ include('report/_list-item.html.twig', {'report': report}) }}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
    
<div class="row">
    <div class="col-xl-12">       
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <!--begin: Pagination-->
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': reports}) }}
                </div>
                <!--end: Pagination-->
            </div>
        </div>
    </div>           
</div>
{% endblock %}

{% block javascripts %}
<script type="text/javascript">
jQuery(document).ready(function($){
    $('#kt_select2_activity').select2({
        placeholder: "{% trans %}select.activity{% endtrans %}",
    });
    $('#kt_select2_status').select2({
        placeholder: "{% trans %}select.status{% endtrans %}",
    });
    $(document).on('click', '.btn-remove', function(e){
        e.preventDefault();
        var $this = $(this);
            swal.fire({
                title:"{% trans %}swal.remove.title{% endtrans %}",
                text:"{% trans %}swal.remove.content.report{% endtrans %}",
                type:"warning",
                showCancelButton:!0,
                confirmButtonText:"{% trans %}button.confirm.delete1{% endtrans %}",
                cancelButtonText:"{% trans %}button.cancel{% endtrans %}"
            }).then(function(e){
                if(e.value){
                    KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
                    $.post("/report/remove", { id: $this.attr('data-id') })
                    .done(function( data ) {
                        KTApp.unblockPage();
                        if(data.success){
                            $this.closest('.report-item').remove();
                            toastr.success(data.message);
                        }else{
                            toastr.error(data.message, data.title);
                        }
                    })
                    .fail(function() {
                        KTApp.unblockPage();
                        toastr.error("{% trans %}swal.error{% endtrans %}");
                    });
                }
            })
    });
});
</script>
{% endblock %}