{% extends 'base.html.twig' %}

{% block title %}Rapports {% if activity is not null %}- Activité #{{ activity.id }}{% endif %}- Projet #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{{ project.title }} {% if activity is null %}{% else %} / {{ activity.title }}{% endif %}</h3>
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__group" id="kt_subheader_search">
                <span class="kt-subheader__desc" id="kt_subheader_total">{{ reports.count }} Total </span>
            </div>
            <div class="kt-subheader__breadcrumbs">
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ path('project_list', { 'page' : 1 }) }}" class="kt-subheader__breadcrumbs-link">Projets</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ path('project_show', { 'id': project.id })}}" class="kt-subheader__breadcrumbs-link">{{ project.title }}</a>
                {% if activity is not null %}
                    <span class="kt-subheader__breadcrumbs-separator"></span>
                    <a href="{{ path('activity_show', { 'project_id': activity.project.id, 'activity_id': activity.id } ) }}" class="kt-subheader__breadcrumbs-link">{{ activity.title }}</a>
                {% endif %} 
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <span class="kt-subheader__breadcrumbs-link kt-subheader__breadcrumbs-link--active">Rapports</span>
            </div>
        </div>        
        <div class="kt-subheader__toolbar">
            {% if activity is defined and activity is not null %}
                <a href="{{ path('report_list2_type', { activity_id: activity.id, project_id: activity.project.id, type: 'list' }) }}" class="btn btn-secondary btn-lg btn-icon btn-circle"><i class="la la-th-list"></i></a>
                <a href="{{ path('report_list2_type', { activity_id: activity.id, project_id: activity.project.id, type: 'grid' }) }}" class="btn btn-secondary btn-lg btn-icon btn-circle"><i class="la la-th-large"></i></a>
            {% else %}
                <a href="{{ path('report_list_type', { project_id: project.id, type: 'list' }) }}" class="btn btn-secondary btn-lg btn-icon btn-circle"><i class="la la-th-list"></i></a>
                <a href="{{ path('report_list_type', { project_id: project.id, type: 'grid' }) }}" class="btn btn-secondary btn-lg btn-icon btn-circle"><i class="la la-th-large"></i></a>
            {% endif %}
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            {% if activity is defined and activity is not null %}
                <a href="{{ url('activity_show', { 'project_id' : activity.project.id, 'activity_id' : activity.id }) }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i>Retour</a>
            {% else %}
                <a href="{{ path('project_show', { 'id' : project.id } ) }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i>Retour</a>
            {% endif %}
            {% if activity is defined and activity is not null %}
                <div class="dropdown dropdown-inline" data-toggle="kt-tooltip" title="" data-placement="left" data-original-title="Quick actions: {{ activity.title }}">
                    <a href="#" class="btn btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                                <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                                <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                            </g>
                        </svg>
                        <!--<i class="flaticon2-plus"></i>-->
                    </a>
                    <div class="dropdown-menu dropdown-menu-fit dropdown-menu-md dropdown-menu-right">
                        <!--begin::Nav-->
                        <ul class="kt-nav">
                            <li class="kt-nav__head">
                                {{ activity.title }}
                                <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                            </li>
                            <li class="kt-nav__separator"></li>
                            {% if is_granted('edit', activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('indicator_index', { 'activity_id' : activity.id, 'project_id' : activity.project.id, 'slug': activity.project.author.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-drop"></i>
                                        <span class="kt-nav__link-text">Indicateur</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('view', activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_index', { 'activity_id' : activity.id, 'project_id' : project.id } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Rapport</span>
                                    </a>
                                </li>
                                <li class="kt-nav__separator"></li>
                                <li class="kt-nav__head">
                                    Aller dans
                                    <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                                </li>
                                <li class="kt-nav__separator"></li>
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_list2', { 'activity_id' : activity.id, 'project_id' : project.id } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Les rapports</span>
                                    </a>
                                </li>
                                <li class="kt-nav__item">
                                    <a href="{{ path('file_list_activity', { 'activity_id' : activity.id, 'project_id' : project.id } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Les documents</span>
                                    </a>
                                </li>
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_index', { 'activity_id' : activity.id, 'project_id' : project.id } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Les indicateurs</span>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                        <!--end::Nav-->
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
	<div class="col-xl-8 col-lg-12 order-lg-1 order-xl-1">
		<div class="kt-portlet kt-portlet--height-fluid kt-portlet--mobile ">
            <div class="kt-portlet__body kt-portlet__body--fit">
                <div class="kt-datatable kt-datatable--default kt-datatable--brand kt-datatable--loaded" >
                    <table class="kt-datatable__table" style="display: block;">
                        <thead class="kt-datatable__head">
                            <tr class="kt-datatable__row" style="left: 0px;">
                                <th data-field="Rapports" data-autohide-disabled="false" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 250px;">Rapports</span>
                                </th>
                                <th data-field="Auteurs" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 222px;">Auteurs</span>
                                </th>
                                <th data-field="Date" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 100px;">Date</span>
                                </th>
                                <th data-field="Résultats" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 100px;">Résultats</span>
                                </th>
                                <th data-field="Documents" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 200px;">Documents</span>
                                </th>
                                <th data-field="Actions" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 150px;">Actions</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="kt-datatable__body">
                            {% for report in reports %}
                                {{ include('report/list_item.html.twig', {'report': report}) }}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
    
<div class="row">
    <div class="col-xl-12">       
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <!--begin: Pagination-->
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': reports}) }}
                </div>
                <!--end: Pagination-->
            </div>
        </div>
    </div>           
</div>
{% endblock %}

{% block javascripts %}
<script type="text/javascript">
jQuery(document).ready(function($){
    $(document).on('click', '.btn-remove', function(e){
        e.preventDefault();
        var $this = $(this);
            swal.fire({
                title:"Vous êtes sûre?",
                text:"Vous ne pourez pas revenir en arrière après!\nToutes les rapports ainsi que les données rattachées à cette activité vont être supprimés aussi.",
                type:"warning",
                showCancelButton:!0,
                confirmButtonText:"Oui, supprimez la!",
                cancelButtonText:"Annuler"
            }).then(function(e){
                if(e.value){
                    KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
                    $.post("/report/remove", { id: $this.attr('data-id') })
                    .done(function( data ) {
                        KTApp.unblockPage();
                        if(data.success){
                            $this.closest('.report-item').remove();
                            toastr.success(data.message);
                        }else{
                            toastr.error(data.message, data.title);
                        }
                    })
                    .fail(function() {
                        KTApp.unblockPage();
                        toastr.error("Une erreur s'est produite. Veuillez réesayer plus tard!");
                    });
                }
            })
    });
});
</script>
{% endblock %}