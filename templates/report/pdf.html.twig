{% extends 'basepdf.html.twig' %}

{% block title %}Rapport #{{ report.id }} - Projet #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
    <link href="{{ absolute_url(asset('css/invoice-2.css')) }}" rel="stylesheet" type="text/css"/>
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">Détail du rapport</h3>
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__breadcrumbs">
                <a href="{{ path('project_list', { 'page' : 1 }) }}" class="kt-subheader__breadcrumbs-link kt-hidden">Projets</a>
                <span class="kt-subheader__breadcrumbs-separator kt-hidden"></span>
                <a href="{{ path('project_show', { slug: report.activity.project.slug })}}" class="kt-subheader__breadcrumbs-link kt-hidden">{{ report.activity.project.title }}</a>
                <span class="kt-subheader__breadcrumbs-separator kt-hidden"></span>
                <a href="{{ path('activity_show', { 'slug': report.activity.project.slug, 'activity_id': report.activity.id })}}" class="kt-subheader__breadcrumbs-link">{{ report.activity.title }}</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <span class="kt-subheader__breadcrumbs-link kt-subheader__breadcrumbs-link--active">{{ report.title }}</span>
            </div>
        </div>        
        <div class="kt-subheader__toolbar">
            <a href="{{ url('activity_show', { 'slug' : activity.project.slug, 'activity_id' : activity.id }) }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i>Retour</a>
            {% if is_granted('edit', report) %}
                <a href="{{ path('report_edit', { 'slug': report.activity.project.slug, 'activity_id': report.activity.id, 'report_id': report.id}) }}" class="btn btn-label-brand btn-bold">Modifier</a>
            {% endif %}
            <div class="kt-subheader__wrapper">
                <div class="dropdown dropdown-inline" data-toggle="kt-tooltip" title="Actions" data-placement="left">
                    <a href="#" class="btn btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                                <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                                <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                            </g>
                        </svg>
                    </a>
                    <div class="dropdown-menu dropdown-menu-fit dropdown-menu-md dropdown-menu-right">
                        <ul class="kt-nav">
                            <li class="kt-nav__head">
                                Nouveau:                                    
                                <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                            </li>
                            <li class="kt-nav__separator"></li>
                            {% if is_granted('edit', report.activity.project) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('activity_index', { 'slug' : report.activity.project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-map"></i>
                                        <span class="kt-nav__link-text">Activité</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('create_indicator', report.activity) %}                     
                                <li class="kt-nav__item">
                                    <a href="{{ path('indicator_index', { 'activity_id' : report.activity.id, 'slug' : report.activity.project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-drop"></i>
                                        <span class="kt-nav__link-text">Indicateur</span>
                                    </a>
                                </li> 
                            {% endif %}
                            {% if is_granted('create_report', report.activity) %} 
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_index', { 'activity_id' : report.activity.id, 'slug' : report.activity.project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Rapport</span>
                                    </a>
                                </li>
                            {% endif %}
                            <li class="kt-nav__separator"></li>
                            <li class="kt-nav__head">
                                Aller dans
                                <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                            </li>
                            <li class="kt-nav__separator"></li>
                            {% if is_granted('view', report.activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_list2', { 'activity_id' : report.activity.id, 'slug' : report.activity.project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Les rapports</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('view', report.activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('file_list_activity', { 'activity_id' : report.activity.id, 'slug' : report.activity.project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Les documents</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('view', report.activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('indicator_list', { 'activity_id' : report.activity.id, 'slug' : report.activity.project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Les indicateurs</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('view', report.activity.project) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('graph_list', { 'slug' : report.activity.project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-chart"></i>
                                        <span class="kt-nav__link-text">Les graphes</span>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="kt-portlet">
	<div class="kt-portlet__body kt-portlet__body--fit">
		<div class="kt-invoice-2">
			<div class="kt-invoice__head">
                <div class="kt-invoice__container">
                    <div class="kt-invoice__brand">
						<h1 class="kt-invoice__title">{{ report.title }}</h1>
					</div>
					
                    <div class="kt-invoice__items">
                        <div class="kt-invoice__item">
                            <span class="kt-invoice__subtitle" style="width: 100%;">Date de création</span>
                            <span class="kt-invoice__text" style="width: 100%;">{{ report.createdat is empty ? "" : report.createdat | date('Y-m-d H:i:s') }}</span>
                        </div>
                        <div class="kt-invoice__item">
                            <span class="kt-invoice__subtitle" style="width: 100%;">Date de synchronisation</span>
                            <span class="kt-invoice__text" style="width: 100%;">{{ report.syncedat is empty ? "" : report.syncedat | date('Y-m-d H:i:s') }}</span>
                        </div>
                        <div class="kt-invoice__item">
                            <span class="kt-invoice__subtitle" style="width: 100%;">Localisation</span>
                            <span class="kt-invoice__text" style="width: 100%;">{{ report.latitude }},{{ report.longitude }}</span>
                        </div>
                    </div>
                </div>
			</div>	
            
			<div class="kt-invoice__body">
                <div class="kt-invoice__container">
                    <h3>Description</h3>
                    <div style="color: #000;" style="border-top: 1px solid #ebedf2;">{{ report.description|html|raw }}</div>
                </div>
			</div>
            
            {% if report.results %}
                <div class="kt-invoice__body">
                    <div class="kt-invoice__container">
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Indicateurs</th>
                                        <th>Résultats</th>
                                        <th>Totaux</th>
                                        <th>Objectifs</th>
                                        <th>Avancements</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for result in report.results %}
                                        <tr>
                                            <td>{{ result.indicator.title }}</td>
                                            <td style="font-weight: 500;">{{ result.value }} {{ result.indicator.unit.label }}</td>
                                            <td style="font-weight: 500;">{{ result.indicator|result }} {{ result.indicator.unit.label }}</td>
                                            <td style="font-weight: 500;">{{ result.indicator|goal }} {{ result.indicator.unit.label }}</td>
                                            <td class="kt-font-{{ result.indicator|progressionClass }} kt-font-lg">{{ result.indicator|progression }}%</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}
            
            {% if report.reportFiles %}
                <div class="kt-invoice__body">
                    <div class="kt-invoice__container">
                        <h3>Documents</h3>
                        <ul>
                            {% for reportFile in report.reportFiles %}
                                {% if not reportFile.file.image %}
                                    <li><a href="{{ absolute_url(path( 'file_download', {id:reportFile.file.id})) }}" target="_blank" >{{ reportFile.file.displayname }}</a></li>
                                {% endif %}
                            {% else %}
                                Aucun fichier attaché à ce rapport.
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}

            {% if report.reportFiles %}
                <div class="kt-invoice__body">
                    <div class="kt-invoice__container">
                        <h3>Photos</h3>
                        <div id="gallery">
                            {% for reportFile in report.reportFiles %}
                                {% if reportFile.file.image %}
                                    <img alt="{{ report.title }}" src="{{ asset( reportFile.file.icone | imagine_filter('small') ) }}"
                                    data-image="{{ asset( reportFile.file.icone | imagine_filter('big') ) }}"
                                    data-description="{{ report.title }}">
                                {% endif %}
                            {% else %}
                                Aucun fichier attaché à ce rapport.
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}

		</div>
	</div>
</div>
{% endblock %}


{% block javascripts %}
{% endblock %}
