{% extends 'basepdf.html.twig' %}

{% block title %}{% trans %}report{% endtrans %} #{{ report.id }} - {% trans %}project{% endtrans %} #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
    <link href="{{ absolute_url(asset('css/invoice-2.css')) }}" rel="stylesheet" type="text/css"/>
{% endblock %}

{% block subheader %}
{% endblock %}

{% block content %}
<div class="kt-portlet">
	<div class="kt-portlet__body kt-portlet__body--fit">
		<div class="kt-invoice-2">
			<div class="kt-invoice__head">
                <div class="kt-invoice__container">
                    <div class="kt-invoice__brand">
						<h1 class="kt-invoice__title">{{ report.title }}</h1>
					</div>
					
                    <div class="kt-invoice__items">
                        <div class="kt-invoice__item">
                            <span class="kt-invoice__subtitle" style="width: 100%;">{% trans %}date.created{% endtrans %}</span>
                            <span class="kt-invoice__text" style="width: 100%;">{{ report.createdat is empty ? "" : report.createdat | date('Y-m-d H:i:s') }}</span>
                        </div>
                        <div class="kt-invoice__item">
                            <span class="kt-invoice__subtitle" style="width: 100%;">{% trans %}date.synced{% endtrans %}</span>
                            <span class="kt-invoice__text" style="width: 100%;">{{ report.syncedat is empty ? "" : report.syncedat | date('Y-m-d H:i:s') }}</span>
                        </div>
                        <div class="kt-invoice__item">
                            <span class="kt-invoice__subtitle" style="width: 100%;">{% trans %}location{% endtrans %}</span>
                            <span class="kt-invoice__text" style="width: 100%;">{{ report.latitude }},{{ report.longitude }}</span>
                        </div>
                    </div>
                </div>
			</div>	
            
			<div class="kt-invoice__body">
                <div class="kt-invoice__container">
                    <h3>{% trans %}description{% endtrans %}</h3>
                    <div style="color: #000;" style="border-top: 1px solid #ebedf2;">{{ report.description|html|raw }}</div>
                </div>
			</div>
            
            {% if report.results %}
                <div class="kt-invoice__body">
                    <div class="kt-invoice__container">
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>{% trans %}indicators{% endtrans %}</th>
                                        <th>{% trans %}results{% endtrans %}</th>
                                        <th>{% trans %}totals{% endtrans %}</th>
                                        <th>{% trans %}goals{% endtrans %}</th>
                                        <th>{% trans %}progresssions{% endtrans %}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for result in report.results %}
                                        <tr>
                                            <td>{{ result.indicator.title }}</td>
                                            <td style="font-weight: 500;">{{ result.value }} {{ result.indicator.unit.label }}</td>
                                            <td style="font-weight: 500;">{{ result.indicator|result }} {{ result.indicator.unit.label }}</td>
                                            <td style="font-weight: 500;">{{ result.indicator|goal }} {{ result.indicator.unit.label }}</td>
                                            <td class="kt-font-{{ result.indicator|progressionClass }} kt-font-lg">{{ result.indicator|progression }}%</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}
            
            {% if report.reportFiles %}
                <div class="kt-invoice__body">
                    <div class="kt-invoice__container">
                        <h3>{% trans %}documents{% endtrans %}</h3>
                        <ul>
                            {% for reportFile in report.reportFiles %}
                                {% if not reportFile.file.image %}
                                    <li><a href="{{ absolute_url(path( 'file_download', {id:reportFile.file.id})) }}" target="_blank" >{{ reportFile.file.displayname }}</a></li>
                                {% endif %}
                            {% else %}
                                {% trans %}no.file.report{% endtrans %}
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}

            {% if report.reportFiles %}
                <div class="kt-invoice__body">
                    <div class="kt-invoice__container">
                        <h3>{% trans %}photos{% endtrans %}</h3>
                        <div id="gallery">
                            {% for reportFile in report.reportFiles %}
                                {% if reportFile.file.image %}
                                    <img alt="{{ report.title }}" src="{{ asset( reportFile.file.icone | imagine_filter('small') ) }}"
                                    data-image="{{ asset( reportFile.file.icone | imagine_filter('big') ) }}"
                                    data-description="{{ report.title }}">
                                {% endif %}
                            {% else %}
                                {% trans %}no.file.report{% endtrans %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}

		</div>
	</div>
</div>
{% endblock %}


{% block javascripts %}
{% endblock %}
