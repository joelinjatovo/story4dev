<div class="kt-widget31__item">
    <div class="kt-widget31__content">
        <div class="kt-widget31__info">
            <a href="{{ url('indicator_show', { 'slug' : result.indicator.activity.project.slug, 'activity_id' : result.indicator.activity.id, 'indicator_id' : result.indicator.id }) }}" class="kt-widget31__username">
                {{ result.indicator.title }}
            </a>
            <p class="kt-widget31__text">
                Unité : {{ result.value }} {{ result.indicator.unit.title }}
            </p>							 		 
        </div>					 
    </div>

    <div class="kt-widget31__content">
        <div class="kt-widget31__progress">
            <a href="{{ url('indicator_show', { 'slug' : result.indicator.activity.project.slug, 'activity_id' : result.indicator.activity.id, 'indicator_id' : result.indicator.id }) }}" class="kt-widget31__stats">
                <span>{{ result.indicator.progression }}%</span>
                <span>{{ result.indicator.value }} / {{ result.indicator.goalValue }}</span>						    							 
            </a>
            <div class="progress progress-sm">
                <div class="progress-bar bg-brand" role="progressbar" style="width: {{ result.indicator.progression }}%" aria-valuenow="{{ result.indicator.progression }}" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            Progression générale de l’indicateur
        </div>	
    </div>						
</div>