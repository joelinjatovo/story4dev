<!--begin:: Portlet-->
<div class="kt-portlet kt-portlet--height-fluid report-item">
    <div class="kt-portlet__body kt-portlet__body--fit">
        <!--begin::Widget -->
        <div class="kt-widget kt-widget--project-1">
            <div class="kt-widget__head">
                <div class="kt-widget__label">
                    <div class="kt-widget__media">
                        <span class="kt-media kt-media--lg kt-media--circle"> 
                            <img src="{{ report.author.avatar ? vich_uploader_asset(report.author, 'avatarFile') | imagine_filter('thumb') : default_avatar }}" alt="image">
                        </span>
                    </div>
                    <div class="kt-widget__info kt-margin-t-5">
                        {% if is_granted('view', report) %}
                            <a href="{{ path('report_show', { slug: report.activity.project.slug, 'activity_id': report.activity.id, 'report_id': report.id}) }}" class="kt-widget__title">
                                {{ report.title }}                                                
                            </a>
                        {% else %}
                            <a href="#" class="kt-widget__title">
                                {{ report.title }}                                                
                            </a>
                        {% endif %}
                        <span class="kt-widget__desc">
                            {{ report.author.fullname }}
                        </span>
                    </div>
                </div>
                <div class="kt-portlet__head-toolbar">
                    <a href="#" class="btn btn-clean btn-sm btn-icon btn-icon-md" data-toggle="dropdown">
                        <i class="flaticon-more-1"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-fit dropdown-menu-right">
                        <ul class="kt-nav">
                            {% if is_granted('view', report) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_show', { slug: report.activity.project.slug, 'activity_id': report.activity.id, 'report_id': report.id}) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-line-chart"></i>
                                        <span class="kt-nav__link-text">Détails</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('edit', report) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_edit', { slug: report.activity.project.slug, 'activity_id': report.activity.id, 'report_id': report.id}) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-settings"></i>
                                        <span class="kt-nav__link-text">Modifier</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('remove', report) %}
                                <li class="kt-nav__item">
                                    <a href="#" data-id="{{ report.id }}" class="kt-nav__link btn-remove">
                                        <i class="kt-nav__link-icon flaticon-delete"></i>
                                        <span class="kt-nav__link-text">Supprimer</span>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>

            <div class="kt-widget__body">
                <div class="kt-widget__stats">
                    <div class="kt-widget__item">
                        <span class="kt-widget__date">
                            Date de création
                        </span>
                        <div class="kt-widget__label">
                            <span class="btn btn-label-brand btn-sm btn-bold btn-upper">{{ report.createdat is empty ? "" : report.createdat | date('Y-m-d') }}</span>
                        </div>
                    </div>

                    <div class="kt-widget__item">
                        <span class="kt-widget__date">
                            Date de synchronisation
                        </span>
                        <div class="kt-widget__label">
                            <span class="btn btn-label-danger btn-sm btn-bold btn-upper">{{ report.syncedat is empty ? "" : report.syncedat | date('Y-m-d') }}</span>
                        </div>
                    </div>
                </div>

                <span class="kt-widget__text">
                    {{ report.description|excerpt }}                         
                </span>

                <div class="kt-widget__content">
                    <div class="kt-widget__details">
                        <span class="kt-widget__subtitle">Résultats</span>
                        <span class="kt-widget__value">{{ report.results.count }}</span>
                    </div>
                    <div class="kt-widget__details">
                        <span class="kt-widget__subtitle">Documents</span>
                        <div class="kt-media-group">
                            {% for reportFile in report.reportFiles %}
                                {% if reportFile.file %}
                                    {% if reportFile.file.image %}
                                        <a href="#" class="kt-media kt-media--sm kt-media--circle" data-toggle="kt-tooltip" data-skin="brand" data-placement="top" title="" data-original-title="Fichier attaché">
                                            <img src="{{ asset( reportFile.file.icone ) | imagine_filter('thumb') }}" alt="image">
                                        </a>
                                    {% else %}
                                        <a href="{{ path( 'file_download', {id:reportFile.file.id}) }}" target="_blank" class="kt-media kt-media--sm kt-media--circle" data-toggle="kt-tooltip" data-skin="brand" data-placement="top" title="" data-original-title="Cliquez pour le télécharger.">
                                            <img src="{{ asset( reportFile.file.icone ) }}" alt="image">
                                        </a>
                                    {% endif %}
                                {% endif %}
                            {% else %}
                                Aucun fichier attaché à ce rapport.
                            {% endfor %}
                        </div>                                 
                    </div>
                </div>
            </div>
        </div>
        <!--end::Widget -->
    </div>
</div>
<!--end:: Portlet-->