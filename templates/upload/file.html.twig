<div class="kt-widget4__item">
    <div class="kt-widget4__pic kt-widget4__pic--icon">
        <img src="{{ asset( file.icone ) | imagine_filter('thumb') }}" alt="icone">  
    </div>				
    <a href="{{ asset( file.icone) | imagine_filter('big') }}" data-toggle="lightbox" data-gallery="gallery" class="kt-widget4__title">
        {{ file.name }}
    </a>						
    <div class="kt-widget4__tools">
        <a href="#" class="btn btn-clean btn-icon btn-sm btn-delete-file">
            <i class="flaticon2-delete"></i>
        </a>
    </div>				
</div>
