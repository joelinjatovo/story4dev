{% extends 'indicator/create.html.twig' %}

{% block title %}{% trans %}indicator{% endtrans %} #{{ indicator.id }} - {% trans %}project{% endtrans %} #{{ project.id }} - {{ app.user.fullname }} {% endblock %}

{% block stylesheets %}{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}editing.indicator{% endtrans %}</h3>
            {% if is_granted('create_indicator', indicator.activity) %}
                <a href="{{ path('indicator_index', { slug: project.slug } ) }}" class="btn btn-label-brand btn-bold">{% trans %}button.add{% endtrans %}</a>
            {% endif %}
        </div>
        <div class="kt-subheader__toolbar">
            <div class="kt-subheader__wrapper">
                <a href="{{ url('indicator_show', { slug: project.slug, indicator_id: indicator.id }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">{% trans %}button.back{% endtrans %}</span></a>
                <div class="btn-group">
                <button type="submit" form="indicator" name="submit" value="save-default" class="btn btn-brand">
                    <i class="la la-check"></i> 
                    <span class="kt-hidden-mobile">{% trans %}button.update{% endtrans %}</span>
                </button>
            </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
