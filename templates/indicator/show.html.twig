{% extends 'base.html.twig' %}

{% block title %}Indicator #{{ indicator.id }} - Activity #{{ activity.id }} - Project #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{{ indicator.title }}</h3>
            <span class="kt-subheader__separator kt-hidden"></span>
            <div class="kt-subheader__breadcrumbs">
                <a href="{{ url('admin_index') }}" class="kt-subheader__breadcrumbs-home"><i class="flaticon2-shelter"></i></a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ url('project_list', { 'slug' : indicator.activity.project.author.slug, 'page' : 1 }) }}" class="kt-subheader__breadcrumbs-link">Projects</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ url('project_show', { 'slug' : indicator.activity.project.author.slug, 'id': indicator.activity.project.id })}}" class="kt-subheader__breadcrumbs-link">{{ activity.project.title }}</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ url('activity_show', { 'slug' : indicator.activity.project.author.slug, 'project_id': indicator.activity.project.id, 'activity_id': indicator.activity.id })}}" class="kt-subheader__breadcrumbs-link">{{ indicator.activity.title }}</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <span class="kt-subheader__breadcrumbs-link kt-subheader__breadcrumbs-link--active">{{ indicator.title }}</span>
            </div>
                    
        </div>
        <div class="kt-subheader__toolbar">
            <div class="kt-subheader__wrapper">
                <a href="{{ path('indicator_edit', { 'indicator_id' : indicator.activity.id, 'activity_id' : indicator.activity.id, 'project_id' : indicator.activity.project.id, 'slug': indicator.activity.project.author.slug } ) }}" class="btn kt-subheader__btn-primary">
                    Modifier &nbsp;
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
    {%- set i = 0 -%}
    {% for goal in indicator.goals %}
        {{ i % 2 == 0 ? '<div class="row">' : '' }}
            <div class="col-lg-6">
                {{ include('indicator/goal.html.twig', { 'goal' : goal } ) }}
            </div>
        {%- set i = i + 1 -%}
        {{ i % 2 == 0 ? '</div>' : '' }}
    {% endfor %}
    {{ ( i % 2 != 0 ) and ( i > 0 ) ? '</div>' : '' }}

{% endblock %}

{% block javascripts %}{% endblock %}
