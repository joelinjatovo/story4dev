{% extends 'base.html.twig' %}

{% block title %}Indicator #{{ indicator.id }} - Activity #{{ activity.id }} - Project #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{{ indicator.title }}</h3>
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__breadcrumbs">
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ url('project_list', { 'page' : 1 }) }}" class="kt-subheader__breadcrumbs-link">Projects</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ url('project_show', { 'id': indicator.activity.project.id })}}" class="kt-subheader__breadcrumbs-link">{{ activity.project.title }}</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ url('activity_show', { 'project_id': indicator.activity.project.id, 'activity_id': indicator.activity.id })}}" class="kt-subheader__breadcrumbs-link">{{ indicator.activity.title }}</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <span class="kt-subheader__breadcrumbs-link kt-subheader__breadcrumbs-link--active">{{ indicator.title }}</span>
            </div>
                    
        </div>
        <div class="kt-subheader__toolbar">
            <div class="kt-subheader__wrapper">
                <a href="{{ url('activity_show', { 'project_id' : indicator.activity.project.id, 'activity_id' : indicator.activity.id }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">Retour</span></a>
                {% if is_granted('edit', indicator) %}
                    <a href="{{ path('indicator_edit', { 'indicator_id' : indicator.id, 'activity_id' : indicator.activity.id, 'project_id' : indicator.activity.project.id } ) }}" class="btn kt-subheader__btn-primary">
                        Modifier &nbsp;
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-xl-12">
            <div class="kt-portlet kt-portlet--height-fluid">
                <div class="kt-portlet__head">
                    <div class="kt-portlet__head-label">
                        <h3 class="kt-portlet__head-title">
                            Statistiques
                        </h3>
                    </div>
                </div>
                <div class="kt-portlet__body kt-portlet__body--fluid">
                     <div id="chartdiv" style="width: 100%; height: 400px;"></div>
                </div>
            </div>
        </div>
    </div>
    
    {%- set i = 0 -%}
    {% for goal in indicator.goals %}
        {{ i % 2 == 0 ? '<div class="row">' : '' }}
            <div class="col-lg-6">
                {{ include('indicator/goal.html.twig', { 'goal' : goal } ) }}
            </div>
        {%- set i = i + 1 -%}
        {{ i % 2 == 0 ? '</div>' : '' }}
    {% endfor %}
    {{ ( i % 2 != 0 ) and ( i > 0 ) ? '</div>' : '' }}

{% endblock %}

{% block javascripts %}

<!-- Resources -->
<script src="{{ asset('js/am4chart/core.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/am4chart/charts.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/am4chart/animated.js') }}" type="text/javascript" ></script>

<!-- Chart code -->
<script>
am4core.ready(function() {

    // Themes begin
    am4core.useTheme(am4themes_animated);
    // Themes end

    // Create chart instance
    var chart = am4core.create("chartdiv", am4charts.XYChart);
    
    chart.data = {{ data|raw }};
    
    var categoryAxis = chart.xAxes.push(new am4charts.CategoryAxis());
    categoryAxis.dataFields.category = "iteration";
    
    var valueAxis1 = chart.yAxes.push(new am4charts.ValueAxis());
    valueAxis1.title.text = "Valeur par unité";
    
    var valueAxis2 = chart.yAxes.push(new am4charts.ValueAxis());
    valueAxis2.title.text = "Progression";
    valueAxis2.renderer.opposite = true;
    valueAxis2.renderer.grid.template.disabled = true;

    // Create series
    var series1 = chart.series.push(new am4charts.ColumnSeries());
        series1.dataFields.valueY = "value";
        series1.dataFields.categoryX = "iteration";
        series1.dataFields.unit = "unit";
        series1.yAxis = valueAxis1;
        series1.name = "Résultat";
        series1.tooltipText = "{name}\n[bold font-size: 20]{valueY}[/] {unit}";
        series1.fill = chart.colors.getIndex(0);
        series1.strokeWidth = 0;
        series1.clustered = false;
        series1.columns.template.width = am4core.percent(40);

    var series2 = chart.series.push(new am4charts.ColumnSeries());
        series2.dataFields.valueY = "goal";
        series2.dataFields.categoryX = "iteration";
        series2.dataFields.unit = "unit";
        series2.yAxis = valueAxis1;
        series2.name = "Objectif";
        series2.tooltipText = "{name}\n[bold font-size: 20]{valueY}[/] {unit}";
        series2.fill = chart.colors.getIndex(0).lighten(0.5);
        series2.strokeWidth = 0;
        series2.clustered = false;
        series2.toBack();
    
    var series3 = chart.series.push(new am4charts.LineSeries());
        series3.dataFields.valueY = "progression";
        series3.dataFields.categoryX = "iteration";
        series3.name = "Progression";
        series3.strokeWidth = 2;
        series3.tensionX = 0.7;
        series3.yAxis = valueAxis2;
        series3.tooltipText = "{name}\n[bold font-size: 20]{valueY}%[/]";

        var bullet3 = series3.bullets.push(new am4charts.CircleBullet());
            bullet3.circle.radius = 3;
            bullet3.circle.strokeWidth = 2;
            bullet3.circle.fill = am4core.color("#fff");


    // Add cursor
    chart.cursor = new am4charts.XYCursor();

    // Add legend
    chart.legend = new am4charts.Legend();
    chart.legend.position = "top";

}); // end am4core.ready()
</script>
{% endblock %}
