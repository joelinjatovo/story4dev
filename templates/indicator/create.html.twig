{% extends 'base.html.twig' %}

{% block title %}Nouvel indicateur - Projet #{{ project.id }} - {{ app.user.fullname }} {% endblock %}

{% block stylesheets %}{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}new.indicator{% endtrans %}</h3>
        </div>
        <div class="kt-subheader__toolbar">
            <div class="kt-subheader__wrapper">
               <a href="{{ url('project_show', { slug : project.slug }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">Retour</span></a>
                <div class="btn-group">
                <button type="submit" form="indicator" name="submit" value="save-default" class="btn btn-brand">
                    <i class="la la-check"></i> 
                    <span class="kt-hidden-mobile">{% trans %}button.save{% endtrans %}</span>
                </button>
            </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
   	<div class="col-lg-12">	
		<!--begin::Portlet-->
		<div class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
			<div class="kt-portlet__body">
				{{ form_start( form, { 'method' : 'POST', 'attr' : { 'id' : 'indicator', 'class' : 'kt-form' } } ) }}
					<div class="row">
						<div class="col-xl-2"></div>
						<div class="col-xl-8">
							<div class="kt-section kt-section--first">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Info:</h3>
									<div class="form-group row">
                    					{{ form_label( form.title, "Nom de l'indicateur", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.title, { 'attr' : { 'class' : 'form-control', 'required':'true' } } ) }}
										</div>
									</div>
                                    <div class="form-group row">
                                        {{ form_label( form.activity, null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
                                        <div class="col-lg-9">
                                            {{ form_widget( form.activity, { 'attr' : { 'class' : 'form-control' } } ) }}
                                        </div>
                                    </div>
									<div class="form-group form-group-last row">
                    					{{ form_label( form.unit, "Unité de l'indicateur", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.unit, { 'attr' : { 'class' : 'form-control', 'required':'true' } } ) }}
										</div>
									</div>
									<div class="form-group row kt-hidden">
										<label class="col-3 col-form-label">Méthode de calcul</label>
										<div class="col-9">
											<div class="kt-checkbox-inline">
												<label class="kt-checkbox">
                                                    {{ form_widget( form.cummulative ) }} Cumulé 
												<span></span>
												</label>
											</div>
										</div>
									</div>
								</div>
							</div>
							<div class="kt-separator kt-separator--border-dashed kt-separator--space-lg"></div>
							<div class="kt-section kt-section--first">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Objectifs:</h3>
									{%- set i = 0 -%}
									{% for goal in form.goals %}
										<div class="form-group row">
											<label class="col-3 col-form-label">{{ goal.vars.data.iteration.title }}</label>
											<div class="col-9">
                                                {{ form_widget( goal.id ) }}
                                                <input type="hidden" id="indicator_goals_{{i}}_iteration" name="indicator[goals][{{i}}][iteration]" value="{{ goal.vars.data.iteration.id }}">
                                                {{ form_widget( goal.value, { 'attr' : { 'class' : 'form-control', 'placeholder' : "Valeur de l'objectif de ce suivi", 'autocomplete':'off' } } ) }}
											</div>
										</div>
										{%- set i = i + 1 -%}
									{% endfor %}
								</div>
							</div>
						</div>
						<div class="col-xl-2"></div>
					</div>
					{{ form_row( form._token ) }}
				{{ form_end( form, {'render_rest': false}) }}
			</div>
		</div>	
		<!--end::Portlet-->
	</div>
</div>
{% endblock %}


{% block javascripts %}
    <script src="{{ asset('js/add-user.js') }}" type="text/javascript" ></script>
{% endblock %}
