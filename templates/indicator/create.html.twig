{% extends 'base.html.twig' %}

{% block title %}Nouvel indicateur - Activity #{{ activity.id }} - Project #{{ project.id }} - {{ app.user.fullname }} {% endblock %}

{% block stylesheets %}{% endblock %}

{% block subheader %}<br>{% endblock %}

{% block content %}
<div class="row">
   	<div class="col-lg-12">	
		<!--begin::Portlet-->
		<div class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
			<div class="kt-portlet__head kt-portlet__head--lg" style="">
				<div class="kt-portlet__head-label">
                    {% block headtitle %}
					   <h3 class="kt-portlet__head-title">Nouvel Indicateur <small>entrer les détails de l'indicator puis enregister</small></h3>
                    {% endblock %}
				</div>
				<div class="kt-portlet__head-toolbar">
                    {% if indicator is defined and indicator is not null and (indicator.id>0) %}
					   <a href="{{ url('indicator_show', { 'slug' : indicator.activity.project.author.slug, 'project_id' : indicator.activity.project.id, 'activity_id' : indicator.activity.id, 'indicator_id' : indicator.id }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">Retour</span></a>
                    {% else %}
					   <a href="{{ url('activity_show', { 'slug' : activity.project.author.slug, 'project_id' : activity.project.id, 'activity_id' : activity.id }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">Retour</span></a>
                    {% endif %}
					<div class="btn-group">
						<button type="submit" form="indicator" name="submit" value="save-default" class="btn btn-brand">
							<i class="la la-check"></i> 
							<span class="kt-hidden-mobile">Save</span>
						</button>
						<button type="button" class="btn btn-brand dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
						</button>
						<div class="dropdown-menu dropdown-menu-right">
							<ul class="kt-nav">
								<li class="kt-nav__item">
									<button type="submit" form="indicator" name="submit" value="save-continue" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-reload"></i>
										<span class="kt-nav__link-text">Save &amp; continue</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="indicator" name="submit" value="save-edit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-edit"></i>
										<span class="kt-nav__link-text">Save &amp; edit</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="indicator" name="submit" value="save-create" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-add-1"></i>
										<span class="kt-nav__link-text">Save &amp; add new</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="indicator" name="submit" value="save-exit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon-close"></i>
										<span class="kt-nav__link-text">Save &amp; exit</span>
									</button>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="kt-portlet__body">
				{{ form_start( form, { 'method' : 'POST', 'attr' : { 'id' : 'indicator', 'class' : 'kt-form' } } ) }}
					<div class="row">
						<div class="col-xl-2"></div>
						<div class="col-xl-8">
							<div class="kt-section kt-section--first">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Indicator Info:</h3>
									<div class="form-group row">
                    					{{ form_label( form.title, null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.title, { 'attr' : { 'class' : 'form-control', 'required':'true' } } ) }}
										</div>
									</div>
									<div class="form-group row">
                    					{{ form_label( form.unit, null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.unit, { 'attr' : { 'class' : 'form-control', 'required':'true' } } ) }}
										</div>
									</div>
									<div class="form-group form-group-last row">
										<label class="col-3 col-form-label">Calcul</label>
										<div class="col-9">
											<div class="kt-checkbox-inline">
												<label class="kt-checkbox">
												<input type="checkbox" checked=""> Cummule 
												<span></span>
												</label>
											</div>
										</div>
									</div>
								</div>
							</div>
							<div class="kt-separator kt-separator--border-dashed kt-separator--space-lg"></div>
							<div class="kt-section kt-section--first">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Indicator Goals:</h3>
									{%- set i = 0 -%}
									{% for goal in form.goals %}
										<div class="form-group row">
											<label class="col-3 col-form-label">{{ goal.vars.data.iteration.title }}</label>
											<div class="col-9">
                                                {{ form_widget( goal.id ) }}
                                                <input type="hidden" id="indicator_goals_{{i}}_iteration" name="indicator[goals][{{i}}][iteration]" value="{{ goal.vars.data.iteration.id }}">
                                                {{ form_widget( goal.value, { 'attr' : { 'class' : 'form-control js-datepicker', 'autocomplete':'off' } } ) }}
											</div>
										</div>
										{%- set i = i + 1 -%}
									{% endfor %}
								</div>
							</div>
						</div>
						<div class="col-xl-2"></div>
					</div>
					<input type="hidden" name="indicator[activity]" value="{{ activity.id }}" >
					{{ form_row( form._token ) }}
				{{ form_end( form, {'render_rest': false}) }}
			</div>
		</div>	
		<!--end::Portlet-->
	</div>
</div>
{% endblock %}


{% block javascripts %}
    <script src="{{ asset('js/add-user.js') }}" type="text/javascript" ></script>
{% endblock %}
