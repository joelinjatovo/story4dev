{% extends 'base.html.twig' %}

{% block title %}{% trans %}indicators{% endtrans %} {% if activity is not null %}- {% trans %}activity{% endtrans %}#{{ activity.id }}{% endif %} - {% trans %}project{% endtrans %}#{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}all.indicators{% endtrans %}</h3>
            <a href="{{ path('indicator_index', { slug: project.slug } ) }}" class="btn btn-label-brand btn-bold"><i class="la la-plus"></i> {% trans %}button.add{% endtrans %}</a>
        </div>        
        <div class="kt-subheader__toolbar">
            <a href="{{ path('indicator_list_type', { slug: project.slug, type: 'list' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-list"></i>  {% trans %}list{% endtrans %}</a>
            <a href="{{ path('indicator_list_type', { slug: project.slug, type: 'grid' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-large"></i>  {% trans %}grid{% endtrans %}</a>
            <a href="{{ url('project_show', { 'slug' : project.slug }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile"> {% trans %}button.back{% endtrans %}</span></a>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<!--begin::Notice-->
<div class="alert alert-custom alert-white alert-shadow gutter-b" role="alert">
	<div class="alert-text">
        <form class="form" id="filter">
            <div class="row">
                <div class="col-lg-4 col-md-4 col-sm-12">
                    {{ include('_common/_search.html.twig') }}
                </div>
                <div class="col-lg-4 col-md-4 col-sm-12">
                    <select class="form-control select2" id="kt_select2" name="activity_id">
                        <option>{% trans %}all2{% endtrans %}</option>
                        {% for _activity in activities %}
                            <option value="{{ _activity.id }}" {{ activity != null and activity.id == _activity.id ? 'selected="selected"' : '' }}>{{ _activity.title }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-12">
                    <button type="submit" class="btn btn-label-primary font-weight-bold"><i class="la la-filter"></i>  {% trans %}button.filter{% endtrans %}</button>
                </div>
            </div>
        </form>
    </div>
</div>
<!--end::Notice-->

{% for indicator in indicators %}
    <div class="kt-portlet indicator-item">
        <div class="kt-portlet__body">
            <div class="kt-widget kt-widget--user-profile-3">
                <div class="kt-widget__top">
                    <div class="kt-widget__content">
                        <div class="kt-widget__head">
                            <a href="{{ url('indicator_show', { 'slug' : indicator.activity.project.slug, 'activity_id' : indicator.activity.id, 'indicator_id' : indicator.id }) }}" class="kt-widget__username">
                                {{ indicator.title }}   
                            </a>
                            <div class="kt-widget__action">
                                <div class="kt-portlet__head-toolbar">
                                    {% if is_granted('star', indicator) %}
                                        <a data-id="{{ indicator.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-star" data-toggle="kt-tooltip" data-placement="top" data-original-title="{{ indicator|favorite(app.user) ? 'unstar' | trans : 'star' | trans }}">
                                            <i class="la {{ indicator|favorite(app.user) ? 'la-star' : 'la-star-o' }}"></i>
                                        </a>
                                    {% endif %}
                                    <a href="#" class="btn btn-clean btn-sm btn-icon btn-icon-md" data-toggle="dropdown">
                                        <i class="flaticon-more-1"></i>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-fit dropdown-menu-right">
                                        <ul class="kt-nav">
                                            {% if is_granted('view', indicator) %}
                                                <li class="kt-nav__item">
                                                    <a href="{{ url('indicator_show', {'slug' : indicator.activity.project.slug, 'activity_id' : indicator.activity.id, 'indicator_id' : indicator.id }) }}" class="kt-nav__link">
                                                        <i class="kt-nav__link-icon flaticon2-line-chart"></i>
                                                        <span class="kt-nav__link-text">{% trans %}button.detail{% endtrans %}</span>
                                                    </a>
                                                </li>
                                            {% endif %}
                                            {% if is_granted('edit', indicator) %}
                                                <li class="kt-nav__item">
                                                    <a href="{{ path('indicator_edit', { 'activity_id' : indicator.activity.id, 'slug' : indicator.activity.project.slug, 'indicator_id' : indicator.id} ) }}" class="kt-nav__link">
                                                        <i class="kt-nav__link-icon flaticon2-settings"></i>
                                                        <span class="kt-nav__link-text">{% trans %}button.edit{% endtrans %}</span>
                                                    </a>
                                                </li>
                                            {% endif %}
                                            {% if is_granted('remove', indicator) %}
                                                <li class="kt-nav__item">
                                                    <a data-id={{ indicator.id }} href="#" class="kt-nav__link btn-remove">
                                                        <i class="kt-nav__link-icon flaticon-delete"></i>
                                                        <span class="kt-nav__link-text">{% trans %}button.delete{% endtrans %}</span>
                                                    </a>
                                                </li>
                                            {% endif %}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="kt-widget__info">
                            <div class="kt-widget__desc">
                            </div> 
                            <div class="kt-widget__progress">
                                <div class="kt-widget__text">
                                    {% trans %}progression.general{% endtrans %}
                                </div>
                                <div class="progress" style="height: 5px;width: 100%;">
                                    <div class="progress-bar kt-bg-{{ indicator|progressionClass }}" role="progressbar" style="width: {{ indicator|progression }}%;" aria-valuenow="{{ indicator|progression }}" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="kt-widget__stats">
                                    {{ indicator|progression }}% 
                                </div>
                            </div> 
                        </div>
                    </div>    
                </div>
                <div class="kt-widget__bottom">
                    {% for goal in indicator.goals %}
                        <div class="kt-widget__item">
                            <div class="kt-widget__details" style="width: 100%;">
                                <div class="kt-widget__progress">
                                    <div class="kt-widget__text">
                                        {{ goal.iteration.title }}
                                    </div>
                                    <div class="progress" style="height: 5px;width: 100%;">
                                        <div class="progress-bar kt-bg-{{ indicator|progressionClass(goal.iteration) }}" role="progressbar" style="width: {{ indicator|progression(goal.iteration) }}%;" aria-valuenow="{{ indicator|progression(goal.iteration) }}" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <div class="kt-widget__stats">
                                        {{ indicator|progression(goal.iteration) }}% 
                                    </div>
                                </div>   
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endfor %}
    
<div class="row">
    <div class="col-xl-12">         
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': indicators}) }}
                </div>
            </div>
        </div>
    </div>           
</div>
{% endblock %}


{% block javascripts %}
<script type="text/javascript">
jQuery(document).ready(function($){
    $('#kt_select2').select2({
        placeholder: "{% trans %}select.activity{% endtrans %}",
    });
    $(document).on('click', '.btn-remove', function(e){
        e.preventDefault();
        var $this = $(this);
            swal.fire({
                title:"{% trans %}swal.remove.title{% endtrans %}",
                text:"{% trans %}swal.remove.content.indicator{% endtrans %}",
                type:"warning",
                showCancelButton:!0,
                confirmButtonText:"{% trans %}button.confirm.delete1{% endtrans %}",
                cancelButtonText:"{% trans %}button.cancel{% endtrans %}"
            }).then(function(e){
                if(e.value){
                    KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
                    $.post("/indicator/remove", { id: $this.attr('data-id') })
                    .done(function( data ) {
                        KTApp.unblockPage();
                        if(data.success){
                            $this.closest('.indicator-item').remove();
                            toastr.success(data.message);
                        }else{
                            toastr.error(data.message, data.title);
                        }
                    })
                    .fail(function() {
                        KTApp.unblockPage();
                        toastr.error("{% trans %}swal.error{% endtrans %}");
                    });
                }
            })
    });
    $(document).on('click', '.btn-star', function(e){
        e.preventDefault();
        var $this = $(this);
        KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
        $.post("/indicator/star", { id: $this.attr('data-id') })
        .done(function( data ) {
            KTApp.unblockPage();
            if(data.success){
                if(data.star){
                    $this.find('i').removeClass('la-star-o').addClass('la-star');
                    toastr.success(data.message);
                }else{
                    $this.find('i').removeClass('la-star').addClass('la-star-o');
                    toastr.warning(data.message);
                }
            }else{
                toastr.error(data.message, data.title);
            }
        })
        .fail(function() {
            KTApp.unblockPage();
            toastr.error("{% trans %}swal.error{% endtrans %}");
        });
    });
});
</script>
{% endblock %}
