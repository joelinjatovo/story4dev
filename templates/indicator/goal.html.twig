<div class="kt-portlet kt-portlet--height-fluid">
    <div class="kt-portlet__head">
        <div class="kt-portlet__head-label">
            <h3 class="kt-portlet__head-title">{{ goal.iteration.title }}</h3>
        </div>
    </div>
    <div class="kt-portlet__body">
        <div class="kt-widget31">
            <div class="kt-widget31__item">
                <div class="kt-widget31__content" style="width: 100%;">
                    <div class="kt-widget31__progress">
                        <a href="#" class="kt-widget31__stats">
                            {% set indicator = goal.indicator %}
                            <span>{{ indicator | progression(goal.iteration) }}%</span>
                            <span></span>						    							 
                        </a>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-{{ goal.indicator.progressionclass(goal.iteration) }}" role="progressbar" style="width: {{ goal.indicator.progression(goal.iteration) }}%" aria-valuenow="{{ goal.indicator.progression(goal.iteration) }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>	
                </div>						
            </div>
        </div>
    </div>
</div>