{% extends 'base.html.twig' %}

{% block title %}{% trans %}indicators{% endtrans %} {% if activity is not null %}- {% trans %}activity{% endtrans %}#{{ activity.id }}{% endif %} - {% trans %}project{% endtrans %}#{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}all.indicators{% endtrans %}</h3>
            <a href="{{ path('indicator_index', { slug: project.slug } ) }}" class="btn btn-label-brand btn-bold"><i class="la la-plus"></i> {% trans %}button.add{% endtrans %}</a>
        </div>        
        <div class="kt-subheader__toolbar">
            <a href="{{ path('indicator_list_type', { slug: project.slug, type: 'list' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-list"></i> {% trans %}list{% endtrans %}</a>
            <a href="{{ path('indicator_list_type', { slug: project.slug, type: 'grid' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-large"></i> {% trans %}grid{% endtrans %}</a>
            <a href="{{ url('project_show', { 'slug' : project.slug }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">{% trans %}button.back{% endtrans %}</span></a>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<!--begin::Notice-->
<div class="alert alert-custom alert-white alert-shadow gutter-b" role="alert">
	<div class="alert-text">
        <form class="form" id="filter">
            <div class="row">
                <div class="col-lg-4 col-md-4 col-sm-12">
                    {{ include('_common/_search.html.twig') }}
                </div>
                <div class="col-lg-4 col-md-4 col-sm-12">
                    <select class="form-control select2" id="kt_select2" name="activity_id">
                        <option>{% trans %}all2{% endtrans %}</option>
                        {% for _activity in activities %}
                            <option value="{{ _activity.id }}" {{ activity != null and activity.id == _activity.id ? 'selected="selected"' : '' }}>{{ _activity.title }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-12">
                    <button type="submit" class="btn btn-label-primary font-weight-bold"><i class="la la-filter"></i> {% trans %}button.filter{% endtrans %}</button>
                </div>
            </div>
        </form>
    </div>
</div>
<!--end::Notice-->

<div class="row">
	<div class="col-xl-12 col-lg-12">
		<div class="kt-portlet kt-portlet--height-fluid kt-portlet--mobile ">
            <div class="kt-portlet__body kt-portlet__body--fit">
                <div class="kt-datatable kt-datatable--default kt-datatable--brand kt-datatable--loaded" >
                    <table class="kt-datatable__table" style="display: block;">
                        <thead class="kt-datatable__head">
                            <tr class="kt-datatable__row" style="left: 0px;">
                                <th data-field="{% trans %}indicators{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 250px;">{% trans %}indicators{% endtrans %}</span>
                                </th>
                                {% if activity is null %}
                                    <th data-field="{% trans %}activities{% endtrans %}" class="kt-datatable__cell kt-datatable__cell--sort">
                                        <span style="width: 222px;">{% trans %}activities{% endtrans %}</span>
                                    </th>
                                {% endif %}
                                <th data-field="{% trans %}progressions{% endtrans %}" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 222px;">{% trans %}progressions{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}results{% endtrans %}" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 100px;">{% trans %}results{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}actions{% endtrans %}" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 150px;">{% trans %}actions{% endtrans %}</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="kt-datatable__body">
                            {% for indicator in indicators %}
                                <tr data-row="0" class="kt-datatable__row indicator-item" style="left: 0px;">
                                    <td data-field="{% trans %}indicators{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell">
                                        <span style="width: 250px;">
                                            <div class="kt-user-card-v2">
                                                <div class="kt-user-card-v2__details">
                                                    <a class="kt-user-card-v2__name" href="{{ path('indicator_show', { 'slug': indicator.activity.project.slug, 'activity_id': indicator.activity.id, 'indicator_id': indicator.id }) }}">{{ indicator.title }}</a>
                                                    <span class="kt-user-card-v2__email">{{ indicator.unit ? indicator.unit.title }}</span>
                                                </div>
                                            </div>
                                        </span>
                                    </td>
                                    {% if activity is null %}
                                        <td data-field="{% trans %}activities{% endtrans %}" class="kt-datatable__cell">
                                            <span style="width: 222px;">
                                                <div class="kt-user-card-v2">
                                                    <div class="kt-user-card-v2__details">
                                                        <a class="kt-user-card-v2__name" href="{{ path('activity_show', { slug: indicator.activity.project.slug, activity_id: indicator.activity.id }) }}">{{ indicator.activity.title }}</a>
                                                    </div>
                                                </div>
                                            </span>
                                        </td>
                                    {% endif %}
                                    <td data-field="{% trans %}progressions{% endtrans %}" class="kt-datatable__cell">
                                        <span style="width: 222px;">
                                            <div class="kt-widget__item">
                                                <div class="kt-widget__progress-" style="width: 90%;">
                                                    <div class="progress" style="height: 5px;width: 100%;">
                                                        <div class="progress-bar kt-bg-{{ indicator|progressionClass }}" role="progressbar" style="width: {{ indicator|progression }}%;" aria-valuenow="{{ indicator|progression }}" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <div class="kt-widget__stats">
                                                        {{ indicator|progression }}%
                                                    </div>
                                                </div>
                                            </div>
                                        </span>
                                    </td>
                                    <td data-field="{% trans %}result{% endtrans %}" class="kt-datatable__cell">
                                        <span style="width: 100px;" ><span class="kt-font-bold">{{ indicator.results.count }} </span>Résultats</span>
                                    </td>
                                    <td data-field="{% trans %}action{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell">
                                        <span style="overflow: visible; position: relative; width: 150px;">
                                            {% if is_granted('star', indicator) %}
                                                <a data-id="{{ indicator.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-star" data-toggle="kt-tooltip" data-placement="top" data-original-title="{{ indicator|favorite(app.user) ? 'unstar' | trans : 'star' | trans }}">
                                                    <i class="la {{ indicator|favorite(app.user) ? 'la-star' : 'la-star-o' }}"></i>
                                                </a>
                                            {% endif %}
                                            {% if is_granted('edit', indicator) %}
                                                <a href="{{ path('indicator_edit', { 'slug': indicator.activity.project.slug, 'activity_id': indicator.activity.id, 'indicator_id': indicator.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md" data-toggle="kt-tooltip" data-placement="top" data-original-title="{% trans %}button.edit{% endtrans %}">
                                                    <i class="la la-edit"></i>
                                                </a>
                                            {% endif %}
                                            {% if is_granted('view', indicator) %}
                                                <a href="{{ path('indicator_show', { 'slug': indicator.activity.project.slug, 'activity_id': indicator.activity.id, 'indicator_id': indicator.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md" data-toggle="kt-tooltip" data-placement="top" data-original-title="{% trans %}button.detail{% endtrans %}">
                                                    <i class="la la-eye"></i>
                                                </a>
                                            {% endif %}
                                            {% if is_granted('remove', indicator) %}
                                                <a title="{% trans %}button.delete{% endtrans %}" data-id="{{ indicator.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-remove" data-toggle="kt-tooltip" data-placement="top" data-original-title="{% trans %}button.delete{% endtrans %}">
                                                    <i class="la la-trash"></i>
                                                </a>
                                            {% endif %}
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
    
<div class="row">
    <div class="col-xl-12">         
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': indicators}) }}
                </div>
            </div>
        </div>
    </div>           
</div>
{% endblock %}


{% block javascripts %}
<script type="text/javascript">
jQuery(document).ready(function($){
    $('#kt_select2').select2({
        placeholder: "{% trans %}select.activity{% endtrans %}",
    });
    $(document).on('click', '.btn-remove', function(e){
        e.preventDefault();
        var $this = $(this);
            swal.fire({
                title:"{% trans %}swal.remove.title{% endtrans %}",
                text:"{% trans %}swal.remove.content.indicator{% endtrans %}",
                type:"warning",
                showCancelButton:!0,
                confirmButtonText:"{% trans %}button.confirm.delete1{% endtrans %}",
                cancelButtonText:"{% trans %}button.cancel{% endtrans %}"
            }).then(function(e){
                if(e.value){
                    KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
                    $.post("/indicator/remove", { id: $this.attr('data-id') })
                    .done(function( data ) {
                        KTApp.unblockPage();
                        if(data.success){
                            $this.closest('.indicator-item').remove();
                            toastr.success(data.message);
                        }else{
                            toastr.error(data.message, data.title);
                        }
                    })
                    .fail(function() {
                        KTApp.unblockPage();
                        toastr.error("{% trans %}swal.error{% endtrans %}");
                    });
                }
            })
    });
    $(document).on('click', '.btn-star', function(e){
        e.preventDefault();
        var $this = $(this);
        KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
        $.post("/indicator/star", { id: $this.attr('data-id') })
        .done(function( data ) {
            KTApp.unblockPage();
            if(data.success){
                if(data.star){
                    $this.find('i').removeClass('la-star-o').addClass('la-star');
                    $this.attr('data-original-title', "{% trans %}button.unstar{% endtrans %}");
                    toastr.success(data.message);
                }else{
                    $this.find('i').removeClass('la-star').addClass('la-star-o');
                    $this.attr('data-original-title', "{% trans %}button.star{% endtrans %}");
                    toastr.warning(data.message);
                }
            }else{
                toastr.error(data.message, data.title);
            }
        })
        .fail(function() {
            KTApp.unblockPage();
            toastr.error("{% trans %}swal.error{% endtrans %}");
        });
    });
});
</script>
{% endblock %}
