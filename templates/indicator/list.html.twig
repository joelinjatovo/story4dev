{% extends 'base.html.twig' %}

{% block title %}Indicateurs {% if activity is not null %}- Activité#{{ activity.id }}{% endif %} - Projet#{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% if activity is null %}{{ project.title }}{% else %}{{ activity.title }}{% endif %} : Indicateurs</h3>
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__breadcrumbs">
                <a href="{{ path('project_list', { page : 1 }) }}" class="kt-subheader__breadcrumbs-link">Projects</a>
                {% if activity is null %}
                    <span class="kt-subheader__breadcrumbs-separator"></span>
                    <a href="{{ path('project_show', { slug: project.slug })}}" class="kt-subheader__breadcrumbs-link">{{ project.title }}</a>
                    <span class="kt-subheader__breadcrumbs-separator"></span>
                    <span class="kt-subheader__breadcrumbs-link kt-subheader__breadcrumbs-link--active">Indicateurs</span>
                {% else %}
                    <span class="kt-subheader__breadcrumbs-separator"></span>
                    <a href="{{ path('project_show', { slug: activity.project.slug })}}" class="kt-subheader__breadcrumbs-link">{{ activity.project.title }}</a>
                    <span class="kt-subheader__breadcrumbs-separator"></span>
                    <a href="{{ path('activity_show', { slug: activity.project.slug, activity_id: activity.id })}}" class="kt-subheader__breadcrumbs-link">{{ activity.title }}</a>
                    <span class="kt-subheader__breadcrumbs-separator"></span>
                    <span class="kt-subheader__breadcrumbs-link kt-subheader__breadcrumbs-link--active">Indicateurs</span>
                {% endif %}
            </div>
        </div>        
        <div class="kt-subheader__toolbar">
            
            {% if activity is not null %}
                <a href="{{ path('indicator_list_type', { slug: project.slug, 'activity_id' : activity.id, type: 'list' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-list"></i> Liste</a>
                <a href="{{ path('indicator_list_type', { slug: project.slug, 'activity_id' : activity.id, type: 'grid' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-large"></i> Grille</a>
                <a href="{{ url('activity_show', { 'slug' : activity.project.slug, 'activity_id' : activity.id }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">Retour</span></a>
            {% else %}            
                <a href="{{ path('indicator_list2_type', { slug: project.slug, type: 'list' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-list"></i> Liste</a>
                <a href="{{ path('indicator_list2_type', { slug: project.slug, type: 'grid' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-large"></i> Grille</a>
                <a href="{{ url('project_show', { 'slug' : project.slug }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">Retour</span></a>
            {% endif %}
            <div class="dropdown dropdown-inline" data-toggle="kt-tooltip" title="" data-placement="left" data-original-title="Actions">
                <a href="#" class="btn btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                        <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                            <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                            <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                            <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                        </g>
                    </svg>
                    <!--<i class="flaticon2-plus"></i>-->
                </a>
                <div class="dropdown-menu dropdown-menu-fit dropdown-menu-md dropdown-menu-right">
                    <!--begin::Nav-->
                    <ul class="kt-nav">
                        <li class="kt-nav__head">
                            Actions
                            <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Cliquez pour afficher les menus..."></i>
                        </li>
                        <li class="kt-nav__separator"></li>
                        {% if activity is not null %}
                            {% if is_granted('create_indicator', activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('indicator_index', { 'activity_id' : activity.id, 'slug' : activity.project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-drop"></i>
                                        <span class="kt-nav__link-text">Indicateur</span>
                                    </a>
                                </li>
                            {% endif %}

                            {% if is_granted('view', activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_index', { 'activity_id' : activity.id, 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Rapport</span>
                                    </a>
                                </li>
                                <li class="kt-nav__separator"></li>
                                <li class="kt-nav__head">
                                    Aller dans
                                    <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                                </li>
                                <li class="kt-nav__separator"></li>
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_list2', { 'activity_id' : activity.id, 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Les rapports</span>
                                    </a>
                                </li>
                                <li class="kt-nav__item">
                                    <a href="{{ path('file_list_activity', { 'activity_id' : activity.id, 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Les documents</span>
                                    </a>
                                </li>
                                <li class="kt-nav__item">
                                    <a href="{{ path('indicator_list', { 'activity_id' : activity.id, 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">Les indicateurs</span>
                                    </a>
                                </li>
                            {% endif %}
                        {% else %}
                            {% if is_granted('edit', project) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('activity_index', { 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-drop"></i>
                                        <span class="kt-nav__link-text">Activité</span>
                                    </a>
                                </li>
                            {% endif %}
                        
                            {% if is_granted('edit', project) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('graph_index', { 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-drop"></i>
                                        <span class="kt-nav__link-text">Graphe</span>
                                    </a>
                                </li>
                            {% endif %}
                        
                            {% if is_granted('view', project) %}
                                <li class="kt-nav__separator"></li>
                                <li class="kt-nav__head">
                                    Aller dans                                   
                                    <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                                </li>
                                <li class="kt-nav__separator"></li>                        
                                <li class="kt-nav__item">
                                    <a href="{{ path('activity_list', { 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-new-email"></i>
                                        <span class="kt-nav__link-text">Les activités</span>
                                    </a>
                                </li>                        
                                <li class="kt-nav__item">
                                    <a href="{{ path('indicator_list2', { 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-new-email"></i>
                                        <span class="kt-nav__link-text">Les indicateurs</span>
                                    </a>
                                </li>                         
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_list', { 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-new-email"></i>
                                        <span class="kt-nav__link-text">Les rapports</span>
                                    </a>
                                </li>                        
                                <li class="kt-nav__item">
                                    <a href="{{ path('contribution_list', { 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-new-email"></i>
                                        <span class="kt-nav__link-text">Les contributeurs</span>
                                    </a>
                                </li>
                            {% endif %}
                        {% endif %}
                    </ul>
                    <!--end::Nav-->
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
	<div class="col-xl-12 col-lg-12">
		<div class="kt-portlet kt-portlet--height-fluid kt-portlet--mobile ">
            <div class="kt-portlet__body kt-portlet__body--fit">
                <div class="kt-datatable kt-datatable--default kt-datatable--brand kt-datatable--loaded" >
                    <table class="kt-datatable__table" style="display: block;">
                        <thead class="kt-datatable__head">
                            <tr class="kt-datatable__row" style="left: 0px;">
                                <th data-field="Indicateurs" data-autohide-disabled="false" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 250px;">Indicateurs</span>
                                </th>
                                {% if activity is null %}
                                    <th data-field="Activités" class="kt-datatable__cell kt-datatable__cell--sort">
                                        <span style="width: 222px;">Activités</span>
                                    </th>
                                {% endif %}
                                <th data-field="Avancements" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 222px;">Avancements</span>
                                </th>
                                <th data-field="Résultats" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 100px;">Résultats</span>
                                </th>
                                <th data-field="Actions" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 150px;">Actions</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="kt-datatable__body">
                            {% for indicator in indicators %}
                                <tr data-row="0" class="kt-datatable__row indicator-item" style="left: 0px;">
                                    <td data-field="Rapports" data-autohide-disabled="false" class="kt-datatable__cell">
                                        <span style="width: 250px;">
                                            <div class="kt-user-card-v2">
                                                <div class="kt-user-card-v2__details">
                                                    <a class="kt-user-card-v2__name" href="{{ path('indicator_show', { 'slug': indicator.activity.project.slug, 'activity_id': indicator.activity.id, 'indicator_id': indicator.id }) }}">{{ indicator.title }}</a>
                                                    <span class="kt-user-card-v2__email">{{ indicator.unit ? indicator.unit.title }}</span>
                                                </div>
                                            </div>
                                        </span>
                                    </td>
                                    {% if activity is null %}
                                        <td data-field="Activities" class="kt-datatable__cell">
                                            <span style="width: 222px;">
                                                <div class="kt-user-card-v2">
                                                    <div class="kt-user-card-v2__details">
                                                        <a class="kt-user-card-v2__name" href="{{ path('activity_show', { slug: indicator.activity.project.slug, activity_id: indicator.activity.id }) }}">{{ indicator.activity.title }}</a>
                                                    </div>
                                                </div>
                                            </span>
                                        </td>
                                    {% endif %}
                                    <td data-field="Avancements" class="kt-datatable__cell">
                                        <span style="width: 222px;">
                                            <div class="kt-widget__item">
                                                <div class="kt-widget__progress-" style="width: 90%;">
                                                    <div class="progress" style="height: 5px;width: 100%;">
                                                        <div class="progress-bar kt-bg-{{ indicator|progressionClass }}" role="progressbar" style="width: {{ indicator|progression }}%;" aria-valuenow="{{ indicator|progression }}" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <div class="kt-widget__stats">
                                                        {{ indicator|progression }}%
                                                    </div>
                                                </div>
                                            </div>
                                        </span>
                                    </td>
                                    <td data-field="Résultats" class="kt-datatable__cell">
                                        <span style="width: 100px;" ><span class="kt-font-bold">{{ indicator.results.count }} </span>Résultats</span>
                                    </td>
                                    <td data-field="Actions" data-autohide-disabled="false" class="kt-datatable__cell">
                                        <span style="overflow: visible; position: relative; width: 150px;">
                                            {% if is_granted('star', indicator) %}
                                                <a data-id="{{ indicator.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-star">
                                                    <i class="la la-star"></i>
                                                </a>
                                            {% endif %}
                                            {% if is_granted('edit', indicator) %}
                                                <a href="{{ path('indicator_edit', { 'slug': indicator.activity.project.slug, 'activity_id': indicator.activity.id, 'indicator_id': indicator.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                                                    <i class="la la-edit"></i>
                                                </a>
                                            {% endif %}
                                            {% if is_granted('view', indicator) %}
                                                <a href="{{ path('indicator_show', { 'slug': indicator.activity.project.slug, 'activity_id': indicator.activity.id, 'indicator_id': indicator.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                                                    <i class="la la-eye"></i>
                                                </a>
                                            {% endif %}
                                            {% if is_granted('remove', indicator) %}
                                                <a title="Supprimer ce rapport" data-id="{{ indicator.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-remove">
                                                    <i class="la la-trash"></i>
                                                </a>
                                            {% endif %}
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
    
<div class="row">
    <div class="col-xl-12">         
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': indicators}) }}
                </div>
            </div>
        </div>
    </div>           
</div>
{% endblock %}


{% block javascripts %}
<script type="text/javascript">
jQuery(document).ready(function($){
    $(document).on('click', '.btn-remove', function(e){
        e.preventDefault();
        var $this = $(this);
            swal.fire({
                title:"Vous êtes sûre?",
                text:"Vous ne pourez pas revenir en arrière après!",
                type:"warning",
                showCancelButton:!0,
                confirmButtonText:"Oui, supprimez le!",
                cancelButtonText:"Annuler"
            }).then(function(e){
                if(e.value){
                    KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
                    $.post("/indicator/remove", { id: $this.attr('data-id') })
                    .done(function( data ) {
                        KTApp.unblockPage();
                        if(data.success){
                            $this.closest('.indicator-item').remove();
                            toastr.success(data.message);
                        }else{
                            toastr.error(data.message, data.title);
                        }
                    })
                    .fail(function() {
                        KTApp.unblockPage();
                        toastr.error("Une erreur s'est produite. Veuillez réesayer plus tard!");
                    });
                }
            })
    });
    $(document).on('click', '.btn-star', function(e){
        e.preventDefault();
        var $this = $(this);
        KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
        $.post("/indicator/star", { id: $this.attr('data-id') })
        .done(function( data ) {
            KTApp.unblockPage();
            if(data.success){
                if(data.star){
                    $this.find('i').removeClass('la-star-o').addClass('la-star');
                }else{
                    $this.find('i').removeClass('la-star').addClass('la-star-o');
                }
                toastr.success(data.message);
            }else{
                toastr.error(data.message, data.title);
            }
        })
        .fail(function() {
            KTApp.unblockPage();
            toastr.error("Une erreur s'est produite. Veuillez réesayer plus tard!");
        });
    });
});
</script>
{% endblock %}
