<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <title>{% block title %}Application{% endblock %}</title>
        <meta name="description" content="Latest updates and statistic charts"> 

        <!--begin::Fonts -->
        <link href="{{ asset('css/fonts/poppins/poppins.css') }}" rel="stylesheet">
        <link href="{{ asset('css/fonts/roboto/roboto.css') }}" rel="stylesheet">
        <!--end::Fonts -->

        <!--begin::Global Theme Styles(used by all pages) -->
        <link href="{{ asset('css/vendors.bundle.css') }}" rel="stylesheet" type="text/css"/>
        <link href="{{ asset('css/style.bundle.css') }}" rel="stylesheet" type="text/css"/>
        <!--end::Global Theme Styles -->
        
        <!--begin::Layout Skins & Vendor Skins(used by this page) -->
        {% block stylesheets %}
        <link href="{{ asset('css/fullcalendar.bundle.css') }}" rel="stylesheet" type="text/css"/>
        {% endblock %}
        <!--end::Layout Skins & Vendor Skins -->

        <link rel="shortcut icon" href="{{ asset('images/favicon.ico') }}" />
    </head>
    <body id="page-body" class="kt-quick-panel--right kt-demo-panel--right kt-offcanvas-panel--right kt-header--fixed kt-header-mobile--fixed kt-subheader--enabled kt-subheader--transparent kt-aside--enabled kt-aside--fixed kt-aside--minimize kt-page--loading">
        <div style="visibility:hidden; opacity:0" class="dropzone-container" aria-modal="true" role="dialog">
            <button class="btn-close" type="button" aria-label="Close Modal" title="Close Modal"><span aria-hidden="true">×</span></button>
            <div class="dropzone-inner">
                <div class="dropzone dropzone-default dropzone-success dz-clickable">
                    <div class="dropzone-msg dz-message needsclick">
                        <h3 class="dropzone-msg-title">Drop files here or click to upload.</h3>
                        <span class="dropzone-msg-desc">Only image, pdf and psd files are allowed for upload</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- begin:: Header Mobile -->
        {% block header_mobile %}
            {{ include('_common/header_mobile.html.twig') }}
        {% endblock %}
        <!-- end:: Header Mobile -->
        
        <div class="kt-grid kt-grid--hor kt-grid--root">
            <div class="kt-grid__item kt-grid__item--fluid kt-grid kt-grid--ver kt-page">
                
                <!-- begin:: Aside -->
                {% block aside %}
                    {{ include('_common/aside.html.twig') }}
                {% endblock %}
                <!-- end:: Aside -->
                
			    <div class="kt-grid__item kt-grid__item--fluid kt-grid kt-grid--hor kt-wrapper" id="kt_wrapper">
                    
                    <!-- begin:: Header -->
                    {% block header %}
                        {{ include('_common/header.html.twig') }}
                    {% endblock %}
                    <!-- end:: Header -->
                    
                    <div class="kt-content kt-grid__item kt-grid__item--fluid kt-grid kt-grid--hor" id="kt_content">
                        <!-- begin:: Subheader -->
                        {% block subheader %}
                            {{ include('_common/subheader.html.twig') }}
                        {% endblock %}
                        <!-- end:: Subheader -->
                        
                        <!-- begin:: Content -->
                        <div class="kt-container kt-container--fluid  kt-grid__item kt-grid__item--fluid">
                        
                            <!-- begin:: Alert -->
                            {% block alert %}
                                {{ include('_common/alert.html.twig') }}
                            {% endblock %}
                            <!-- end:: Alert -->
                            
                            {% block content %}{% endblock %}
                        </div>
                        <!-- end:: Content -->
                        
                        <!-- begin:: Subfooter -->
                        {% block subfooter %}
                        {% endblock %}
                        <!-- end:: Subfooter -->
                    </div>
                    
                    <!-- begin:: Footer -->
                    {% block footer %}
                        {{ include('_common/footer.html.twig') }}
                    {% endblock %}
                    <!-- end:: Footer -->
                </div>
                
            </div>
        </div>
        
        <!-- begin::Scrolltop -->
        <div id="kt_scrolltop" class="kt-scrolltop">
            <i class="fa fa-arrow-up"></i>
        </div>
        <!-- end::Scrolltop -->
        
        <!-- begin::Sticky Toolbar -->
        <ul class="kt-sticky-toolbar" style="margin-top: 30px;">
            <li class="kt-sticky-toolbar__item kt-sticky-toolbar__item--success" id="kt_demo_panel_toggle" data-toggle="kt-tooltip"  title="Check out more demos" data-placement="right">
                <a href="#" class=""><i class="flaticon2-drop"></i></a>
            </li>
            <li class="kt-sticky-toolbar__item kt-sticky-toolbar__item--brand" data-toggle="kt-tooltip" title="Layout Builder" data-placement="left">
                <a href="/" ><i class="flaticon2-gear"></i></a>
            </li>
            <li class="kt-sticky-toolbar__item kt-sticky-toolbar__item--warning" data-toggle="kt-tooltip" title="Documentation" data-placement="left">
                <a href="/" target="_blank"><i class="flaticon2-telegram-logo"></i></a>
            </li>
            <li class="kt-sticky-toolbar__item kt-sticky-toolbar__item--danger" id="kt_sticky_toolbar_chat_toggler" data-toggle="kt-tooltip" title="Chat Example" data-placement="left">
                <a href="#" data-toggle="modal" data-target="#kt_chat_modal"><i class="flaticon2-chat-1"></i></a>
            </li>
        </ul>
        <!-- end::Sticky Toolbar -->
        
        <!-- begin::Demo Panel -->
        {{ include('_common/demo.html.twig') }}
        <!-- end::Demo Panel -->
        
        <!-- begin:: Chat -->
        {{ include('_common/chat.html.twig') }}
        <!--end:: Chat-->

        <!-- begin::Global Config(global config for global JS sciprts) -->
        <script>
            var KTAppOptions = {"colors":{"state":{"brand":"#22b9ff","light":"#ffffff","dark":"#282a3c","primary":"#5867dd","success":"#34bfa3","info":"#36a3f7","warning":"#ffb822","danger":"#fd3995"},"base":{"label":["#c5cbe3","#a1a8c3","#3d4465","#3e4466"],"shape":["#f0f3ff","#d9dffa","#afb4d4","#646c9a"]}}};
        </script>
        <!-- end::Global Config -->

        <!--begin::Global Theme Bundle(used by all pages) -->
        <script src="{{ asset('js/vendors.bundle.js') }}" type="text/javascript" ></script>
        <script src="{{ asset('js/scripts.bundle.js') }}" type="text/javascript" ></script>
        <!--end::Global Theme Bundle -->

        <!--begin::Page Scripts & Vendor Scripts(used by this page) -->
        {% block javascripts %}
        <script src="{{ asset('js/fullcalendar.bundle.js') }}" type="text/javascript" ></script>
        {% endblock %}
        <!--end::Page Scripts & Vendor Scripts -->
        <script>
            $('#page-body').on('change keyup keydown', 'input, textarea, select', function (e) {
                $(this).addClass('changed-input');
            });
            $(window).on('beforeunload', function () {
                if ($('.changed-input').length) {
                    /*
                    return swal.fire({
                        title: 'Are you sure?',
                        text: "You haven\'t saved your changes.",
                        type: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, quit this page!'
                    }).then(function(result) {
                        if (result.value) {
                            swal.fire(
                                'Deleted!',
                                'Your file has been deleted.',
                                'success'
                            )
                        }
                    });
                    */
                    return "You haven\'t saved your changes.";
                }
            });
            
            window.addEventListener("dragenter", function(e)
            {
                document.querySelector(".dropzone-container").style.visibility = "";
                document.querySelector(".dropzone-container").style.opacity = 1;
            });
            $('.btn-close').click(function(e){
                e.preventDefault();
                document.querySelector(".dropzone-container").style.visibility = "hidden";
                document.querySelector(".dropzone-container").style.opacity = 0;
            });
            $('.btn-upload').click(function(e){
                e.preventDefault();
                document.querySelector(".dropzone-container").style.visibility = "";
                document.querySelector(".dropzone-container").style.opacity = 1;
                $('.dropzone').trigger('click');
            });
            $('.dropzone').dropzone({
                url: "/upload/vich", // Set the url for your upload script location
                method: "POST",
                paramName: "upload[file]", // The name that will be used to transfer the file
                maxFiles: 10,
                maxFilesize: 10, // MB
                addRemoveLinks: true,
                acceptedFiles: "image/*,application/pdf,.psd",
                accept: function(file, done) {
                    if (file.name == "justinbieber.jpg") {
                        done("Naha, you don't.");
                    } else {
                        done();
                    }
                },
                init: function () {
                    this.on("maxfilesexceeded", function(file) {
                        this.removeFile(file);
                    });
                    this.on("sending", function(file, xhr, formData) {
                        // send additional data with the file as POST data if needed.
                        formData.append("upload[name]", "value");  
                    });
                    this.on("success", function(file, response) {
                        if (response.data){
                            var count = $('#file-list').data('count');
                            var name = $('#file-list').data('name');
                            $('#file-list').append('<input type="hidden" name="' + name + '[' + count + '][type]" value="image" >');
                            $('#file-list').append('<input type="hidden" name="' + name + '[' + count + '][file]" value="' + response.data.id + '" >');
                            $('#file-list').append(response.html);
                            $('#file-list').data('count', count + 1);
                            alert('File Uploaded: ' + response.data.name);
                        }
                        document.querySelector(".dropzone-container").style.visibility = "hidden";
                        document.querySelector(".dropzone-container").style.opacity = 0;
                        
                    });
                }
            });
        </script>
    </body>
</html>