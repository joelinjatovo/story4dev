{% extends 'base.html.twig' %}

{% block title %}{% trans %}activity{% endtrans %} - {% trans %}project{% endtrans %} #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}all.activities{% endtrans %}</h3>
            <div class="kt-subheader__breadcrumbs">
                <span class="kt-subheader__breadcrumbs-separator kt-hidden"></span>
                <a href="{{ path('project_list') }}" class="kt-subheader__breadcrumbs-link kt-hidden">{% trans %}projects{% endtrans %}</a>
                <span class="kt-subheader__breadcrumbs-separator kt-hidden"></span>
                <a href="{{ path('project_show', { slug: project.slug })}}" class="kt-subheader__breadcrumbs-link kt-hidden">{{ project.title }}</a>
                <span class="kt-subheader__breadcrumbs-separator kt-hidden"></span>
                <span class="kt-subheader__breadcrumbs-link kt-subheader__breadcrumbs-link--active kt-hidden">{% trans %}activities{% endtrans %}</span>
            </div>
        </div>        
        <div class="kt-subheader__toolbar">
            {% if is_granted('view', project) %}
                <a href="{{ path('activity_list_type', { slug: project.slug, type: 'list' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-list"></i> {% trans %}list{% endtrans %}</a>
                <a href="{{ path('activity_list_type', { slug: project.slug, type: 'grid' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-large"></i> {% trans %}grid{% endtrans %}</a>
                <span class="kt-subheader__separator kt-subheader__separator--v"></span>
                <a href="{{ path('project_show', { slug : project.slug } ) }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i>{% trans %}button.back{% endtrans %}</a>
            {% endif %}
            {% if is_granted('edit', project) %}
                <a href="{{ path('activity_index', { slug: project.slug }) }}" class="btn btn-label-brand btn-bold">{% trans %}button.add{% endtrans %}</a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
    {% for activity in activities %}
        <div class="col-xl-6">
            {{ include('activity/_grid-item.html.twig', {'activity': activity}) }}
        </div>
    {% endfor %}
</div>
    
<div class="row">
    <div class="col-xl-12">       
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <!--begin: Pagination-->
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': activities}) }}
                </div>
                <!--end: Pagination-->
            </div>
        </div>
    </div>           
</div>
{% endblock %}

{% block javascripts %}
<script type="text/javascript">
jQuery(document).ready(function($){
    $(document).on('click', '.btn-remove', function(e){
        e.preventDefault();
        var $this = $(this);
            swal.fire({
                title:"{% trans %}swal.remove.title{% endtrans %}",
                text:"{% trans %}swal.remove.content.activity{% endtrans %}",
                type:"warning",
                showCancelButton:!0,
                confirmButtonText:"{% trans %}button.confirm.delete2{% endtrans %}",
                cancelButtonText:"{% trans %}button.cancel{% endtrans %}"
            }).then(function(e){
                if(e.value){
                    KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
                    $.post("/activity/remove", { id: $this.attr('data-id') })
                    .done(function( data ) {
                        KTApp.unblockPage();
                        if(data.success){
                            $this.closest('.activity-item').remove();
                            toastr.success(data.message);
                        }else{
                            toastr.error(data.message, data.title);
                        }
                    })
                    .fail(function() {
                        KTApp.unblockPage();
                        toastr.error("{% trans %}swal.error{% endtrans %}");
                    });
                }
            })
    });
    $(document).on('click', '.btn-star', function(e){
        e.preventDefault();
        var $this = $(this);
        KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
        $.post("/activity/star", { id: $this.attr('data-id') })
        .done(function( data ) {
            KTApp.unblockPage();
            if(data.success){
                if(data.star){
                    $this.find('i').removeClass('la-star-o').addClass('la-star');
                    $this.attr('data-original-title', '{% trans %}button.unstar{% endtrans %}');
                    toastr.success(data.message);
                }else{
                    $this.find('i').removeClass('la-star').addClass('la-star-o');
                    $this.attr('data-original-title', '{% trans %}button.star{% endtrans %}');
                    toastr.warning(data.message);
                }
            }else{
                toastr.error(data.message, data.title);
            }
        })
        .fail(function() {
            KTApp.unblockPage();
            toastr.error("{% trans %}swal.error{% endtrans %}");
        });
    });
});
</script>
{% endblock %}
