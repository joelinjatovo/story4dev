{% extends 'base.html.twig' %}

{% block title %}Activités - Projet #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}all.activities{% endtrans %}</h3>
            {% if is_granted('create_activity', project) %}
                <a href="{{ path('activity_index', { slug: project.slug }) }}" class="btn btn-label-brand btn-bold">{% trans %}button.add{% endtrans %}</a>
            {% endif %}
        </div>        
        <div class="kt-subheader__toolbar">
            {% if is_granted('view', project) %}
                <a href="{{ path('activity_list_type', { slug: project.slug, type: 'list' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-list"></i> Liste</a>
                <a href="{{ path('activity_list_type', { slug: project.slug, type: 'grid' }) }}" class="btn btn-label-success btn-bold btn-sm btn-icon-h"><i class="la la-th-large"></i> Grille</a>
                <a href="{{ path('project_show', { slug : project.slug } ) }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i>Retour</a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
	<div class="col-xl-8 col-lg-12 order-lg-1 order-xl-1">
		<div class="kt-portlet kt-portlet--height-fluid kt-portlet--mobile ">
            <div class="kt-portlet__body kt-portlet__body--fit">
                <div class="kt-datatable kt-datatable--default kt-datatable--brand kt-datatable--loaded" >
                    <table class="kt-datatable__table" style="display: block;">
                        <thead class="kt-datatable__head">
                            <tr class="kt-datatable__row" style="left: 0px;">
                                <th data-field="Activités" data-autohide-disabled="false" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 222px;">Activités</span>
                                </th>
                                <th data-field="Avancements" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 222px;">Avancements</span>
                                </th>
                                <th data-field="Indicateurs" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 100px;">Indicateurs</span>
                                </th>
                                <th data-field="Rapports" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 100px;">Rapports</span>
                                </th>
                                <th data-field="Documents" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 100px;">Documents</span>
                                </th>
                                <th data-field="Actions" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 150px;">Actions</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="kt-datatable__body">
                            {% for activity in activities %}
                                {{ include('activity/_list-item.html.twig', {'activity': activity}) }}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
    
<div class="row">
    <div class="col-xl-12">       
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <!--begin: Pagination-->
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': activities}) }}
                </div>
                <!--end: Pagination-->
            </div>
        </div>
    </div>           
</div>
{% endblock %}

{% block javascripts %}
<script type="text/javascript">
jQuery(document).ready(function($){
    $(document).on('click', '.btn-remove', function(e){
        e.preventDefault();
        var $this = $(this);
            swal.fire({
                title:"Vous êtes sûre?",
                text:"Vous ne pourez pas revenir en arrière après!\nToutes les rapports ainsi que les données rattachées à cette activité vont être supprimés aussi.",
                type:"warning",
                showCancelButton:!0,
                confirmButtonText:"Oui, supprimez la!",
                cancelButtonText:"Annuler"
            }).then(function(e){
                if(e.value){
                    KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
                    $.post("/activity/remove", { id: $this.attr('data-id') })
                    .done(function( data ) {
                        KTApp.unblockPage();
                        if(data.success){
                            $this.closest('.activity-item').remove();
                            toastr.success(data.message);
                        }else{
                            toastr.error(data.message, data.title);
                        }
                    })
                    .fail(function() {
                        KTApp.unblockPage();
                        toastr.error("Une erreur s'est produite. Veuillez réesayer plus tard!");
                    });
                }
            })
    });
    $(document).on('click', '.btn-star', function(e){
        e.preventDefault();
        var $this = $(this);
        KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
        $.post("/activity/star", { id: $this.attr('data-id') })
        .done(function( data ) {
            KTApp.unblockPage();
            if(data.success){
                if(data.star){
                    $this.find('i').removeClass('la-star-o').addClass('la-star');
                    $this.attr('data-original-title', 'Supprimer des favoris');
                    toastr.success(data.message);
                }else{
                    $this.find('i').removeClass('la-star').addClass('la-star-o');
                    $this.attr('data-original-title', 'Ajouter aux favoris');
                    toastr.warning(data.message);
                }
            }else{
                toastr.error(data.message, data.title);
            }
        })
        .fail(function() {
            KTApp.unblockPage();
            toastr.error("Une erreur s'est produite. Veuillez réesayer plus tard!");
        });
    });
});
</script>
{% endblock %}