{% extends 'base.html.twig' %}

{% block title %}Activities - Project #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{{ project.title }}</h3>
            <div class="kt-subheader__group" id="kt_subheader_search">
                <span class="kt-subheader__desc" id="kt_subheader_total">450 Total</span>
            </div>
            <div class="kt-subheader__breadcrumbs">
                <a href="{{ path('admin_index') }}" class="kt-subheader__breadcrumbs-home"><i class="flaticon2-shelter"></i></a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ path('project_list', { 'slug' : project.author.slug, 'page' : 1 }) }}" class="kt-subheader__breadcrumbs-link">Projects</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <a href="{{ path('project_show', { 'slug' : project.author.slug, 'id': project.id })}}" class="kt-subheader__breadcrumbs-link">{{ project.title }}</a>
                <span class="kt-subheader__breadcrumbs-separator"></span>
                <span class="kt-subheader__breadcrumbs-link kt-subheader__breadcrumbs-link--active">Activities</span>
            </div>
        </div>        
        <div class="kt-subheader__toolbar">
            <a href="{{ path('project_show', { 'id' : project.id, 'slug': project.author.slug } ) }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i>Retour</a>
            <a href="{{ path('activity_create', { 'slug': project.author.slug, 'project_id': project.id }) }}" class="btn btn-label-brand btn-bold">Ajouter</a>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
    {% for activity in activities %}
        <div class="col-xl-6">
            {{ include('activity/list_item.html.twig', {'activity': activity}) }}
        </div>
    {% endfor %}
</div>
    
<div class="row">
    <div class="col-xl-12">       
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <!--begin: Pagination-->
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': activities}) }}
                </div>
                <!--end: Pagination-->
            </div>
        </div>
    </div>           
</div>
{% endblock %}


{% block javascripts %}
{% endblock %}
