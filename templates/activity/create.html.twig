{% extends 'base.html.twig' %}

{% block title %}{% trans %}new.activity{% endtrans %} - {% trans %}project{% endtrans %} #{{ project.id }} - {{ app.user.fullname }} {% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}new.activity{% endtrans %}</h3>
        </div>        
        <div class="kt-subheader__toolbar">
            <a href="{{ path('project_show', { slug : project.slug } ) }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i><span class="kt-hidden-mobile">{% trans %}button.back{% endtrans %}</span></a>
            <div class="btn-group">
                <button type="submit" form="activity" name="submit" value="save-default" class="btn btn-brand">
                    <i class="la la-check"></i> 
                    <span class="kt-hidden-mobile">{% trans %}button.save{% endtrans %}</span>
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
   	<div class="col-lg-12">	
		<!--begin::Portlet-->
		<div class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
			<div class="kt-portlet__body">
				{{ form_start( form, { 'method' : 'POST', 'attr' : { 'id' : 'activity', 'class' : 'kt-form' } } ) }}
					<div class="row">
						<div class="col-xl-2"></div>
						<div class="col-xl-8">
							<div class="kt-section kt-section--first">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">{% trans %}about{% endtrans %}:</h3>
									<div class="form-group row">
                    					{{ form_label( form.title, null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.title, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
									<div class="form-group row">
                    					{{ form_label( form.description, null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.description, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
								</div>
							</div>
                            <div class="kt-separator kt-separator--border-dashed kt-separator--space-lg kt-hidden"></div>
                            <div class="kt-section kt-hidden">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">{% trans %}form.label.contact{% endtrans %}:</h3>
                                    <div class="form-group row">
										{{ form_label( form.contactemail,  null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											<div class="input-group">
												<div class="input-group-prepend"><span class="input-group-text"><i class="la la-at"></i></span></div>
                                                {{ form_widget( form.contactemail, { 'attr' : { 'class' : 'form-control', 'aria-describedby':'basic-addon1' } } ) }}
											</div>
										</div>
									</div>
                                    <div class="form-group row">
										{{ form_label( form.contactphone, null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											<div class="input-group">
												<div class="input-group-prepend"><span class="input-group-text"><i class="la la-phone"></i></span></div>
                                                {{ form_widget( form.contactphone, { 'attr' : { 'class' : 'form-control', 'aria-describedby':'basic-addon1' } } ) }}
											</div>
										</div>
									</div>
                                    <div class="form-group row">
										{{ form_label( form.contactaddress, null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											<div class="input-group">
												<div class="input-group-prepend"><span class="input-group-text"><i class="la la-map"></i></span></div>
                                                {{ form_widget( form.contactaddress, { 'attr' : { 'class' : 'form-control', 'aria-describedby':'basic-addon1' } } ) }}
											</div>
										</div>
									</div>
								</div>
							</div>
                            <div class="kt-separator kt-separator--border-dashed kt-separator--space-lg"></div>
                            <div class="kt-section kt-section--last">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">{% trans %}button.attach.files{% endtrans %}:</h3>
                                    <button class="btn btn-label-success btn-bold btn-sm btn-upload">{% trans %}button.upload.file{% endtrans %}</button>
									<div class="kt-widget4" id="file-list" data-name="activity[activityFiles]" data-count="{{ activity.activityFiles.count }}">
                                        {% set i = 0 %}
                                        {% for activityFile in activity.activityFiles %}
											<div class="file-list-item">
												<input type="hidden" name="activity[activityFiles][{{i}}][type]" value="{{activityFile.type}}">
												<input type="hidden" name="activity[activityFiles][{{i}}][file]" value="{{activityFile.file.id}}">
												{% set i = i + 1 %}
												{{ include('upload/file.html.twig', {'file': activityFile.file}) }}
											</div>
                                        {% endfor %}
                                    </div>
								</div>
							</div>
						</div>
						<div class="col-xl-2"></div>
					</div>
                    <input type="hidden" name="activity[project]" value="{{ project.id }}" >
					{{ form_row( form._token ) }}
				{{ form_end( form, {'render_rest': false}) }}
			</div>
		</div>	
		<!--end::Portlet-->
	</div>
</div>
{% endblock %}

{% block javascripts %}
<script type="text/javascript" >
jQuery(document).ready(function($){
    $(document).on('click', '.btn-delete-file', function(e){
        e.preventDefault();
        var $this = $(this);
		$this.closest('.file-list-item').remove();
    });
});
</script>
{% endblock %}
