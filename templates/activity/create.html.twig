{% extends 'base.html.twig' %}

{% block stylesheets %}
<link href="{{ asset('css/wizard-4.css') }}" rel="stylesheet" type="text/css"/>
{% endblock %}

{% block subheader %}
<br>
{% endblock %}

{% block content %}
<div class="row">
   	<div class="col-lg-12">	
		<!--begin::Portlet-->
		<div class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
			<div class="kt-portlet__head kt-portlet__head--lg" style="">
				<div class="kt-portlet__head-label">
					<h3 class="kt-portlet__head-title">New Activity <small>enter activity detail and save change</small></h3>
				</div>
				<div class="kt-portlet__head-toolbar">
					<a href="#" class="btn btn-clean kt-margin-r-10">
						<i class="la la-arrow-left"></i>
						<span class="kt-hidden-mobile">Back</span>
					</a>
					<div class="btn-group">
						<button type="submit" form="activity" class="btn btn-brand">
							<i class="la la-check"></i> 
							<span class="kt-hidden-mobile">Save</span>
						</button>
						<button type="button" class="btn btn-brand dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
						</button>
						<div class="dropdown-menu dropdown-menu-right">
							<ul class="kt-nav">
								<li class="kt-nav__item">
									<a href="https://keenthemes.com/metronic/preview/demo7/crud/forms/layouts/sticky-action-bar.html#" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-reload"></i>
										<span class="kt-nav__link-text">Save &amp; continue</span>
									</a>
								</li>
								<li class="kt-nav__item">
									<a href="https://keenthemes.com/metronic/preview/demo7/crud/forms/layouts/sticky-action-bar.html#" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-power"></i>
										<span class="kt-nav__link-text">Save &amp; exit</span>
									</a>
								</li>
								<li class="kt-nav__item">
									<a href="https://keenthemes.com/metronic/preview/demo7/crud/forms/layouts/sticky-action-bar.html#" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-edit-interface-symbol-of-pencil-tool"></i>
										<span class="kt-nav__link-text">Save &amp; edit</span>
									</a>
								</li>
								<li class="kt-nav__item">
									<a href="https://keenthemes.com/metronic/preview/demo7/crud/forms/layouts/sticky-action-bar.html#" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-add-1"></i>
										<span class="kt-nav__link-text">Save &amp; add new</span>
									</a>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="kt-portlet__body">
				{{ form_start( form, { 'method' : 'POST', 'attr' : { 'id' : 'activity', 'class' : 'kt-form' } } ) }}
					<div class="row">
						<div class="col-xl-2"></div>
						<div class="col-xl-8">
							<div class="kt-section kt-section--first">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Activity Info:</h3>
									<div class="form-group row">
                    					{{ form_label( form.title, null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.title, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
									<div class="form-group row">
                    					{{ form_label( form.budget, null, { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.budget, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-xl-2"></div>
					</div>
					<input type="hidden" name="activity[project]" value="{{ project.id }}" >
					{{ form_row( form._token ) }}
				{{ form_end( form, {'render_rest': false}) }}
			</div>
		</div>	
		<!--end::Portlet-->
	</div>
</div>
{% endblock %}


{% block javascripts %}
    <script src="{{ asset('js/add-user.js') }}" type="text/javascript" ></script>
{% endblock %}
