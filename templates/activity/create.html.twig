									<div class="kt-notification-v2" id="file-list" data-name="activity[activityFiles]" data-count="{{ activity.activityFiles.count }}">
                                        {% set i = 0 %}
                                        {% for activityFile in activity.activityFiles %}
                                            <input type="hidden" name="activity[activityFiles][{{i}}][type]" value="{{activityFile.type}}">
                                            <input type="hidden" name="activity[activityFiles][{{i}}][file]" value="{{activityFile.file.id}}">
                                            {% set i = i + 1 %}
