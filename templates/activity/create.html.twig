{% extends 'base.html.twig' %}

{% block title %}Nouvelle activité - Projet #{{ project.id }}- {{ app.user.fullname }} {% endblock %}

{% block stylesheets %}
<link href="{{ asset('css/wizard-4.css') }}" rel="stylesheet" type="text/css"/>
{% endblock %}

{% block subheader %}
<br>
{% endblock %}

{% block content %}
<div class="row">
   	<div class="col-lg-12">	
		<!--begin::Portlet-->
		<div class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
			<div class="kt-portlet__head kt-portlet__head--lg" style="">
				<div class="kt-portlet__head-label">
                    {% block headtitle %}
					   <h3 class="kt-portlet__head-title">Nouvelle activité <small>entrer les détails de l'activité puis enregistrer</small></h3>
                    {% endblock %}
				</div>
				<div class="kt-portlet__head-toolbar">
                    {% if activity is defined and activity is not null and (activity.id>0) %}
					   <a href="{{ url('activity_show', { 'slug' : activity.project.author.slug, 'project_id' : activity.project.id, 'activity_id' : activity.id }) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">Retour</span></a>
                    {% else %}
                        <a href="{{ path('project_show', { 'id' : project.id, 'slug': project.author.slug } ) }}" class="btn btn-clean kt-margin-r-10"><i class="la la-long-arrow-left"></i><span class="kt-hidden-mobile">Retour</span></a>
                    {% endif %}
					<div class="btn-group">
						<button type="submit" form="activity" name="submit" value="save-default" class="btn btn-brand">
							<i class="la la-check"></i> 
							<span class="kt-hidden-mobile">Enregister</span>
						</button>
						<button type="button" class="btn btn-brand dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
						</button>
						<div class="dropdown-menu dropdown-menu-right">
							<ul class="kt-nav">
								<li class="kt-nav__item">
									<button type="submit" form="activity" name="submit" value="save-continue" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-reload"></i>
										<span class="kt-nav__link-text">Enregister &amp; Continuer</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="activity" name="submit" value="save-edit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-edit"></i>
										<span class="kt-nav__link-text">Enregister &amp; Modifier</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="activity" name="submit" value="save-create" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-add-1"></i>
										<span class="kt-nav__link-text">Enregister &amp; Ajouter</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="activity" name="submit" value="save-exit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon-close"></i>
										<span class="kt-nav__link-text">Enregister &amp; Quitter</span>
									</button>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="kt-portlet__body">
				{{ form_start( form, { 'method' : 'POST', 'attr' : { 'id' : 'activity', 'class' : 'kt-form' } } ) }}
					<div class="row">
						<div class="col-xl-2"></div>
						<div class="col-xl-8">
							<div class="kt-section kt-section--first">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">A propos:</h3>
									<div class="form-group row">
                    					{{ form_label( form.title, "Nom de l'activité", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.title, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
									<div class="form-group row">
                    					{{ form_label( form.description, 'Description de l\'activité', { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.description, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
								</div>
							</div>
                            <div class="kt-separator kt-separator--border-dashed kt-separator--space-lg kt-hidden"></div>
                            <div class="kt-section kt-hidden">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Détails du contact:</h3>
                                    <div class="form-group row">
										{{ form_label( form.contactemail,  "Email du contact", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											<div class="input-group">
												<div class="input-group-prepend"><span class="input-group-text"><i class="la la-at"></i></span></div>
                                                {{ form_widget( form.contactemail, { 'attr' : { 'class' : 'form-control', 'aria-describedby':'basic-addon1' } } ) }}
											</div>
										</div>
									</div>
                                    <div class="form-group row">
										{{ form_label( form.contactphone,  "Téléphone du contact", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											<div class="input-group">
												<div class="input-group-prepend"><span class="input-group-text"><i class="la la-phone"></i></span></div>
                                                {{ form_widget( form.contactphone, { 'attr' : { 'class' : 'form-control', 'aria-describedby':'basic-addon1' } } ) }}
											</div>
										</div>
									</div>
                                    <div class="form-group row">
										{{ form_label( form.contactaddress,  "Adresse du contact", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											<div class="input-group">
												<div class="input-group-prepend"><span class="input-group-text"><i class="la la-map"></i></span></div>
                                                {{ form_widget( form.contactaddress, { 'attr' : { 'class' : 'form-control', 'aria-describedby':'basic-addon1' } } ) }}
											</div>
										</div>
									</div>
								</div>
							</div>
                            <div class="kt-separator kt-separator--border-dashed kt-separator--space-lg"></div>
                            <div class="kt-section kt-section--last">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Attacher des fichiers:</h3>
                                    <button class="btn btn-label-success btn-bold btn-sm btn-upload">Téléverser un fichier</button>
									<div class="kt-widget4" id="file-list" data-name="activity[activityFiles]" data-count="{{ activity.activityFiles.count }}">
                                        {% set i = 0 %}
                                        {% for activityFile in activity.activityFiles %}
											<div class="file-list-item">
												<input type="hidden" name="activity[activityFiles][{{i}}][type]" value="{{activityFile.type}}">
												<input type="hidden" name="activity[activityFiles][{{i}}][file]" value="{{activityFile.file.id}}">
												{% set i = i + 1 %}
												{{ include('upload/file.html.twig', {'file': activityFile.file}) }}
											</div>
                                        {% endfor %}
                                    </div>
								</div>
							</div>
						</div>
						<div class="col-xl-2"></div>
					</div>
					<input type="hidden" name="activity[project]" value="{{ project.id }}" >
					{{ form_row( form._token ) }}
				{{ form_end( form, {'render_rest': false}) }}
			</div>
		</div>	
		<!--end::Portlet-->
	</div>
</div>
{% endblock %}

{% block javascripts %}
<script type="text/javascript" >
jQuery(document).ready(function($){
    $(document).on('click', '.btn-delete-file', function(e){
        e.preventDefault();
        var $this = $(this);
		$this.closest('.file-list-item').remove();
    });
});
</script>
{% endblock %}
