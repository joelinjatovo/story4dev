<tr data-row="0" class="kt-datatable__row activity-item" style="left: 0px;">
    <td data-field="User" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="width: 222px;">
            <div class="kt-user-card-v2">
                <div class="kt-user-card-v2__details">
                    <a class="kt-user-card-v2__name" href="{{ path('activity_show', { 'project_id': activity.project.id, 'activity_id': activity.id }) }}">{{ activity.title }}</a>
                    <span class="kt-user-card-v2__email">{{ activity.description|excerpt(50) }}</span>
                </div>
            </div>
        </span>
    </td>
    <td data-field="Avancement" class="kt-datatable__cell">
        <span style="width: 222px;">
            <div class="kt-widget__item">
                <div class="kt-widget__progress-" style="width: 90%;">
                    <div class="progress" style="height: 5px;width: 100%;">
                        <div class="progress-bar kt-bg-success" role="progressbar" style="width: {{ activity.progression }}%;" aria-valuenow="{{ activity.progression }}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="kt-widget__stats">
                        {{ activity.progression }}%
                    </div>
                </div>
            </div>
        </span>
    </td>
    <td data-field="Indicateurs" class="kt-datatable__cell">
        <a href="{{ path('indicator_list', { 'activity_id' : activity.id, 'project_id' : activity.project.id} ) }}" style="width: 100px;"><span class="kt-font-bold">{{ activity.indicators.count }} </span>Indicateurs</a>
    </td>
    <td data-field="Rapports" class="kt-datatable__cell">
        <a style="width: 100px;" href="{{ path('report_list2', { 'activity_id' : activity.id, 'project_id' : activity.project.id} ) }}"><span class="kt-font-bold">{{ activity.reports.count }} </span>Rapports</a>
    </td>
    <td data-field="Documents" class="kt-datatable__cell">
        <a style="width: 100px;" href="{{ path('file_list_activity', { 'activity_id' : activity.id, 'project_id' : activity.project.id } ) }}"><span class="kt-font-bold">{{ activity.activityFiles.count }} </span>Documents</a>
    </td>
    <td data-field="Actions" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="overflow: visible; position: relative; width: 150px;">
            {% if is_granted('edit', activity) %}
                <a href="{{ path('activity_edit', { 'project_id': activity.project.id, 'activity_id': activity.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                    <i class="la la-edit"></i>
                </a>
            {% endif %}
            {% if is_granted('view', activity) %}
                <a href="{{ path('activity_show', { 'project_id': activity.project.id, 'activity_id': activity.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                    <i class="la la-eye"></i>
                </a>
            {% endif %}
            {% if is_granted('remove', activity) %}
                <a title="Supprimer cette activité" data-id="{{ activity.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-remove">
                    <i class="la la-trash"></i>
                </a>
            {% endif %}
        </span>
    </td>
</tr>