<div class="kt-widget4__item">
    <div class="kt-widget4__pic kt-widget4__pic--icon">
        {% if activityFile.file.image %}
            <img src="{{ asset( activityFile.file.icone ) | imagine_filter('thumb') }}" alt="icone">  
        {% else %}
            <img src="{{ asset( activityFile.file.icone ) }}" alt="icone"> 
        {% endif %}
    </div>
    {% if activityFile.file.image %}
        <a href="{{ asset( activityFile.file.icone) | imagine_filter('big') }}" data-toggle="lightbox" data-gallery="gallery" class="kt-widget4__title">
            {{ activityFile.file.name }}
        </a>
    {% else %}
        <a href="{{ path( 'file_download', {id: activityFile.file.id }) }}" target="_blank" class="kt-widget4__title">
            {{ activityFile.file.name }}
        </a>
    {% endif %}
    <div class="kt-widget4__tools">
        <a href="{{ path( 'file_download', {id: activityFile.file.id }) }}" target="_blank" class="btn btn-clean btn-icon btn-sm">
            <i class="flaticon2-download"></i>
        </a>
    </div>			
</div>