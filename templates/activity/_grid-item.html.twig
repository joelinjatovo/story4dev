<div class="kt-portlet activity-item">
    <div class="kt-portlet__body">
        <div class="kt-widget kt-widget--user-profile-3">
            <div class="kt-widget__top">
                <div class="kt-widget__content" style="padding-left:0px;">
                    <div class="kt-widget__head">
                        <a href="{{ path('activity_show', { 'slug': activity.project.slug, 'activity_id': activity.id }) }}" class="kt-widget__username">
                            {{ activity.title }}                 
                        </a>                         
                        <div class="kt-widget__action">
                            <div class="kt-portlet__head-toolbar">
                                {% if is_granted('star', activity) %}
                                    <a data-id="{{ activity.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-star" data-toggle="kt-tooltip" data-placement="top" data-original-title="{{ activity|favorite(app.user) ? 'Supprimer des favoris' : 'Ajouter aux favoris' }}">
                                        <i class="la {{ activity|favorite(app.user) ? 'la-star' : 'la-star-o' }}"></i>
                                    </a>
                                {% endif %}
                                <a href="#" class="btn btn-clean btn-sm btn-icon btn-icon-md" data-toggle="dropdown">
                                    <i class="flaticon-more-1"></i>
                                </a>
                                <div class="dropdown-menu dropdown-menu-fit dropdown-menu-right">
                                    <ul class="kt-nav">
                                        {% if is_granted('view', activity) %}
                                            <li class="kt-nav__item">
                                                <a href="{{ path('activity_show', { slug: activity.project.slug, activity_id: activity.id }) }}" class="kt-nav__link">
                                                    <i class="kt-nav__link-icon flaticon2-line-chart"></i>
                                                    <span class="kt-nav__link-text">{% trans %}button.details{% endtrans %}</span>
                                                </a>
                                            </li>
                                        {% endif %}
                                        {% if is_granted('edit', activity) %}
                                            <li class="kt-nav__item">
                                                <a href="{{ path('activity_edit', { activity_id: activity.id, slug: activity.project.slug } ) }}" class="kt-nav__link">
                                                    <i class="kt-nav__link-icon flaticon2-settings"></i>
                                                    <span class="kt-nav__link-text">{% trans %}button.edit{% endtrans %}</span>
                                                </a>
                                            </li>
                                        {% endif %}
                                        {% if is_granted('create_indicator', activity) %}
                                            <li class="kt-nav__item">
                                                <a href="{{ path('indicator_index', { activity: activity.id, slug: activity.project.slug } ) }}" class="kt-nav__link">
                                                    <i class="kt-nav__link-icon flaticon2-pie-chart-1"></i>
                                                    <span class="kt-nav__link-text">{% trans %}button.create.indicator{% endtrans %}</span>
                                                </a>
                                            </li>
                                        {% endif %}
                                        {% if is_granted('view', activity) %}
                                            <li class="kt-nav__item">
                                                <a href="{{ path('report_index', { activity: activity.id, slug: project.slug} ) }}" class="kt-nav__link">
                                                    <i class="kt-nav__link-icon flaticon2-avatar"></i>
                                                    <span class="kt-nav__link-text">{% trans %}button.create.report{% endtrans %}</span>
                                                </a>
                                            </li>
                                        {% endif %}
                                        {% if is_granted('remove', activity) %}
                                            <li class="kt-nav__item">
                                                <a data-id="{{ activity.id }}" href="#" class="kt-nav__link btn-remove">
                                                    <i class="kt-nav__link-icon flaticon-delete"></i>
                                                    <span class="kt-nav__link-text">{% trans %}button.delete{% endtrans %}</span>
                                                </a>
                                            </li>
                                        {% endif %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% if activity.contactEmail or activity.contactPhone or activity.contactAddress %}
                        <div class="kt-widget__subhead kt-hidden">
                            {% if activity.contactEmail %}<a href="#"><i class="flaticon2-new-email"></i>{{ activity.contactEmail }}</a>{% endif %}
                            {% if activity.contactPhone %}<a href="#"><i class="flaticon2-calendar-3"></i>{{ activity.contactPhone }} </a>{% endif %}
                            {% if activity.contactAddress %}<a href="#"><i class="flaticon2-placeholder"></i>{{ activity.contactAddress }}</a>{% endif %}
                        </div>
                    {% endif  %}
                </div>    
            </div>

            {% if activity.description is not empty %}
                <div class="kt-widget__body kt-portlet__body--fit">
                    <span class="kt-widget__text">
                        {{ activity.description|excerpt }}                       
                    </span>
                </div>
            {% endif  %}

            <div class="kt-widget__bottom">
                <div class="kt-widget__item">
                    <div class="kt-widget__progress-" style="width: 90%;">
                        <div class="kt-widget__text">
                            {% trans %}progression{% endtrans %}
                        </div>
                        <div class="progress" style="height: 5px;width: 100%;">
                            <div class="progress-bar kt-bg-{{ activity|progressionClass }}" role="progressbar" style="width: {{ activity|progression }}%;" aria-valuenow="{{ activity|progression }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="kt-widget__stats">
                            {{ activity|progression }}%
                        </div>
                    </div>
                </div>

                {% if activity.budget > 0 %}
                    <div class="kt-widget__item">
                        <div class="kt-widget__icon">
                            <i class="flaticon-piggy-bank"></i>
                        </div>
                        <div class="kt-widget__details">
                            <span class="kt-widget__title">{% trans %}budget{% endtrans %}</span>
                            <span class="kt-widget__value">{{ activity.budget }}</span>
                        </div>
                    </div>
                {% endif  %}

                <div class="kt-widget__item">
                    <div class="kt-widget__icon">
                        <i class="flaticon-file-2"></i>
                    </div>
                    <div class="kt-widget__details">
                        <span class="kt-widget__title">{% transchoice activity.reports.count %}choice.report{% endtranschoice %}</span>
                        <a href="{{ path('report_list', { activity: activity.id, slug : project.slug} ) }}" class="kt-widget__value kt-font-brand">{% trans %}button.list{% endtrans %}</a>
                    </div>
                </div>

                <div class="kt-widget__item">
                    <div class="kt-widget__icon">
                        <i class="flaticon-confetti"></i>
                    </div>
                    <div class="kt-widget__details">
                        <span class="kt-widget__title">{% transchoice activity.indicators.count %}choice.indicator{% endtranschoice %}</span>
                        <a href="{{ path('indicator_list', { activity : activity.id, slug : project.slug} ) }}" class="kt-widget__value kt-font-brand">{% trans %}button.list{% endtrans %}</a>
                    </div>
                </div>

                <div class="kt-widget__item">
                    <div class="kt-widget__icon">
                        <i class="flaticon-attachment"></i>
                    </div>
                    <div class="kt-widget__details">
                        <div class="kt-section__content kt-section__content--solid">
                            <div class="kt-media-group">
                                {% for activityFile in activity.activityFiles %}
                                    {% if activityFile.file %}
                                        {% if activityFile.file.image %}
                                            <a href="#" class="kt-media kt-media--sm kt-media--circle" data-toggle="kt-tooltip" data-skin="brand" data-placement="top" title="" data-original-title="{% trans %}attachment{% endtrans %}">
                                                <img src="{{ asset( activityFile.file.icone ) }}" alt="{% trans %}image{% endtrans %}">
                                            </a>
                                        {% else %}
                                            <a href="{{ path( 'file_download', {id:activityFile.file.id}) }}" target="_blank" class="kt-media kt-media--sm kt-media--circle" data-toggle="kt-tooltip" data-skin="brand" data-placement="top" title="" data-original-title="{% trans %}button.click.to.download{% endtrans %}">
                                                <img src="{{ asset( activityFile.file.icone ) }}" alt="{% trans %}image{% endtrans %}">
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                {% else %}
                                    {% trans %}no.file.activity{% endtrans %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>