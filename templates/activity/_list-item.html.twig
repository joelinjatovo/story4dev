<tr data-row="0" class="kt-datatable__row activity-item" style="left: 0px;">
    <td data-field="{% trans %}user{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="width: 222px;">
            <div class="kt-user-card-v2">
                <div class="kt-user-card-v2__details">
                    <a class="kt-user-card-v2__name" href="{{ path('activity_show', { 'slug': activity.project.slug, 'activity_id': activity.id }) }}">{{ activity.title }}</a>
                    <span class="kt-user-card-v2__email">{{ activity.description|excerpt(50) }}</span>
                </div>
            </div>
        </span>
    </td>
    <td data-field="{% trans %}progression{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 222px;">
            <div class="kt-widget__item">
                <div class="kt-widget__progress-" style="width: 90%;">
                    <div class="progress" style="height: 5px;width: 100%;">
                        <div class="progress-bar kt-bg-{{ activity|progressionClass }}" role="progressbar" style="width: {{ activity|progression }}%;" aria-valuenow="{{ activity|progression }}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="kt-widget__stats">
                        {{ activity|progression }}%
                    </div>
                </div>
            </div>
        </span>
    </td>
    <td data-field="{% trans %}indicators{% endtrans %}" class="kt-datatable__cell">
        <a href="{{ path('indicator_list', { 'activity_id' : activity.id, 'slug' : activity.project.slug} ) }}" style="width: 100px;" data-toggle="kt-tooltip" data-placement="top" data-original-title="{% trans %}count.indicator.activity{% endtrans %}"><span class="kt-font-bold">{{ activity.indicators.count }} </span>{% trans %}indicators{% endtrans %}</a>
    </td>
    <td data-field="{% trans %}reports{% endtrans %}" class="kt-datatable__cell">
        <a style="width: 100px;" href="{{ path('report_list2', { 'activity_id' : activity.id, 'slug' : activity.project.slug} ) }}" data-toggle="kt-tooltip" data-placement="top" data-original-title="{% trans %}count.report.activity{% endtrans %}"><span class="kt-font-bold">{{ activity.reports.count }} </span>{% trans %}reports{% endtrans %}</a>
    </td>
    <td data-field="{% trans %}documents{% endtrans %}" class="kt-datatable__cell">
        <a style="width: 100px;" href="{{ path('file_list_activity', { 'activity_id' : activity.id, 'slug' : activity.project.slug } ) }}" data-toggle="kt-tooltip" data-placement="top" data-original-title="{% trans %}count.document.activity{% endtrans %}"><span class="kt-font-bold">{{ activity.activityFiles.count }} </span>{% trans %}documents{% endtrans %}</a>
    </td>
    <td data-field="{% trans %}actions{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="overflow: visible; position: relative; width: 150px;">
            {% if is_granted('star', activity) %}
                <a data-id="{{ activity.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-star" data-toggle="kt-tooltip" data-placement="top" data-original-title="{{ activity|favorite(app.user) ? 'button.unstar'|trans : 'button.star'|trans }}">
                    <i class="la {{ activity|favorite(app.user) ? 'la-star' : 'la-star-o' }}"></i>
                </a>
            {% endif %}
            {% if is_granted('edit', activity) %}
                <a href="{{ path('activity_edit', { 'slug': activity.project.slug, 'activity_id': activity.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md" data-toggle="kt-tooltip" data-placement="top" data-original-title="{% trans %}button.edit{% endtrans %}">
                    <i class="la la-edit"></i>
                </a>
            {% endif %}
            {% if is_granted('view', activity) %}
                <a href="{{ path('activity_show', { 'slug': activity.project.slug, 'activity_id': activity.id }) }}" class="btn btn-sm btn-clean btn-icon btn-icon-md" data-toggle="kt-tooltip" data-placement="top" data-original-title="{% trans %}button.view.more.detail{% endtrans %}">
                    <i class="la la-eye"></i>
                </a>
            {% endif %}
            {% if is_granted('remove', activity) %}
                <a title="{% trans %}button.delete.activity{% endtrans %}" data-id="{{ activity.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-remove" data-toggle="kt-tooltip" data-placement="top" data-original-title="{% trans %}button.delete{% endtrans %}">
                    <i class="la la-trash"></i>
                </a>
            {% endif %}
        </span>
    </td>
</tr>