    <div class="col-lg-6">
        <!--begin:: Widgets/Notifications-->
        <div class="kt-portlet kt-portlet--height-fluid" id="documents">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label"><a href="{{ path('file_list_activity', { activity_id : activity.id, slug : activity.project.slug } ) }}" >
                        <h3 class="kt-portlet__head-title">{% trans %}documents{% endtrans %}</h3>
                    </a>
                </div>
                <div class="kt-portlet__head-toolbar">
                    <a href="{{ path('file_list_activity', { activity_id : activity.id, slug : activity.project.slug } ) }}" class="btn btn-label-brand btn-bold btn-sm">
                        {% trans %}button.all1{% endtrans %}
                    </a>
                </div>
            </div>
            <div class="kt-portlet__body">
                <div class="kt-widget4" id="kt-activity-list">
					{% for document in documents %}
						{{ include('activity/_document.html.twig', { 'document' : document } ) }}
					{% else %}
                        {% trans %}no.document.activity{% endtrans %}
					{% endfor %}
                </div>
            </div>
        </div>
        <!--end:: Widgets/Notifications-->
    </div>
</div>
    
<div class="row">
    <div class="col-lg-12">
        <div class="kt-portlet kt-portlet--height-fluid">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label">
                    <h3 class="kt-portlet__head-title">{% trans %}photos{% endtrans %}</h3>
                </div>
            </div>
            <div class="kt-portlet__body">
                <div class="kt-widget4" id="gallery" style="display:none;">
                    {% for file in images %}
                        {% if file.image %}
				            {{ include('activity/_image.html.twig', { 'file' : file } ) }}
                        {% endif %}
                    {% else %}
                        {% trans %}no.file.activity{% endtrans %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/gallery.min.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/gallery-theme-tiles.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/admin/activity-show.js') }}" type="text/javascript" ></script>
<script type="text/javascript"> 
    jQuery(document).ready(function(){
        if( jQuery("#gallery") != undefined ) jQuery("#gallery").unitegallery(); 
    }); 
</script>

<!-- Resources -->
<script src="{{ asset('js/am4chart/core.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/am4chart/charts.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/am4chart/animated.js') }}" type="text/javascript" ></script>

<!-- Chart code -->
<script>
var KTAppMessages = {"waiting": "Veuillez patientez s'il vous plaît..."};
am4core.ready(function() {
    
    function drawIndicatorSerie(chart, value, yAxis){
        var serie = chart.series.push(new am4charts.ColumnSeries());
        serie.dataFields.valueY = value.id;
        serie.dataFields.categoryX = "iteration";
        serie.name = value.title;
        serie.unit = value.unit;
        serie.strokeWidth = 2;
        serie.yAxis = yAxis;
        serie.tooltipText = "{name}\n[bold font-size: 20]{valueY}[/] {unit}";
        serie.hiddenInLegend = true; 
        
        return serie;
    }

    // Themes begin
    am4core.useTheme(am4themes_animated);
    // Themes end

    // Create chart instance
    var chart = am4core.create("chartdiv", am4charts.XYChart);

    chart.data = {{ chart.data|json|raw }};

    // Create axes
    var categoryAxis = chart.xAxes.push(new am4charts.CategoryAxis());
    categoryAxis.dataFields.category = "iteration";
    
    var valueAxis1 = chart.yAxes.push(new am4charts.ValueAxis());
    valueAxis1.title.text = "Valeur par unité";
    
    var valueAxis2 = chart.yAxes.push(new am4charts.ValueAxis());
    valueAxis2.title.text = "Progression";
    valueAxis2.renderer.opposite = true;
    valueAxis2.renderer.grid.template.disabled = true;

    // Create series
    var series4 = chart.series.push(new am4charts.LineSeries());
        series4.dataFields.valueY = "value";
        series4.dataFields.categoryX = "iteration";
        series4.yAxis = valueAxis1;
        series4.name = "Evolution";
        series4.tooltipText = "{name}\n[bold font-size: 20]{valueY}[/] unités";
        series4.fill = chart.colors.getIndex(0).lighten(0.5);
        series4.strokeWidth = 2;

        var bullet4 = series4.bullets.push(new am4charts.CircleBullet());
            bullet4.circle.radius = 3;
            bullet4.circle.strokeWidth = 2;
            bullet4.circle.fill = am4core.color("#fff");
    
    var series3 = chart.series.push(new am4charts.LineSeries());
        series3.dataFields.valueY = "progression";
        series3.dataFields.categoryX = "iteration";
        series3.name = "Progression";
        series3.strokeWidth = 2;
        series3.tensionX = 0.7;
        series3.yAxis = valueAxis2;
        series3.tooltipText = "{name}\n[bold font-size: 20]{valueY}%[/]";
        series3.hidden = true;

        var bullet3 = series3.bullets.push(new am4charts.CircleBullet());
            bullet3.circle.radius = 3;
            bullet3.circle.strokeWidth = 2;
            bullet3.circle.fill = am4core.color("#fff");

    var ajaxRequest;
    
    var dataSeries = {{ chart.series|json|raw }};
    var indicatorSeries = [];
    jQuery.each(dataSeries, function(index, value) {
        indicatorSeries[index] = drawIndicatorSerie(chart, value, valueAxis1);
    });
    
    // Add cursor
    chart.cursor = new am4charts.XYCursor();

    // Add legend
    chart.legend = new am4charts.Legend();
    chart.legend.position = "top";
    
    // Selector
    jQuery("#select_indicator").select2({placeholder:"Séléctionnez un indicateur"});
    jQuery('#select_indicator').on('change', function (evt) {
      if (jQuery('#select_indicator').select2('val') != null){
            var container = jQuery("#statistic");
            var $datas = jQuery('#select_indicator').select2('data');
            var ids = [];
            jQuery.each($datas, function(index, $data) {
                ids.push(parseInt($data.id));
            });
            
            KTApp.block(container,{overlayColor:"#000000",type:"v2",state:"primary",message: KTAppMessages.waiting});
            
            if (typeof ajaxRequest !== 'undefined'){
                ajaxRequest.abort();
            }
      
            ajaxRequest = jQuery.get({
                url:"{{ path('activity_show', {slug:project.slug, activity_id: activity.id}) }}",
                data: {'indicators': ids},
                error:function(d){
                    KTApp.unblock(container);
                },
                success:function(t,s,r,a){
                    KTApp.unblock(container);
                    if(t.success===true){
                        // update URL
                        window.history.pushState(null, null, t.url);
                        
                        // remove old series
                        jQuery.each(indicatorSeries, function(index, serie) {
                            chart.series.removeIndex(
                              chart.series.indexOf(serie)
                            );
                        });
                        
                        // Update chart data
                        chart.data = t.chart.data;
                        
                        // draw new indicator series
                        indicatorSeries = [];
                        jQuery.each(t.chart.series, function(index, value) {
                            indicatorSeries[index] = drawIndicatorSerie(chart, value, valueAxis1);
                        });
                        
                        chart.invalidateData();
                    }
                }
            });
        }
    });

    jQuery('#chart-selector .kt-nav__item').on('click', function(e) {
        var format = jQuery(this).data('click');
        chart.exporting.export(format.toLowerCase());
    });

}); // end am4core.ready()
    
</script>
<script type="text/javascript">
jQuery(document).ready(function($){
});
</script>
{% endblock %}
