{% extends 'base.html.twig' %}

{% block title %}{% trans %}activity{% endtrans %} #{{ activity.id }} - {% trans %}project{% endtrans %} #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
<link href="{{ asset('css/gallery.css') }}" rel="stylesheet" type="text/css"/>
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}activity.detail{% endtrans %}</h3>
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__breadcrumbs">
                <a href="{{ path('project_list') }}" class="kt-subheader__breadcrumbs-link kt-hidden">{% trans %}projects{% endtrans %}</a>
                <span class="kt-subheader__breadcrumbs-separator kt-hidden"></span>
                <a href="{{ path('project_show', { slug: activity.project.slug })}}" class="kt-subheader__breadcrumbs-link kt-hidden">{{ activity.project.title }}</a>
                <span class="kt-subheader__breadcrumbs-separator kt-hidden"></span>
                <span class="kt-subheader__breadcrumbs-link kt-subheader__breadcrumbs-link--active">{{ activity.title }}</span>
            </div>
        </div>
        <div class="kt-subheader__toolbar">
            <div class="kt-subheader__wrapper">
                {% if is_granted('view', project) %}
                    <a href="{{ path('project_show', { slug : project.slug } ) }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i>{% trans %}button.back{% endtrans %}</a>
                {% endif %}
                {% if is_granted('edit', activity) %}
                    <a href="{{ path('activity_edit', { 'activity_id' : activity.id, 'slug' : activity.project.slug } ) }}" class="btn kt-subheader__btn-primary">{% trans %}button.edit{% endtrans %} &nbsp;</a>
                {% endif %}
                
                <div class="dropdown dropdown-inline" data-toggle="kt-tooltip" title="" data-placement="left" data-original-title="Actions">
                    <a href="#" class="btn btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                                <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                                <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                            </g>
                        </svg>
                        <!--<i class="flaticon2-plus"></i>-->
                    </a>
                    <div class="dropdown-menu dropdown-menu-fit dropdown-menu-md dropdown-menu-right">
                        <!--begin::Nav-->
                        <ul class="kt-nav">
                            <li class="kt-nav__head">
                                {% trans %}button.new{% endtrans %}
                                <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                            </li>
                            <li class="kt-nav__separator"></li>
                            {% if is_granted('create_activity', activity.project) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('activity_index', { 'slug' : activity.project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon-map"></i>
                                        <span class="kt-nav__link-text">{% trans %}activity{% endtrans %}</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('create_indicator', activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('indicator_index', { 'activity_id' : activity.id, 'slug' : activity.project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-drop"></i>
                                        <span class="kt-nav__link-text">{% trans %}indicator{% endtrans %}</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('view', activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_index', { 'activity_id' : activity.id, 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">{% trans %}report{% endtrans %}</span>
                                    </a>
                                </li>
                            {% endif %}
                            <li class="kt-nav__separator"></li>
                            <li class="kt-nav__head">
                                {% trans %}button.go.to{% endtrans %}
                                <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                            </li>
                            <li class="kt-nav__separator"></li>
                            {% if is_granted('view', activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_list2', { 'activity_id' : activity.id, 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">{% trans %}reports{% endtrans %}</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('view', activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('file_list_activity', { 'activity_id' : activity.id, 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">{% trans %}documents{% endtrans %}</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('view', activity) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('indicator_list', { 'activity_id' : activity.id, 'slug' : project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                        <span class="kt-nav__link-text">{% trans %}indicators{% endtrans %}</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('view', activity.project) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('graph_list', { 'slug' : activity.project.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-chart"></i>
                                        <span class="kt-nav__link-text">{% trans %}graphs{% endtrans %}</span>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                        <!--end::Nav-->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-xl-12">
        <div class="kt-portlet kt-portlet--height-fluid">
            <div class="kt-portlet__body">
                <div class="kt-widget kt-widget--user-profile-3">
                    <div class="kt-widget__top">
                        <div class="kt-widget__content" style="padding-left:0px;">
                            <div class="kt-widget__head">
                                <a href="#" class="kt-widget__username">
                                    {{ activity.title }}    
                                </a>
                            </div>
                            {% if activity.contactEmail or activity.contactPhone or activity.contactAddress %}
                            <div class="kt-widget__subhead kt-hidden">
                                {% if activity.contactEmail %}<a href="#"><i class="flaticon2-new-email"></i>{{ activity.contactEmail }}</a>{% endif %}
                                {% if activity.contactPhone %}<a href="#"><i class="flaticon2-calendar-3"></i>{{ activity.contactPhone }} </a>{% endif %}
                                {% if activity.contactAddress %}<a href="#"><i class="flaticon2-placeholder"></i>{{ activity.contactAddress }}</a>{% endif %}
                            </div> 
                            {% endif  %}
                            <span class="kt-widget__text">
                                {{ activity.description|html|raw }}                       
                            </span>
                        </div>
                    </div>

                    <div class="kt-widget__bottom">
                        <div class="kt-widget__item">
                            <div class="kt-widget__progress-" style="width: 90%;">
                                <div class="kt-widget__text">
                                    {% trans %}progression{% endtrans %}
                                </div>
                                <div class="progress" style="height: 5px;width: 100%;">
                                    <div class="progress-bar kt-bg-{{ activity|progressionClass }}" role="progressbar" style="width: {{ activity|progression }}%;" aria-valuenow="{{ activity|progression }}" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="kt-widget__stats">
                                    {{ activity|progression }}%
                                </div>
                            </div>
                        </div>

                        {% if activity.budget > 0 %}
                            <div class="kt-widget__item">
                                <div class="kt-widget__icon">
                                    <i class="flaticon-piggy-bank"></i>
                                </div>
                                <div class="kt-widget__details">
                                    <span class="kt-widget__title">{% trans %}budget{% endtrans %}</span>
                                    <span class="kt-widget__value">{{ activity.budget }}</span>
                                </div>
                            </div>
                        {% endif  %}

                        <div class="kt-widget__item">
                            <div class="kt-widget__icon">
                                <i class="flaticon-file-2"></i>
                            </div>
                            <div class="kt-widget__details">
                                <span class="kt-widget__title">{% transchoice activity.reports.count %}choice.report{% endtranschoice %}</span>
                                <a href="#reports" class="kt-widget__value kt-font-brand">{% trans %}button.view.list{% endtrans %}</a>
                            </div>
                        </div>

                        <div class="kt-widget__item">
                            <div class="kt-widget__icon">
                                <i class="flaticon-confetti"></i>
                            </div>
                            <div class="kt-widget__details">
                                <span class="kt-widget__title">{% transchoice activity.indicators.count %}choice.indicator{% endtranschoice %}</span>
                                <a href="#indicators" class="kt-widget__value kt-font-brand">{% trans %}button.view.list{% endtrans %}</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    
<div class="row">
    <div class="col-xl-12">
        <div class="kt-portlet kt-portlet--height-fluid" id="statistic">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label">
                    <h3 class="kt-portlet__head-title">
                        {% trans %}statistics{% endtrans %}
                    </h3>
                </div>
                <div class="kt-portlet__head-toolbar">
					<div class="kt-portlet__head-actions">
						<div class="dropdown dropdown-inline">
							<a href="#" class="btn btn-default btn-pill btn-sm" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
								<i class="flaticon2-settings"></i> {% trans %}button.export{% endtrans %} 
							</a>
							<div class="dropdown-menu dropdown-menu-right" x-placement="top-end" style="position: absolute; will-change: transform; top: 0px; left: 0px; transform: translate3d(32px, 0px, 0px);">
								<ul class="kt-nav" id="chart-selector">
                                    <li class="kt-nav__item" data-click="PNG">
                                        <a href="#" class="kt-nav__link">
                                            <i class="kt-nav__link-icon flaticon2-line-chart"></i>
                                            <span class="kt-nav__link-text">{% trans %}image{% endtrans %}</span>
                                        </a>
                                    </li>
                                    <li class="kt-nav__item" data-click="PDF">
                                        <a href="#" class="kt-nav__link">
                                            <i class="kt-nav__link-icon flaticon2-send"></i>
                                            <span class="kt-nav__link-text">{% trans %}PDF{% endtrans %}</span>
                                        </a>
                                    </li>
                                    <li class="kt-nav__item" data-click="PRINT">
                                        <a href="#" class="kt-nav__link">
                                            <i class="kt-nav__link-icon flaticon2-pie-chart-1"></i>
                                            <span class="kt-nav__link-text">{% trans %}print{% endtrans %}</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
						</div>
					</div>
				</div>
            </div>
            <div class="kt-portlet__body">
                <div class="form-group form-group-last row">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <select class="form-control kt-select2" id="select_indicator"  multiple="multiple">
                            {% for indicator in indicators %}
                                <option value="{{ indicator.id }}" {{ indicator in chart.indicators ? 'selected' : '' }}>{{ indicator.title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div id="chartdiv" style="width: 100%; height: 500px;"></div>
            </div>
        </div>
    </div>
</div>

	
<div class="row">
    <div class="col-lg-12">
        <div class="kt-portlet kt-portlet--height-fluid" id="reports">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label">
                    <a href="{{ path('report_list2', { activity_id : activity.id, slug : activity.project.slug } ) }}">
                        <h3 class="kt-portlet__head-title">{% trans %}reports{% endtrans %}</h3>
                    </a>
                </div>
                <div class="kt-portlet__head-toolbar">
                    <a href="{{ path('report_list2', { activity_id : activity.id, slug : activity.project.slug } ) }}" class="btn btn-label-brand btn-bold btn-sm">
                        {% trans %}button.all1{% endtrans %}
                    </a>
                    <a href="{{ path('report_index', { 'activity_id' : activity.id, 'slug' : project.slug } ) }}" class="btn btn-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                                <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                                <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                            </g>
                        </svg>
                    </a>
                </div>
            </div>
            <div class="kt-portlet__body"> 
                <div class="kt-widget5">    
					{% for report in reports %}
						{{ include('activity/_report.html.twig', { 'report' : report } ) }}
					{% else %}
                        {% trans %}no.reports.activity{% endtrans %}
					{% endfor %}
                </div>            
            </div>
        </div>
    </div>
</div>
    
<div class="row">
    <div class="col-lg-6">
        <!--begin:: Widgets/Notifications-->
		<div class="kt-portlet kt-portlet--height-fluid" id="indicators">
			<div class="kt-portlet__head">
				<div class="kt-portlet__head-label">
					<a href="{{ path('indicator_list', { 'activity_id': activity.id, 'slug' : activity.project.slug } ) }}"><h3 class="kt-portlet__head-title">Avancement</h3></a>
				</div>
                <div class="kt-portlet__head-toolbar">
                    <a href="{{ path('indicator_list', { activity_id: activity.id, slug : activity.project.slug } ) }}" class="btn btn-label-brand btn-bold btn-sm">
