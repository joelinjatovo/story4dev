{% block javascripts %}
<script src="{{ asset('js/admin/activity-show.js') }}" type="text/javascript" ></script>

<!-- Resources -->
<script src="{{ asset('js/am4chart/core.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/am4chart/charts.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/am4chart/animated.js') }}" type="text/javascript" ></script>

<!-- Chart code -->
<script>
am4core.ready(function() {

    // Themes begin
    am4core.useTheme(am4themes_animated);
    // Themes end

    // Create chart instance
    var chart = am4core.create("chartdiv", am4charts.XYChart);
    
    chart.data = {{ data|raw }};

    // Create axes
    var categoryAxis = chart.xAxes.push(new am4charts.CategoryAxis());
    categoryAxis.dataFields.category = "iteration";
    
    var valueAxis1 = chart.yAxes.push(new am4charts.ValueAxis());
    valueAxis1.title.text = "Valeur par unité";
    
    var valueAxis2 = chart.yAxes.push(new am4charts.ValueAxis());
    valueAxis2.title.text = "Progression";
    valueAxis2.renderer.opposite = true;
    valueAxis2.renderer.grid.template.disabled = true;

    // Create series
    var series1 = chart.series.push(new am4charts.ColumnSeries());
        series1.dataFields.valueY = "value";
        series1.dataFields.categoryX = "iteration";
        series1.dataFields.report = "report";
        series1.yAxis = valueAxis1;
        series1.name = "Résultat";
        series1.tooltipText = "{name}\n[bold font-size: 20]{valueY}[/] unités\n[bold font-size: 18]{report}[/] rapports";
        series1.fill = chart.colors.getIndex(0);
        series1.strokeWidth = 0;
        series1.clustered = false;
        series1.columns.template.width = am4core.percent(40);

    var series2 = chart.series.push(new am4charts.ColumnSeries());
        series2.dataFields.valueY = "goal";
        series2.dataFields.categoryX = "iteration";
        series2.yAxis = valueAxis1;
        series2.name = "Objectif";
        series2.tooltipText = "{name}\n[bold font-size: 20]{valueY}[/] unités";
        series2.fill = chart.colors.getIndex(0).lighten(0.5);
        series2.strokeWidth = 0;
        series2.clustered = false;
        series2.toBack();
    
    var series3 = chart.series.push(new am4charts.LineSeries());
        series3.dataFields.valueY = "progression";
        series3.dataFields.categoryX = "iteration";
        series3.name = "Progression";
        series3.strokeWidth = 2;
        series3.tensionX = 0.7;
        series3.yAxis = valueAxis2;
        series3.tooltipText = "{name}\n[bold font-size: 20]{valueY}%[/]";

        var bullet3 = series3.bullets.push(new am4charts.CircleBullet());
            bullet3.circle.radius = 3;
            bullet3.circle.strokeWidth = 2;
            bullet3.circle.fill = am4core.color("#fff");

    var indicatorSeries = [];
    var _seriesIndex = {{ series|raw }};
    
    jQuery.each(_seriesIndex, function(index, value) {
        index++;
        indicatorSeries[index] = chart.series.push(new am4charts.LineSeries());
        indicatorSeries[index].dataFields.valueY = value.id;
        indicatorSeries[index].dataFields.categoryX = "iteration";
        indicatorSeries[index].name = value.title;
        indicatorSeries[index].strokeWidth = 2;
        indicatorSeries[index].tensionX = 0.7;
        indicatorSeries[index].yAxis = valueAxis2;
        indicatorSeries[index].tooltipText = "{name}\n[bold font-size: 20]{valueY}%[/]";
        //indicatorSeries[index].stroke = chart.colors.getIndex(0).lighten(0.5);
        //indicatorSeries[index].strokeDasharray = "3,3";
        indicatorSeries[index].hidden = true;
        indicatorSeries[index].hiddenInLegend = true; 

        var bullet4 = indicatorSeries[index].bullets.push(new am4charts.CircleBullet());
            bullet4.circle.radius = 3;
            bullet4.circle.strokeWidth = 2;
            bullet4.circle.fill = am4core.color("#fff");
    });
    
    // Add cursor
    chart.cursor = new am4charts.XYCursor();

    // Add legend
    chart.legend = new am4charts.Legend();
    chart.legend.position = "top";
    
    // Selector
    jQuery("#select_indicator").select2({placeholder:"Séléctionnez un indicateur"});
    jQuery('#select_indicator').on('change', function (evt) {
      if (jQuery('#select_indicator').select2('val') != null){
           jQuery.each(indicatorSeries, function(index, indicatorSerie) {
               if(indicatorSerie !== undefined ){
                   indicatorSerie.hide();
               }
           });
           var $datas = $('#select_indicator').select2('data');
           jQuery.each($datas, function(index, $data) {
               var id = parseInt($data.id);
               if(indicatorSeries[id] !== undefined ){
                   indicatorSeries[id].show();
               }
           });
      }
    });

}); // end am4core.ready()
    
</script>
<script type="text/javascript">
jQuery(document).ready(function($){
});
</script>
{% endblock %}
