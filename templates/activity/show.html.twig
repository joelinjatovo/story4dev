                            </g>
                        </svg>
                        <!--<i class="flaticon2-plus"></i>-->
                    </a>
                    <div class="dropdown-menu dropdown-menu-fit dropdown-menu-md dropdown-menu-right">
                        <!--begin::Nav-->
                        <ul class="kt-nav">
                            <li class="kt-nav__head">
                                Nouveau
                                <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                            </li>
                            <li class="kt-nav__separator"></li>
                            <li class="kt-nav__item">
                                <a href="{{ path('indicator_index', { 'activity_id' : activity.id, 'project_id' : activity.project.id, 'slug': activity.project.author.slug } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-drop"></i>
                                    <span class="kt-nav__link-text">Indicator</span>
                                </a>
                            </li>
                            <li class="kt-nav__item">
                                <a href="{{ path('report_index', { 'activity_id' : activity.id, 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                    <span class="kt-nav__link-text">Rapport</span>
                                </a>
                            </li>
                            <li class="kt-nav__separator"></li>
                            <li class="kt-nav__head">
                                Aller dans
                                <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                            </li>
                            <li class="kt-nav__separator"></li>
                            <li class="kt-nav__item">
                                <a href="{{ path('report_list', { 'activity_id' : activity.id, 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                    <span class="kt-nav__link-text">Les rapports</span>
                                </a>
                            </li>
                            <li class="kt-nav__item">
                                <a href="{{ path('file_list_activity', { 'activity_id' : activity.id, 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                    <span class="kt-nav__link-text">Les documents</span>
                                </a>
                            </li>
                            <li class="kt-nav__item">
                                <a href="{{ path('report_index', { 'activity_id' : activity.id, 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-calendar-8"></i>
                                    <span class="kt-nav__link-text">Les indicateurs</span>
                                </a>
                            </li>
                        </ul>
                        <!--end::Nav-->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-xl-12">
        <div class="kt-portlet kt-portlet--height-fluid">
            <div class="kt-portlet__body">
                <div class="kt-widget kt-widget--user-profile-3">
                    <div class="kt-widget__top">
                        <div class="kt-widget__content">
                            <div class="kt-widget__head">
                                <a href="#" class="kt-widget__username">
                                    {{ activity.title }}    
                                </a>
                            </div>
                            {% if activity.contactEmail or activity.contactPhone or activity.contactAddress %}
                            <div class="kt-widget__subhead">
                                {% if activity.contactEmail %}<a href="#"><i class="flaticon2-new-email"></i>{{ activity.contactEmail }}</a>{% endif %}
                                {% if activity.contactPhone %}<a href="#"><i class="flaticon2-calendar-3"></i>{{ activity.contactPhone }} </a>{% endif %}
                                {% if activity.contactAddress %}<a href="#"><i class="flaticon2-placeholder"></i>{{ activity.contactAddress }}</a>{% endif %}
                            </div> 
                            {% endif  %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    
<div class="row">
    <div class="col-xl-12">
        <div class="kt-portlet kt-portlet--height-fluid">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label">
                    <h3 class="kt-portlet__head-title">
                        Statistiques
                    </h3>
                </div>
            </div>
            <div class="kt-portlet__body kt-portlet__body--fluid">
                 <div id="chartdiv" style="width: 100%; height: 400px;"></div>
            </div>
        </div>
    </div>
</div>
    
<div class="row">
    <div class="col-lg-6">
        <!--begin:: Widgets/Notifications-->
		<div class="kt-portlet kt-portlet--height-fluid">
			<div class="kt-portlet__head">
				<div class="kt-portlet__head-label">
					<a href="{{ path('indicator_list', { 'activity_id' : activity.id, 'project_id' : activity.project.id, 'slug': activity.project.author.slug } ) }}"><h3 class="kt-portlet__head-title">Indicators</h3></a>
				</div>
                <div class="kt-portlet__head-toolbar">
                    <a href="{{ path('indicator_list', { activity_id : activity.id, project_id : activity.project.id, slug: activity.project.author.slug } ) }}" class="btn btn-label-brand btn-bold btn-sm">
                        Tous
                    </a>
                    <a href="{{ path('indicator_index', { 'activity_id' : activity.id, 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="btn btn-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                                <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                                <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                            </g>
                        </svg>
                    </a>
                </div>
			</div>
			<div class="kt-portlet__body">
                <div class="kt-widget31">
					{% for indicator in activity.indicators.slice(0, 5) %}
						{{ include('activity/indicator.html.twig', { 'indicator' : indicator } ) }}
					{% else %}
                    Il n'y a pas encore des indicators
					{% endfor %}
				</div>
			</div>
		</div>
		<!--end:: Widgets/Notifications-->
	</div>
    <div class="col-lg-6">
        <!--begin:: Widgets/Notifications-->
        <div class="kt-portlet kt-portlet--height-fluid">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label"><a href="{{ path('file_list_activity', { activity_id : activity.id, project_id : activity.project.id, slug: activity.project.author.slug } ) }}" >
                        <h3 class="kt-portlet__head-title">Documents</h3>
                    </a>
                </div>
                <div class="kt-portlet__head-toolbar">
                    <a href="{{ path('file_list_activity', { activity_id : activity.id, project_id : activity.project.id, slug: activity.project.author.slug } ) }}" class="btn btn-label-brand btn-bold btn-sm">
                        Tous
                    </a>
                </div>
            </div>
            <div class="kt-portlet__body">
                <div class="kt-widget4" id="kt-activity-list">
					{% for activityFile in activity.activityFiles.slice(0, 5) %}
						{{ include('activity/activity-file.html.twig', { 'activityFile' : activityFile } ) }}
					{% else %}
                    Il n'y a pas encore de document
					{% endfor %}
                </div>
            </div>
        </div>
        <!--end:: Widgets/Notifications-->
    </div>
</div>
	
<div class="row">
    <div class="col-lg-12">
        <div class="kt-portlet kt-portlet--height-fluid">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label">
                    <a href="{{ path('report_list2', { activity_id : activity.id, project_id : activity.project.id, slug: activity.project.author.slug } ) }}">
                        <h3 class="kt-portlet__head-title">Rapports</h3>
                    </a>
                </div>
                <div class="kt-portlet__head-toolbar">
                    <a href="{{ path('report_list2', { activity_id : activity.id, project_id : activity.project.id, slug: activity.project.author.slug } ) }}" class="btn btn-label-brand btn-bold btn-sm">
                        Tous
                    </a>
                    <a href="{{ path('report_index', { 'activity_id' : activity.id, 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="btn btn-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                                <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                                <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                            </g>
                        </svg>
                    </a>
                </div>
            </div>
            <div class="kt-portlet__body"> 
                <div class="kt-widget5">    
					{% for report in activity.reports.slice(0, 5) %}
						{{ include('activity/report.html.twig', { 'report' : report } ) }}
					{% else %}
                        Il n'y a pas encore des rapports sur cette activités
					{% endfor %}
                </div>            
            </div>
        </div>
    </div>
</div>
{% endblock %}


{% block javascripts %}
<script src="{{ asset('js/admin/activity-show.js') }}" type="text/javascript" ></script>

<!-- Resources -->
<script src="{{ asset('js/am4chart/core.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/am4chart/charts.js') }}" type="text/javascript" ></script>
<script src="{{ asset('js/am4chart/animated.js') }}" type="text/javascript" ></script>

<!-- Chart code -->
<script>
am4core.ready(function() {

    // Themes begin
    am4core.useTheme(am4themes_animated);
    // Themes end

    // Create chart instance
    var chart = am4core.create("chartdiv", am4charts.XYChart);

    // Add data
    chart.data = [{
      "date": "2013-01-16",
      "market1": 71,
      "market2": 75,
      "sales1": 5,
      "sales2": 8
    }, {
      "date": "2013-01-17",
      "market1": 74,
      "market2": 78,
      "sales1": 4,
      "sales2": 6
    }, {
      "date": "2013-01-18",
      "market1": 78,
      "market2": 88,
      "sales1": 5,
      "sales2": 2
    }, {
      "date": "2013-01-19",
      "market1": 85,
      "market2": 89,
      "sales1": 8,
      "sales2": 9
    }, {
      "date": "2013-01-20",
      "market1": 82,
      "market2": 89,
      "sales1": 9,
      "sales2": 6
    }, {
      "date": "2013-01-21",
      "market1": 83,
      "market2": 85,
      "sales1": 3,
      "sales2": 5
    }, {
      "date": "2013-01-22",
      "market1": 88,
      "market2": 92,
      "sales1": 5,
      "sales2": 7
    }, {
      "date": "2013-01-23",
      "market1": 85,
      "market2": 90,
      "sales1": 7,
      "sales2": 6
    }, {
      "date": "2013-01-24",
      "market1": 85,
      "market2": 91,
      "sales1": 9,
      "sales2": 5
    }, {
      "date": "2013-01-25",
      "market1": 80,
      "market2": 84,
      "sales1": 5,
      "sales2": 8
    }, {
      "date": "2013-01-26",
      "market1": 87,
      "market2": 92,
      "sales1": 4,
      "sales2": 8
    }, {
      "date": "2013-01-27",
      "market1": 84,
      "market2": 87,
      "sales1": 3,
      "sales2": 4
    }, {
      "date": "2013-01-28",
      "market1": 83,
      "market2": 88,
      "sales1": 5,
      "sales2": 7
    }, {
      "date": "2013-01-29",
      "market1": 84,
      "market2": 87,
      "sales1": 5,
      "sales2": 8
    }, {
      "date": "2013-01-30",
      "market1": 81,
      "market2": 85,
      "sales1": 4,
      "sales2": 7
    }];
    
    chart.data = {{ data|raw }};

    // Create axes
    //var dateAxis = chart.xAxes.push(new am4charts.DateAxis());
    //dateAxis.renderer.grid.template.location = 0;
    //dateAxis.renderer.minGridDistance = 30;
    
    var categoryAxis = chart.xAxes.push(new am4charts.CategoryAxis());
    categoryAxis.dataFields.category = "iteration";
    
    var valueAxis1 = chart.yAxes.push(new am4charts.ValueAxis());
    valueAxis1.title.text = "Valeur par unité";
    
    var valueAxis2 = chart.yAxes.push(new am4charts.ValueAxis());
    valueAxis2.title.text = "Progression";
    valueAxis2.renderer.opposite = true;
    valueAxis2.renderer.grid.template.disabled = true;

    // Create series
    var series1 = chart.series.push(new am4charts.ColumnSeries());
        series1.dataFields.valueY = "value";
        series1.dataFields.categoryX = "iteration";
        series1.dataFields.report = "report";
        series1.yAxis = valueAxis1;
        series1.name = "Résultat";
        series1.tooltipText = "{name}\n[bold font-size: 20]{valueY}[/] unités\n[bold font-size: 18]{report}[/] rapports";
        series1.fill = chart.colors.getIndex(0);
        series1.strokeWidth = 0;
        series1.clustered = false;
        series1.columns.template.width = am4core.percent(40);

    var series2 = chart.series.push(new am4charts.ColumnSeries());
        series2.dataFields.valueY = "goal";
        series2.dataFields.categoryX = "iteration";
        series2.yAxis = valueAxis1;
        series2.name = "Objectif";
        series2.tooltipText = "{name}\n[bold font-size: 20]{valueY}[/] unités";
        series2.fill = chart.colors.getIndex(0).lighten(0.5);
        series2.strokeWidth = 0;
        series2.clustered = false;
        series2.toBack();
    
    var series3 = chart.series.push(new am4charts.LineSeries());
        series3.dataFields.valueY = "progression";
        series3.dataFields.categoryX = "iteration";
        series3.name = "Progression";
        series3.strokeWidth = 2;
        series3.tensionX = 0.7;
        series3.yAxis = valueAxis2;
        series3.tooltipText = "{name}\n[bold font-size: 20]{valueY}%[/]";

        var bullet3 = series3.bullets.push(new am4charts.CircleBullet());
            bullet3.circle.radius = 3;
            bullet3.circle.strokeWidth = 2;
            bullet3.circle.fill = am4core.color("#fff");

    var _series = {{ series|raw }};
    jQuery.each(_series, function(index, value) {
        var series4 = chart.series.push(new am4charts.LineSeries());
        series4.dataFields.valueY = value.id;
        series4.dataFields.categoryX = "iteration";
        series4.name = value.title;
        series4.strokeWidth = 2;
        series4.tensionX = 0.7;
        series4.yAxis = valueAxis2;
        series4.tooltipText = "{name}\n[bold font-size: 20]{valueY}%[/]";
        //series4.stroke = chart.colors.getIndex(0).lighten(0.5);
        //series4.strokeDasharray = "3,3";
        series4.hidden = true;

        var bullet4 = series4.bullets.push(new am4charts.CircleBullet());
            bullet4.circle.radius = 3;
            bullet4.circle.strokeWidth = 2;
            bullet4.circle.fill = am4core.color("#fff");
    });
    
    /*
    var series5 = chart.series.push(new am4charts.LineSeries());
        series5.dataFields.valueY = "report";
        series5.dataFields.categoryX = "iteration";
        series5.name = "Nombre de rapport";
        series5.strokeWidth = 2;
        series5.tensionX = 0.7;
        series5.yAxis = valueAxis2;
        series5.tooltipText = "{name}\n[bold font-size: 18]{valueY}[/]";
        series5.stroke = chart.colors.getIndex(0).lighten(0.5);
        series5.strokeDasharray = "3,3";

        var bullet5 = series5.bullets.push(new am4charts.CircleBullet());
            bullet5.circle.radius = 3;
            bullet5.circle.strokeWidth = 2;
            bullet5.circle.fill = am4core.color("#fff");
    */
    
    // Add cursor
    chart.cursor = new am4charts.XYCursor();

    // Add legend
    chart.legend = new am4charts.Legend();
    chart.legend.position = "top";

    // Add scrollbar
    /*
    chart.scrollbarX = new am4charts.XYChartScrollbar();
    chart.scrollbarX.series.push(series1);
    chart.scrollbarX.series.push(series3);
    chart.scrollbarX.parent = chart.bottomAxesContainer;
    */

}); // end am4core.ready()
</script>


{% endblock %}
