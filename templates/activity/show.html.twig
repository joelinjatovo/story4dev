</div>
    
<!--begin::Modal-->
<div class="modal fade" id="kt_modal_add_indicator" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    {{ form_start( form, { 'method' : 'POST', 'attr' : { 'id' : 'indicator_form', 'class' : 'modal-dialog modal-sm', 'role' : 'document' } } ) }}
        <input type="hidden" name="indicator[activity]" value="{{ activity.id }}" >
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">New indicator</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    {{ form_label( form.title, null, { 'label_attr': { 'class': 'form-control-label' } } ) }}
                    {{ form_widget( form.title, { 'attr' : { 'class' : 'form-control' } } ) }}
                </div>
                <div class="form-group">
                    {{ form_label( form.unit, null, { 'label_attr': { 'class': 'form-control-label' } } ) }}
                    {{ form_widget( form.unit, { 'attr' : { 'class' : 'form-control' } } ) }}
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                {{ form_widget( form.submit, { 'attr' : { 'class' : 'btn btn-primary' } } ) }}
            </div>
        </div>
        {{ form_row( form._token ) }}
    {{ form_end( form, {'render_rest': false}) }}
</div>
<!--end::Modal-->
    
