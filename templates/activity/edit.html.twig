{% extends 'activity/create.html.twig' %}

{% block title %}{% trans %}activity{% endtrans %} #{{ activity.id }} - {% trans %}project{% endtrans %} #{{ project.id }} - {{ app.user.fullname }} {% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}editing.activity{% endtrans %}</h3>
            {% if is_granted('create_activity', project) %}
                <a href="{{ path('activity_index', { slug: project.slug }) }}" class="btn btn-label-brand btn-bold">{% trans %}button.add{% endtrans %}</a>
            {% endif %}
        </div>        
        <div class="kt-subheader__toolbar">
            <a href="{{ url('activity_show', { slug : activity.project.slug, activity_id : activity.id }) }}" class="btn btn-clean btn-icon-sm"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">{% trans %}button.back{% endtrans %}</span></a>
            <div class="btn-group">
                <button type="submit" form="activity" name="submit" value="save-default" class="btn btn-brand">
                    <i class="la la-check"></i> 
                    <span class="kt-hidden-mobile">{% trans %}button.save{% endtrans %}</span>
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}