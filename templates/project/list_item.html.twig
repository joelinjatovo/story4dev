<!--begin:: Portlet-->
<div class="kt-portlet kt-portlet--height-fluid project-item">
    <div class="kt-portlet__body kt-portlet__body--fit">
        <!--begin::Widget -->
        <div class="kt-widget kt-widget--project-1">
            <div class="kt-widget__head">
                <div class="kt-widget__label">
                    <div class="kt-widget__media">
                        <span class="kt-media kt-media--lg kt-media--circle"> 
                        <img src="{{ project.picture ? vich_uploader_asset(project, 'pictureFile') : default_picture }}" alt="image">  
                        </span>
                    </div>
                    <div class="kt-widget__info kt-margin-t-5">
                        <a href="{{ path('project_show', {'slug': project.author.slug, 'id': project.id}) }}" class="kt-widget__title">
                            {{ project.title }}                                                 
                        </a>
                        <span class="kt-widget__desc">
                            {% if project.contactemail %}
                                <a href="mailto:{{project.contactemail}}" style="color: #666;"><i class="flaticon2-new-email"></i> {{ project.contactemail }}</a>
                            {% endif %}
                            {% if project.contactphone %}
                                <a href="tel:{{project.contactphone}}" style="color: #666;"><i class="flaticon2-calendar-3"></i> {{ project.contactphone }}</a>
                            {% endif %}
                            {% if project.contactaddress %}
                                <a href="#" style="color: #666;"><i class="flaticon2-placeholder" ></i> {{ project.contactaddress }}</a>
                            {% endif %}
                        </span>
                    </div>
                </div>
                <div class="kt-portlet__head-toolbar kt-hidden-">
                    <a href="#" class="btn btn-clean btn-sm btn-icon btn-icon-md" data-toggle="dropdown">
                        <i class="flaticon-more-1"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-fit dropdown-menu-right">
                        <ul class="kt-nav">
                            {% if is_granted('view', project) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('project_show', { 'slug' : project.author.slug, 'id': project.id })}}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-line-chart"></i>
                                        <span class="kt-nav__link-text">Détails</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('edit', project) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('project_edit', { 'slug' : project.author.slug, 'id': project.id })}}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-edit"></i>
                                        <span class="kt-nav__link-text">Modifier</span>
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('remove', project) %}
                                <li class="kt-nav__item">
                                    <a data-id="{{ project.id }}" href="#" class="kt-nav__link btn-remove">
                                        <i class="kt-nav__link-icon flaticon-delete"></i>
                                        <span class="kt-nav__link-text">Supprimer</span>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>

            <div class="kt-widget__body">
                <div class="kt-widget__stats">
                    <div class="kt-widget__item">
                        <span class="kt-widget__date">
                            Date de début
                        </span>
                        <div class="kt-widget__label">
                            <span class="btn btn-label-brand btn-sm btn-bold btn-upper">{{ project.startat is empty ? "" : project.startat | date('Y-m-d') }}</span>
                        </div>
                    </div>

                    <div class="kt-widget__item">
                        <span class="kt-widget__date">
                            Date de fin
                        </span>
                        <div class="kt-widget__label">
                            <span class="btn btn-label-danger btn-sm btn-bold btn-upper">{{ project.endat is empty ? "" : project.endat | date('Y-m-d') }}</span>
                        </div>
                    </div>

                    <div class="kt-widget__item flex-fill">
                        <span class="kt-widget__subtitel">Progression</span>
                        <div class="kt-widget__progress d-flex  align-items-center">
                            <div class="progress" style="height: 5px;width: 100%;">
                                <div class="progress-bar kt-bg-warning" role="progressbar" style="width: {{ project.progression }}%;" aria-valuenow="{{ project.progression }}" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <span class="kt-widget__stat">
                                {{ project.progression }}%
                            </span>
                        </div>
                    </div>
                </div>

                <span class="kt-widget__text">
                    {{ project.description|excerpt }}                       
                </span>

                <div class="kt-widget__content">
                    {% if project.budget > 0 %}
                    <div class="kt-widget__details">
                        <span class="kt-widget__subtitle">Budget</span>
                        <span class="kt-widget__value">{{ project.budget }} <span>{{ project.currency }}</span></span>
                    </div>
                    {% endif %}

                    <div class="kt-widget__details">
                        <span class="kt-widget__subtitle">Contributeurs</span>
                        <div class="kt-media-group">
                            {% for contribution in project.contributions.slice(0, 7) %}
                            <a href="{{ path('contribution_show', { 'project_id' : contribution.project.id, 'slug': contribution.project.author.slug, 'contribution_id': contribution.id } ) }}" class="kt-media kt-media--sm kt-media--circle" data-toggle="kt-tooltip" data-skin="brand" data-placement="top" title="" data-original-title="{{ contribution.user.fullname ?? contribution.user.email }}">
                                <img src="{{ contribution.user.avatar is null ? default_avatar : vich_uploader_asset(contribution.user, 'avatarFile') }}" alt="avatar">
                            </a>
                            {% endfor %}
                            {% if project.contributions.count > 7 %}
                                <a href="{{ path('contribution_list', { 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="kt-media kt-media--sm kt-media--circle" data-toggle="kt-tooltip" data-skin="brand" data-placement="top" title="" data-original-title="Micheal York">
                                    <span>+{{ project.contributions.count - 7 }}</span>
                                </a>
                            {% endif %}
                        </div>                                 
                    </div>
                </div>
            </div>

            <div class="kt-widget__footer">
                <div class="kt-widget__wrapper">
                    <div class="kt-widget__section">
                        <div class="kt-widget__blog">
                            <i class="flaticon2-list-1"></i>
                            <a href="{{ path( 'activity_list', { 'slug': project.author.slug, 'project_id': project.id } ) }}" class="kt-widget__value kt-font-brand">{{ project.activities.count }}  Activities</a>
                        </div>

                        <div class="kt-widget__blog kt-hidden">
                            <i class="flaticon2-talk"></i>
                            <a href="{{ path( 'report_list', { 'slug': project.author.slug, 'project_id': project.id } ) }}" class="kt-widget__value kt-font-brand">--- Reports</a>
                        </div>
                    </div>

                    <div class="kt-widget__section">
                        <a href="{{ path('project_show', {'slug': project.author.slug, 'id': project.id}) }}" class="btn btn-brand btn-sm btn-upper btn-bold">détails</a>                                 
                    </div>
                </div>
            </div>
        </div>
        <!--end::Widget -->
    </div>
</div>