{% extends 'base.html.twig' %}

{% block title %}Nouveau Projet - Admin - {{ app.user.fullname }} {% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<br>
{% endblock %}

{% block content %}
<div class="row">
   	<div class="col-lg-12">	
		<!--begin::Portlet-->
		<div class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
			<div class="kt-portlet__head kt-portlet__head--lg" style="">
				<div class="kt-portlet__head-label">
                    {% block headtitle %}
					   <h3 class="kt-portlet__head-title">Nouveau Projet <small>entrer les informations à-propos du projet puis enregister</small></h3>
                    {% endblock %}
				</div>
				<div class="kt-portlet__head-toolbar">
                    {% if project is defined and project is not null and ( project.id > 0 ) %}
                        <a href="{{ path('project_show', { slug : project.slug } ) }}" class="btn btn-clean kt-margin-r-10">
                            <i class="la la-arrow-left"></i>
                            <span class="kt-hidden-mobile">Retour</span>
                        </a>
                    {% endif %}
					<div class="btn-group">
						<button type="submit" form="project" name="submit" value="save-default" class="btn btn-brand">
							<i class="la la-check"></i> 
							<span class="kt-hidden-mobile">Enregistrer</span>
						</button>
						<button type="button" class="btn btn-brand dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
						</button>
						<div class="dropdown-menu dropdown-menu-right">
							<ul class="kt-nav">
								<li class="kt-nav__item">
									<button type="submit" form="project" name="submit" value="save-continue" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-reload"></i>
										<span class="kt-nav__link-text">Save &amp; continue</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="project" name="submit" value="save-edit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-edit"></i>
										<span class="kt-nav__link-text">Save &amp; edit</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="project" name="submit" value="save-create" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-add-1"></i>
										<span class="kt-nav__link-text">Save &amp; add new</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="project" name="submit" value="save-exit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon-close"></i>
										<span class="kt-nav__link-text">Save &amp; exit</span>
									</button>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="kt-portlet__body">
				{{ form_start( form, { 'method' : 'POST', 'attr' : { 'id' : 'project', 'class' : 'kt-form' } } ) }}
					<div class="row">
						<div class="col-xl-2"></div>
						<div class="col-xl-8">
							<div class="kt-section kt-section--first">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Info:</h3>
                                    <div class="form-group row">
                                        <label class="col-xl-3 col-lg-3 col-form-label">Logo du projet</label>
                                        <div class="col-lg-9 col-xl-6">
                                            <div class="kt-avatar kt-avatar--outline" id="kt_project_piture">
                                                <div class="kt-avatar__holder" style="background-image: url('{{ project.picture ? vich_uploader_asset(project, 'pictureFile') : default_picture }}');"></div>
                                                <label class="kt-avatar__upload" data-toggle="kt-tooltip" title="" data-original-title="Changer le logo du projet">
                                                    <i class="fa fa-pen"></i>
                                                    <input type="file" name="project[pictureFile][file]" accept=".png, .jpg, .jpeg">
                                                </label>
                                                <span class="kt-avatar__cancel" data-toggle="kt-tooltip" title="" data-original-title="Supprimer le logo du projet">
                                                    <i class="fa fa-times"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    {% set validatedClass = '' %} 
                                    {% set invalidClass = '' %} 
                                    {% if form.slug.vars.valid == false %}
                                        {% set validatedClass = 'validated' %}
                                        {% set invalidClass = 'is-invalid' %}
                                    {% endif %}
									<div class="form-group row {{ validatedClass }}">
                    					{{ form_label( form.slug, 'Url du projet', { 'label_attr': { class: "col-3 col-form-label " ~ invalidClass  } } ) }}
										<div class="col-9">
											{{ form_widget( form.slug, { 'attr' : { 'class' : "form-control " ~ invalidClass } } ) }}
                                            {% for error in form.slug.vars.errors %}
                                                <div id="billing_address_1-error" class="error invalid-feedback">
                                                    {{ error.message }}
                                                </div>
                                            {% endfor %}
                                        </div>
									</div>
									<div class="form-group row">
                    					{{ form_label( form.title, 'Nom du projet', { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.title, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
									<div class="form-group row">
                    					{{ form_label( form.description, 'Description du projet', { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.description, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
									<div class="form-group row">
                    					{{ form_label( form.budget, "Budget du projet", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.budget, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
									<div class="form-group row">
                    					{{ form_label( form.currency, "Devise", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											{{ form_widget( form.currency, { 'attr' : { 'class' : 'form-control' } } ) }}
										</div>
									</div>
								</div>
							</div>
                            <div class="kt-separator kt-separator--border-dashed kt-separator--space-lg"></div>
                            <div class="kt-section">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Détails:</h3>
									{% if not project.id > 0 %}
										<div class="form-group row">
											{{ form_label( form.author, "Administrateur", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
											<div class="col-lg-9 col-xl-6">
												{{ form_widget( form.author, { 'attr' : { 'form' : 'project', 'class' : 'form-control' } } ) }}
                                                <span class="form-text text-muted">Celui-ci va être l'administrateur principal du projet.</span>
											</div>
										</div>
									{% endif %}
                                    <div class="form-group row">
                                        {{ form_label( form.start_at, "Date de début du projet", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                        <div class="col-lg-9 col-xl-6">
                                            <div class="input-group date">
                                                {{ form_widget( form.start_at, { 'attr' : { 'form' : 'project', 'class' : 'form-control js-datepicker', 'autocomplete':'off' } } ) }}
                                                <div class="input-group-append">
                                                    <span class="input-group-text">
                                                        <i class="la la-calendar-check-o"></i>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        {{ form_label( form.end_at, "Date de fin du projet", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                        <div class="col-lg-9 col-xl-6">
                                            <div class="input-group date">
                                                {{ form_widget( form.end_at, { 'attr' : { 'form' : 'project', 'class' : 'form-control js-datepicker', 'autocomplete':'off' } } ) }}
                                                <div class="input-group-append">
                                                    <span class="input-group-text">
                                                        <i class="la la-calendar-check-o"></i>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        {{ form_label( form.periodicity, "Périodicité suivi indicateurs", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                        <div class="col-lg-9 col-xl-6">
                                            {{ form_widget( form.periodicity, { 'attr' : { 'form' : 'project', 'class' : 'form-control'} } ) }}
                                        </div>
                                    </div>
                                    <div id="kt_repeater_2">
                                        <div class="form-group row">
                                            <label class="col-lg-3 col-form-label">Suivis des indicateurs</label>
                                            <div data-repeater-list="project[iterations]" class="col-lg-9">
                                                {% if project.iterations is empty %}
													<div data-repeater-item="" class="kt-margin-b-10">
                                                        <div class="form-group row">
                                                            <div class="col-lg-3">
                                                                <div class="input-group">
                                                                    {{ form_widget(form.iterations.vars.prototype.id ) }}
                                                                    {{ form_widget(form.iterations.vars.prototype.title, { 'attr' : { 'form' : 'project', 'placeholder' : 'Période suivie', 'class' : 'form-control' } } ) }}
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <div class="input-group">
                                                                    {{ form_widget( form.iterations.vars.prototype.startAt, { 'attr' : { 'form' : 'project', 'placeholder' : 'Début du suivi', 'class' : 'form-control js-datepicker', 'autocomplete':'off' } } ) }}
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <div class="input-group">
                                                                    {{ form_widget( form.iterations.vars.prototype.endAt, { 'attr' : { 'form' : 'project', 'placeholder' : 'Fin du suivi', 'class' : 'form-control js-datepicker', 'autocomplete':'off' } } ) }}
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <a href="javascript:;" data-repeater-delete="" class="btn-sm btn btn-label-danger btn-bold">
                                                                    <i class="la la-trash-o"></i>
                                                                    Supprimer
                                                                </a>
                                                            </div>
                                                        </div>
													</div>
                                                {% endif %} 
												
                                                {% for iteration in form.iterations %}
                                                    <div data-repeater-item="" class="kt-margin-b-10">
                                                        <div class="form-group row">
                                                            <div class="col-lg-3">
                                                                <div class="input-group">
                                                                    {{ form_widget( iteration.id ) }}
                                                                    {{ form_widget( iteration.title, { 'attr' : { 'form' : 'project', 'placeholder' : 'Label du suivi', 'class' : 'form-control' } } ) }}
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <div class="input-group">
                                                                    {{ form_widget( iteration.startAt, { 'attr' : { 'form' : 'project', 'placeholder' : 'Début du suivi', 'class' : 'form-control js-datepicker', 'autocomplete':'off' } } ) }}
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <div class="input-group">
                                                                    {{ form_widget( iteration.endAt, { 'attr' : { 'form' : 'project', 'placeholder' : 'Fin du suivi', 'class' : 'form-control js-datepicker', 'autocomplete':'off' } } ) }}
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <a href="javascript:;" data-repeater-delete="" class="btn-sm btn btn-label-danger btn-bold">
                                                                    <i class="la la-trash-o"></i>
                                                                    Supprimer
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}                                                       
                                            </div>                 
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-3"></div>
                                            <div class="col">
                                                <div data-repeater-create="" class="btn btn btn-warning">
                                                    <span>
                                                        <i class="la la-plus"></i>
                                                        <span>Ajouter un suivi</span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div> 
                                    </div>
								</div>
							</div>
                            {% if project.id > 0 %}
                                <div class="kt-separator kt-separator--border-dashed kt-separator--space-lg"></div>
                                <div class="kt-section">
                                    <div class="kt-section__body">
                                        <h3 class="kt-section__title kt-section__title-lg">Paramètres du projet:</h3>
                                        {% for color in form.colors %}
                                            <div class="form-group row">
                                                <label class="col-lg-3 col-form-label">Couleurs</label>
                                                <div class="col-xl-3 col-lg-3">
                                                    <div class="input-group">
                                                        {{ form_widget( color, { 'attr' : { 'form' : 'project', 'placeholder' : 'Count', 'class' : 'form-control', 'autocomplete':'off' } } ) }}
                                                    </div>
                                                    <span class="form-text text-muted">Couleur du fond de l'entête</span>
                                                </div>
                                            </div>
                                        {% endfor %}
                                        {% for query in form.queries %}
                                            <div class="form-group row">
                                                <label class="col-lg-3 col-form-label">Filtrer les {{ query.vars.name }}</label>
                                                <div class="col-xl-3 col-lg-3">
                                                    <div class="input-group">
                                                        {{ form_widget( query.order_by, { 'attr' : { 'form' : 'project', 'placeholder' : 'Order By', 'class' : 'form-control', 'autocomplete':'off' } } ) }}
                                                    </div>
                                                </div>
                                                <div class="col-xl-3 col-lg-3">
                                                    <div class="input-group">
                                                        {{ form_widget( query.order, { 'attr' : { 'form' : 'project', 'placeholder' : 'Order', 'class' : 'form-control', 'autocomplete':'off' } } ) }}
                                                    </div>
                                                </div>
                                                <div class="col-xl-3 col-lg-3">
                                                    <div class="input-group">
                                                        {{ form_widget( query.count, { 'attr' : { 'form' : 'project', 'placeholder' : 'Count', 'class' : 'form-control', 'autocomplete':'off' } } ) }}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                        
                                        {% if is_granted('ROLE_ADMIN') %}
                                            {% for quota in form.quotas %}
                                                <div class="form-group row">
                                                    <label class="col-lg-3 col-form-label">Quotas</label>
                                                    <div class="col-xl-3 col-lg-3">
                                                        <div class="input-group">
                                                            {{ form_widget( quota, { 'attr' : { 'form' : 'project', 'placeholder' : 'Count', 'class' : 'form-control', 'autocomplete':'off' } } ) }}
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                            <div class="kt-separator kt-separator--border-dashed kt-separator--space-lg kt-hidden"></div>
                            <div class="kt-section kt-hidden">
								<div class="kt-section__body">
									<h3 class="kt-section__title kt-section__title-lg">Détails du contact:</h3>
                                    <div class="form-group row">
										{{ form_label( form.contactemail, "Email du contact", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											<div class="input-group">
												<div class="input-group-prepend"><span class="input-group-text"><i class="la la-at"></i></span></div>
                                                {{ form_widget( form.contactemail, { 'attr' : { 'class' : 'form-control', 'aria-describedby':'basic-addon1' } } ) }}
											</div>
										</div>
									</div>
                                    <div class="form-group row">
										{{ form_label( form.contactphone,  "Téléphone du contact", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											<div class="input-group">
												<div class="input-group-prepend"><span class="input-group-text"><i class="la la-phone"></i></span></div>
                                                {{ form_widget( form.contactphone, { 'attr' : { 'class' : 'form-control', 'aria-describedby':'basic-addon1' } } ) }}
											</div>
										</div>
									</div>
                                    <div class="form-group row">
										{{ form_label( form.contactaddress,  "Adresse du contact", { 'label_attr': { 'class': 'col-3 col-form-label' } } ) }}
										<div class="col-9">
											<div class="input-group">
												<div class="input-group-prepend"><span class="input-group-text"><i class="la la-map"></i></span></div>
                                                {{ form_widget( form.contactaddress, { 'attr' : { 'class' : 'form-control', 'aria-describedby':'basic-addon1' } } ) }}
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-xl-2"></div>
					</div>
					{% if project.id > 0 %}
						<input type="hidden" name="project[author]" value="{{ user.id }}">
					{% endif %}
					{{ form_row( form._token ) }}
				{{ form_end( form, {'render_rest': false}) }}
			</div>
		</div>	
		<!--end::Portlet-->
	</div>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/project-crud.js') }}" type="text/javascript" ></script>
{% endblock %}
