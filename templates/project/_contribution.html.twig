<div class="kt-widget__item contribution-item" >
    <span class="kt-media kt-media--circle"> 
        <img src="{{ contribution.user.avatar ? vich_uploader_asset(contribution.user, 'avatarFile') | imagine_filter('thumb') : default_avatar }}" alt="avatar">
    </span>
    <div class="kt-widget__info">
        <div class="kt-widget__section">
            <a href="{{ path('contribution_show', { 'slug' : contribution.project.slug, 'contribution_id': contribution.id } ) }}" class="kt-widget__username">{{ contribution.user.fullname }}</a>
        </div>
        <span class="kt-widget__desc">
            {{ (contribution.user.title is null) or (contribution.user.title is empty) ? contribution.user.email : contribution.user.title }}
        </span>
    </div>
    <div class="kt-widget__action">
        {% if contribution.isAdmin() %}
            <span class="kt-badge kt-badge--bolder kt-badge kt-badge--inline kt-badge--unified-primary report-status">{% trans %}role.admin{% endtrans %}</span>
        {% else %}
            <span class="kt-badge kt-badge--bolder kt-badge kt-badge--inline kt-badge--unified-success report-status">{% trans %}role.customer{% endtrans %}</span>
        {% endif %}
        <span class="kt-widget__date">{{ contribution.createdat|ago }}</span>
    </div>
</div>