<div class="kt-widget5__item" style="padding-bottom: 0.5rem;margin-bottom: 0.5rem;">
    <div class="kt-widget5__content">
        <div class="kt-widget5__section">
            <a href="{{ url('activity_show', { 'project_id' : activity.project.id, 'activity_id' : activity.id }) }}" class="kt-widget5__title">
                {{ activity.title }}
            </a>
            <div class="kt-widget5__info">
                <span>Date:</span>
                <span class="kt-font-info">{{ activity.createdat is empty ? "" : activity.createdat | date('Y-m-d') }}</span>
            </div>
        </div>
    </div>						
    <div class="kt-widget5__content">
        <div class="kt-widget5__stats">
            <span class="kt-widget5__sales"><span class="kt-widget5__number">{{ activity.indicators.count }}</span> Indicateurs</span>
        </div>
        <div class="kt-widget5__stats">
            <span class="kt-widget5__sales"><span class="kt-widget5__number">{{ activity.reports.count }}</span> Rapports</span>
            
        </div>
    </div>	
</div>