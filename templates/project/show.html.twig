<script src="{{ asset('js/project.js') }}" type="text/javascript" ></script>
<script type="text/javascript" >

var chart;

var chartData = {{ data|raw }};


AmCharts.ready(function() {
    // SERIAL CHART
    chart = new AmCharts.AmSerialChart();
    chart.dataProvider = chartData;
    chart.categoryField = "iteration";
    chart.startDuration = 1;

    // AXES
    // category
    var categoryAxis = chart.categoryAxis;
    categoryAxis.labelRotation = 90;
    categoryAxis.gridPosition = "start";

    // value
    // in case you don't want to change default settings of value axis,
    // you don't need to create it, as one value axis is created automatically.
    // GRAPH
    var graph1 = new AmCharts.AmGraph();
    graph1.valueField = "value";
    graph1.balloonText = "[[category]]: [[value]]";
    graph1.type = "column";
    graph1.lineAlpha = 0.2;
    graph1.fillAlphas = 0.8;
    graph1.titles = [{
        "text": "Yearly data"
    }];
    chart.addGraph(graph1);
    var graph2 = new AmCharts.AmGraph();
    graph2.valueField = "goal";
    graph2.balloonText = "[[category]]: [[value]]";
    graph2.type = "column";
    graph2.clustered = false;
    graph2.columnWidth = 0.5;
    graph2.lineAlpha = 0.2;
    graph2.fillAlphas = 0.8;
    graph2.titles = [{
        "text": "Yearly data"
    }];
    chart.addGraph(graph2);
    
    chart.addListener("clickGraphItem", function (event) {
        // let's look if the clicked graph item had any subdata to drill-down into
        if (event.item.dataContext.subdata != undefined) {
            // wow it has!
            // let's set that as chart's dataProvider
            event.chart.dataProvider = event.item.dataContext.subdata;
            
            // update the chart title
            //event.chart.titles[0].text = event.item.dataContext.category + ' monthly data';

            // let's add a label to go back to yearly data
            event.chart.addLabel(
                "!10", 25, 
                "Go back to yearly >",
                "right", 
                undefined, 
                undefined, 
                undefined, 
                undefined, 
                true, 
                'javascript:resetChart();');
            
            // validate the new data and make the chart animate again
            event.chart.validateData();
            event.chart.animateAgain();
        }
    });


    chart.write("chartdiv");
});
    
// function which resets the chart back to yearly data
function resetChart() {
    chart.dataProvider = chartData;
    //chart.titles[0].text = 'Yearly data';

    // remove the "Go back" label
    chart.allLabels = [];

    chart.validateData();
    chart.animateAgain();
}
</script>
{% endblock %}
