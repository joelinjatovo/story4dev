                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-6" id="reports">
        <div class="kt-portlet kt-portlet--height-fluid" style="background-color: rgba(29, 201, 183, 0.1);">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label">
                    <a href="{{ path('report_list', { 'project_id' : project.id, 'slug': project.author.slug } ) }}">
                        <h3 class="kt-portlet__head-title">Rapports</h3>
                    </a>
                </div>
                <div class="kt-portlet__head-toolbar">
                    <a href="{{ path('report_list', { 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="btn btn-label-primary btn-bold btn-sm">
                        Tous
                    </a>
                    <button class="btn btn-icon" data-toggle="modal" data-target="#kt_modal_activities">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                                <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                                <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                            </g>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="kt-portlet__body">
                <div class="kt-widget5">
                    {% for report in reports %}
                        {{ include('project/report.html.twig', { 'report' : report } ) }}
                    {% else %}
                        Il n'y a pas encore de rapports dans ce projet.
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
    
<div class="row">
    <div class="col-xl-6">
        <div class="kt-portlet kt-portlet--height-fluid">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label">
                    <a href="{{ path('contribution_list', { 'project_id' : project.id, 'slug': project.author.slug } ) }}">
                        <h3 class="kt-portlet__head-title">Equipe projet</h3>
                    </a>
                </div>
                <div class="kt-portlet__head-toolbar">
                    <a href="{{ path('contribution_list', { 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="btn btn-label-brand btn-bold btn-sm">
                        Tous
                    </a>
                </div>
            </div>
            <div class="kt-portlet__body">
                <div class="kt-widget kt-widget--users">                
                    <div class="kt-scroll kt-scroll--pull">
                        <div class="kt-widget__items" id="project-contributions">
                            {% for contribution in project.contributions.slice(0, 5) %}
                                {{ include('project/contribution.html.twig', { 'contribution' : contribution } ) }}
                            {% else %}
                                Il n'y a pas encore des contributeurs dans ce projet.
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}

{% if is_granted('edit', project) %}
    <script src="{{ asset('js/bootstrap-colorpicker.min.js') }}" type="text/javascript"></script>
    <script type="text/javascript" >
    jQuery(document).ready(function($){
        function postColor(projectId, color, metakey){
            KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
            $.post("/project/color", { color: color, id: projectId, metakey: metakey})
            .done(function( data ) {
                KTApp.unblockPage();
                if(data.success){
                    $('.'+metakey).css('background-color', color);
                }
            })
            .fail(function() {
                KTApp.unblockPage();
            });
        }

        $('.colorpicker').colorpicker().on('changeColor', function(event) {
            var $this = $(this);
            var color = $(this).colorpicker('getValue', '#ffffff');
            postColor($this.attr('data-id'), color, $this.attr('data-metakey'));
        });
    });
    </script>
{% endif %}
{% endblock %}
