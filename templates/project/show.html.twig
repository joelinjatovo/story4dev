{% extends 'base.html.twig' %}

{% block title %}Projet #{{ project.id }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
<link href="{{ asset('css/bootstrap-colorpicker.min.css') }}" rel="stylesheet" type="text/css"/>
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">Détail du projet</h3>
        </div>        
        <div class="kt-subheader__toolbar">
            {% if is_granted('edit', project) %}
                <a href="{{ path('project_edit', { 'id' : project.id, 'slug': project.author.slug } ) }}" class="btn kt-subheader__btn-primary">Modifier</a>
                <a href="{{ path('project_dashboard', { 'id' : project.id, 'slug': project.author.slug } ) }}" class="btn btn-label-brand btn-bold">Dashboard</a>
            {% endif %}
            <div class="kt-subheader__wrapper">
                <div class="dropdown dropdown-inline" data-toggle="kt-tooltip-" title="Quick actions" data-placement="left">
                    <a href="#" class="btn btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                                <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                                <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                            </g>
                        </svg>
                    </a>
                    <div class="dropdown-menu dropdown-menu-fit dropdown-menu-md dropdown-menu-right">
                        <!--begin::Nav-->
                        <ul class="kt-nav">
                            {% if is_granted('edit', project) %}
                                <li class="kt-nav__head">
                                    Nouveau                                 
                                    <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                                </li>
                                <li class="kt-nav__separator"></li>
                                <li class="kt-nav__item">
                                    <a href="{{ path('activity_index', { 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon-map"></i>
                                        <span class="kt-nav__link-text">Activité</span>
                                    </a>
                                </li>
                                <li class="kt-nav__item">
                                    <button class="kt-nav__link" data-toggle="modal" data-target="#kt_modal_activities">
                                        <i class="kt-nav__link-icon flaticon2-checking"></i>
                                        <span class="kt-nav__link-text">Rapport</span>
                                    </button>
                                </li>
                                <li class="kt-nav__separator"></li>
                            {% endif %}
                            <li class="kt-nav__head">
                                Aller dans                                   
                                <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="Click to learn more..."></i>
                            </li>
                            <li class="kt-nav__separator"></li>                        
                            <li class="kt-nav__item">
                                <a href="{{ path('activity_list', { 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon-map"></i>
                                    <span class="kt-nav__link-text">Les activités</span>
                                </a>
                            </li>                        
                            <li class="kt-nav__item">
                                <a href="{{ path('report_list', { 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-list"></i>
                                    <span class="kt-nav__link-text">Les rapports</span>
                                </a>
                            </li>                        
                            <li class="kt-nav__item">
                                <a href="{{ path('contribution_list', { 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-group"></i>
                                    <span class="kt-nav__link-text">Les contributeurs</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}


{% block content %}
<!--begin:: Portlet-->
<div class="kt-portlet header_bg_color" style="background-color: {{ project.meta('header_bg_color', '#ffffff') }}">
    <div class="kt-portlet__body">
        <div class="kt-widget kt-widget--user-profile-3">
            <div class="kt-widget__top">
                <div class="kt-widget__media" style="margin-top: 1rem;">
                    <img style="width: 60px;" src="{{ project.picture ? vich_uploader_asset(project, 'pictureFile') : default_picture }}" alt="picture">  
                </div>
                <div class="kt-widget__content">
                    <div class="kt-widget__head">
                        <a href="#" class="kt-widget__title" style="font-size: 2.0rem;">{{ project.title }}</a>
                        {% if is_granted('edit', project) %}
                            <label class="colorpicker" data-id="{{ project.id }}" data-metakey="header_bg_color" data-toggle="kt-tooltip" title="" data-original-title="Changer la couleur de fond">
                                <i class="fa fa-pen" style="float: right;"></i>
                            </label>
                        {% endif %}
                    </div>

                    <div class="kt-widget__subhead" style="padding: 0;">
                        {% if project.contactemail %}
                            <a href="mailto:{{project.contactemail}}"><i class="flaticon2-new-email"></i>{{ project.contactemail }}</a>
                        {% endif %}
                        {% if project.contactphone %}
                            <a href="tel:{{project.contactphone}}"><i class="flaticon2-calendar-3"></i>{{ project.contactphone }}</a>
                        {% endif %}
                        {% if project.contactaddress %}
                            <a href="#"><i class="flaticon2-placeholder"></i>{{ project.contactaddress }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="kt-widget__bottom">
                <div class="kt-widget__item">
                    <div class="kt-widget__icon">
                        <i class="flaticon-event-calendar-symbol"></i>
                    </div>
                    <div class="kt-widget__details">
                        <span class="kt-widget__title">Date de début</span>
                        <span class="kt-widget__value"><span class="btn btn-label-brand btn-sm btn-bold btn-upper">{{ project.startat is empty ? "" : project.startat | date('Y-m-d') }}</span></span>
                    </div>
                </div>

                <div class="kt-widget__item">
                    <div class="kt-widget__icon">
                        <i class="flaticon-event-calendar-symbol"></i>
                    </div>
                    <div class="kt-widget__details">
                        <span class="kt-widget__title">Date de fin</span>
                        <span class="kt-widget__value"><span class="btn btn-label-danger btn-sm btn-bold btn-upper">{{ project.endat is empty ? "" : project.endat | date('Y-m-d') }}</span></span>
                    </div>
                </div>

                {% if project.budget > 0 %}
                    <div class="kt-widget__item">
                        <div class="kt-widget__icon">
                            <i class="flaticon-piggy-bank"></i>
                        </div>
                        <div class="kt-widget__details">
                            <span class="kt-widget__title">Budget</span>
                            <span class="kt-widget__value">{{ project.budget }}</span>
                        </div>
                    </div>
                {% endif  %}

                <div class="kt-widget__item">
                    <div class="kt-widget__icon">
                        <i class="flaticon-map"></i>
                    </div>
                    <div class="kt-widget__details">
                        <span class="kt-widget__title">{{ project.activities.count }} Activités</span>
                        <a href="#activities" class="kt-widget__value kt-font-brand">Voir la liste</a>
                    </div>
                </div>

                <div class="kt-widget__item">
                    <div class="kt-widget__icon">
                        <i class="flaticon-chat-1"></i>
                    </div>
                    <div class="kt-widget__details">
                        <span class="kt-widget__title">{{ reports_count }} Rapports</span>
                        <a href="#reports" class="kt-widget__value kt-font-brand">Voir la liste</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--end:: Portlet-->

<!--begin:: Portlet-->
<div class="kt-portlet description_bg_color" style="background-color: {{ project.meta('description_bg_color', '#ffffff') }};">
    <div class="kt-portlet__body kt-portlet__body--fit">
        <div class="kt-widget kt-widget--project-1">
            <div class="kt-widget__body">
                <span class="kt-widget__text">
                    {{ project.description|html|raw }}                       
                </span>
            </div>
        </div>
    </div>
</div>
<!--end:: Portlet-->
    
<!-- begin: Modal -->
<div class="modal fade" id="kt_modal_activities" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Choisissez une activité pour créer un rapport</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">
                <div class="kt-notification-v2">
                    {% for activity in project.activities.slice(0, 5) %}
                        <a href="{{ path('report_index', { 'activity_id' : activity.id, 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="kt-notification-v2__item">
                            <div class="kt-notification-v2__itek-wrapper">
                                <div class="kt-notification-v2__item-title">
                                    {{ activity.title }}
                                </div>
                                <div class="kt-notification-v2__item-desc">
                                    {{ activity.author.fullname }}
                                </div>
                            </div>	
                        </a>
                    {% else %}
                        Aucunes activités trouvées sur ce projet.
                    {% endfor %}
                </div>  
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- end: Modal -->
    
<div class="row">
    <div class="col-xl-6" id="activities">
        <div class="kt-portlet kt-portlet--height-fluid" style="background-color: rgba(29, 201, 183, 0.1);">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label">
                    <a href="{{ path('activity_list', { 'project_id' : project.id, 'slug': project.author.slug } ) }}">
                        <h3 class="kt-portlet__head-title">Activities</h3>
                    </a>
                </div>
                <div class="kt-portlet__head-toolbar">
                    <a href="{{ path('activity_list', { 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="btn btn-label-primary btn-bold btn-sm">
                        Toutes
                    </a>
                    {% if is_granted('edit', project) %}
                        <a href="{{ path('activity_index', { 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="btn btn-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                    <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                                    <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                                    <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                                </g>
                            </svg>
                        </a>
                    {% endif %}
                </div>
            </div>
            <div class="kt-portlet__body">
                <div class="kt-widget5">
                    {% for activity in project.activities.slice(0, 5) %}
                        {{ include('project/activity.html.twig', { 'activity' : activity } ) }}
                    {% else %}
