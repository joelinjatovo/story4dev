{% block content %}
<!--begin:: Portlet-->
<div class="kt-portlet ">
    <div class="kt-portlet__body">
        <div class="kt-widget kt-widget--user-profile-3">
            <div class="kt-widget__top">
                <div class="kt-widget__media">
                    <img src="{{ project.picture ? vich_uploader_asset(project, 'pictureFile') : default_picture }}" alt="picture">  
                </div>
                <div class="kt-widget__content">
                    <div class="kt-widget__head">
                        <a href="#" class="kt-widget__title">{{ project.title }}</a>

                        <div class="kt-widget__action">
                            <button class="btn btn-brand btn-sm btn-upper" data-toggle="modal" data-target="#kt_modal_activities">Create report</button>
                        </div>
                    </div>

                    <div class="kt-widget__subhead">
                        {% if project.contactemail %}
                            <a href="mailto:{{project.contactemail}}"><i class="flaticon2-new-email"></i>{{ project.contactemail }}</a>
                        {% endif %}
                        {% if project.contactphone %}
                            <a href="tel:{{project.contactphone}}"><i class="flaticon2-calendar-3"></i>{{ project.contactphone }}</a>
                        {% endif %}
                        {% if project.contactaddress %}
                            <a href="#"><i class="flaticon2-placeholder"></i>{{ project.contactaddress }}</a>
                        {% endif %}
                    </div>

                    <div class="kt-widget__info">
                        <div class="kt-widget__desc">
                            {{ project.description|html|raw }}
                        </div>

                        <div class="kt-widget__stats d-flex align-items-center flex-fill">
                            <div class="kt-widget__item">
                                <span class="kt-widget__date">
                                    Date de début
                                </span>
                                <div class="kt-widget__label">
                                    <span class="btn btn-label-brand btn-sm btn-bold btn-upper">{{ project.startat is empty ? "" : project.startat | date('Y-m-d') }}</span>
                                </div>
                            </div>

                            <div class="kt-widget__item">
                                <span class="kt-widget__date">
                                    Date de fin
                                </span>
                                <div class="kt-widget__label">
                                    <span class="btn btn-label-danger btn-sm btn-bold btn-upper">{{ project.endat is empty ? "" : project.endat | date('Y-m-d') }}</span>
                                </div>
                            </div>

                            <div class="kt-widget__item flex-fill">
                                <span class="kt-widget__subtitel">Progression</span>
                                <div class="kt-widget__progress d-flex  align-items-center">
                                    <div class="progress" style="height: 5px;width: 100%;">
                                        <div class="progress-bar kt-bg-success" role="progressbar" style="width: 78%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="kt-widget__stat">
                                        78%
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="kt-widget__bottom">
                {% if project.budget > 0 %}
                    <div class="kt-widget__item">
                        <div class="kt-widget__icon">
                            <i class="flaticon-piggy-bank"></i>
                        </div>
                        <div class="kt-widget__details">
                            <span class="kt-widget__title">Budget</span>
                            <span class="kt-widget__value"><span>$</span>{{ project.budget }}</span>
                        </div>
                    </div>
                {% endif %}

                <div class="kt-widget__item">
                    <div class="kt-widget__icon">
                        <i class="flaticon-file-2"></i>
                    </div>
                    <div class="kt-widget__details">
                        <span class="kt-widget__title">{{ project.activities.count }} Activities</span>
                        <a href="{{ path( 'activity_list', { 'slug': project.author.slug, 'project_id': project.id } ) }}" class="kt-widget__value kt-font-brand">View</a>
                    </div>
                </div>

                <div class="kt-widget__item">
                    <div class="kt-widget__icon">
                        <i class="flaticon-chat-1"></i>
                    </div>
                    <div class="kt-widget__details">
                        <span class="kt-widget__title">--- Reports</span>
                        <a href="{{ path( 'report_list', { 'slug': project.author.slug, 'project_id': project.id } ) }}" class="kt-widget__value kt-font-brand">View</a>
                    </div>
                </div>

                <div class="kt-widget__item">
                    <div class="kt-widget__icon">
                        <i class="flaticon-network"></i>
                    </div>
                    <div class="kt-widget__details">
                        <div class="kt-section__content kt-section__content--solid">
                            <div class="kt-badge kt-badge__pics">
                                {% for contribution in project.contributions.slice(0, 7) %}
                                <a href="{{ path('user_show', { 'slug': contribution.user.slug }) }}" class="kt-badge__pic" data-toggle="kt-tooltip" data-skin="brand" data-placement="top" title="" data-original-title="{{ contribution.user.fullname ?? contribution.user.email }}">
                                    <img src="{{ contribution.user.avatar is null ? default_avatar : contribution.user.avatar }}" alt="avatar">
                                </a>
                                {% endfor %}
                                {% if project.contributions.count > 7 %}
                                    <a href="#" class="kt-badge__pic kt-badge__pic--last kt-font-brand">
                                        +{{ project.contributions.count - 7 }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--end:: Portlet-->
    
<!-- begin: Modal -->
<div class="modal fade" id="kt_modal_activities" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Choisissez une activité pour créer un rapport</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">
                <div class="kt-notification-v2">
                    {% for activity in project.activities %}
                        <a href="{{ path('report_index', { 'activity_id' : activity.id, 'project_id' : project.id, 'slug': project.author.slug } ) }}" class="kt-notification-v2__item">
                            <div class="kt-notification-v2__itek-wrapper">
                                <div class="kt-notification-v2__item-title">
                                    {{ activity.title }}
                                </div>
                                <div class="kt-notification-v2__item-desc">
                                    {{ activity.author.fullname }}
                                </div>
                            </div>	
                        </a>
                    {% else %}
                        Aucunes activités trouvées sur ce projet.
                    {% endfor %}
                </div>  
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- end: Modal -->
    
