{% extends 'base.html.twig' %}

{% block title %}Mes Projects - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            {% if project is defined and project is not null and ( project.id > 0 ) %}
                <h3 class="kt-subheader__title">Sous projects</h3>
            {% else %}
                <h3 class="kt-subheader__title">Mes projects</h3>
            {% endif %}
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__group" id="kt_subheader_search">
                <span class="kt-subheader__desc" id="kt_subheader_total">{{ projects.count }} Total</span>
            </div>
        </div>        
        <div class="kt-subheader__toolbar">
            {% if project is defined and project is not null and ( project.id > 0 ) %}
                <a href="{{ path('project_index', {slug: project.slug}) }}" class="btn btn-label-brand btn-bold">Ajouter</a>
            {% elseif is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_project_index') }}" class="btn btn-label-brand btn-bold">Ajouter</a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
    {% for item in projects %}
        <div class="col-xl-6">
            {{ include('project/_list_item.html.twig', {'project': item}) }}
        </div>
    {% endfor %}
</div>
    
<div class="row">
    <div class="col-xl-12">       
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': projects}) }}
                </div>
            </div>
        </div>
    </div>           
</div>
{% endblock %}


{% block javascripts %}
<script type="text/javascript">
jQuery(document).ready(function($){
    $(document).on('click', '.btn-remove', function(e){
        e.preventDefault();
        var $this = $(this);
            swal.fire({
                title:"Vous êtes sûre?",
                text:"Vous ne pourez pas revenir en arrière après!",
                type:"warning",
                showCancelButton:!0,
                confirmButtonText:"Oui, supprimez le!",
                cancelButtonText:"Annuler"
            }).then(function(e){
                if(e.value){
                    KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
                    $.post("/project/remove", { id: $this.attr('data-id') })
                    .done(function( data ) {
                        KTApp.unblockPage();
                        if(data.success){
                            $this.closest('.project-item').remove();
                            toastr.success(data.message);
                        }else{
                            toastr.error(data.message, data.title);
                        }
                    })
                    .fail(function() {
                        KTApp.unblockPage();
                        toastr.error("Une erreur s'est produite. Veuillez réesayer plus tard!");
                    });
                }
            })
    });
    
});
</script>
{% endblock %}
