{% extends 'base.html.twig' %}

{% block title %}{% trans %}projects{% endtrans %} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}my.projects{% endtrans %}</h3>
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__group" id="kt_subheader_search">
                <span class="kt-subheader__desc" id="kt_subheader_total">{{ projects.count }} Total</span>
            </div>
        </div>        
        <div class="kt-subheader__toolbar">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_project_index') }}" class="btn btn-label-brand btn-bold">{% trans %}button.add{% endtrans %}</a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
    {% for item in projects %}
        <div class="col-xl-6">
            {{ include('project/_list_item.html.twig', {'project': item}) }}
        </div>
    {% endfor %}
</div>
    
<div class="row">
    <div class="col-xl-12">       
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': projects}) }}
                </div>
            </div>
        </div>
    </div>           
</div>
{% endblock %}

{% block javascripts %}
<script type="text/javascript">
jQuery(document).ready(function($){
    $(document).on('click', '.btn-remove', function(e){
        e.preventDefault();
        var $this = $(this);
            swal.fire({
                title:"{% trans %}swal.remove.title{% endtrans %}",
                text:"{% trans %}swal.remove.content.indicator{% endtrans %}",
                type:"warning",
                showCancelButton:!0,
                confirmButtonText:"{% trans %}button.confirm.delete1{% endtrans %}",
                cancelButtonText:"{% trans %}button.cancel{% endtrans %}"
            }).then(function(e){
                if(e.value){
                    KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
                    $.post("/project/remove", { id: $this.attr('data-id') })
                    .done(function( data ) {
                        KTApp.unblockPage();
                        if(data.success){
                            $this.closest('.project-item').remove();
                            toastr.success(data.message);
                        }else{
                            toastr.error(data.message, data.title);
                        }
                    })
                    .fail(function() {
                        KTApp.unblockPage();
                        toastr.error("{% trans %}swal.error{% endtrans %}");
                    });
                }
            })
    });
});
</script>
{% endblock %}