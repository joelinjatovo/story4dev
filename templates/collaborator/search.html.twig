{% for user in users %}
     <a href="javascript:void;" class="kt-notification-v2__item add-contributor" data-project="{{ project.id }}" data-id="{{ user.id }}">
        <div class="kt-notification-v2__itek-wrapper">
            <div class="kt-notification-v2__item-title">
                {{ user.fullname }}
            </div>
            <div class="kt-notification-v2__item-desc">
                {{ user.title is not null ? user.title : user.email }}
            </div>
        </div>	
    </a>
{% else %}
    <li>No user found</li>
{% endfor %}
