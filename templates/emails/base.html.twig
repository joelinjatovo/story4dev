<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <title>Story4Dev</title>
    </head>
    <body>
        <div style="background:#f2f2f2">
            <div style="background-color:#f2f2f2">
                <table role="presentation" cellpadding="0" cellspacing="0" style="background:#139af4;font-size:0px;width:100%" border="0">
                    <tbody>
                        <tr>
                            <td>
                                <div style="margin:0px auto;max-width:600px">
                                    <table role="presentation" cellpadding="0" cellspacing="0" style="font-size:0px;width:100%" align="center" border="0">
                                        <tbody>
                                            <tr>
                                                <td style="text-align:center;vertical-align:middle;direction:ltr;font-size:0px;padding:0px">
                                                    <div style="vertical-align:middle;display:inline-block;direction:ltr;font-size:13px;text-align:left;width:100%">
                                                        <table role="presentation" cellpadding="0" cellspacing="0" style="vertical-align:middle" width="100%" border="0">
                                                            <tbody>
                                                                <tr>
                                                                    <td style="word-wrap:break-word;font-size:0px;padding:10px 25px;padding-top:40px;padding-bottom:30px" align="center">
                                                                        <div style="color:#fff;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:17px;font-weight:400;line-height:24px;text-align:center">Merci d'avoir utilisé <a href="{{ url('app_index') }}" style="color:#fff;text-decoration:none;font-weight:bold" target="_blank"><span class="il">Story4Dev</span>.com</a></div>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div style="vertical-align:middle;display:inline-block;direction:ltr;font-size:13px;text-align:left;width:100%">
                                                        <table role="presentation" cellpadding="0" cellspacing="0" style="vertical-align:middle" width="100%" border="0">
                                                            <tbody>
                                                                <tr>
                                                                    <td style="word-wrap:break-word;font-size:0px;padding:0px;padding-top:20px" align="center">
                                                                        <table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border-spacing:0px" align="center" border="0">
                                                                            <tbody>
                                                                                <tr>
                                                                                    <td style="width:600px"><img alt="bottom border" title="" height="auto" src="{{ absolute_url(asset('images/top-digest.png')) }}" style="border:none;border-radius:0px;display:block;font-size:13px;outline:none;text-decoration:none;width:100%;height:auto" width="600" ></td>
                                                                                </tr>
                                                                            </tbody>
                                                                        </table>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                
                {% block content %}{% endblock %}

                <div style="margin:0px auto;max-width:600px;background:#f2f2f2f2">
                    <table role="presentation" cellpadding="0" cellspacing="0" style="font-size:0px;width:100%;background:#f2f2f2f2" align="center" border="0">
                        <tbody>
                            <tr>
                                <td style="text-align:center;vertical-align:top;direction:ltr;font-size:0px;padding:0px">
                                    <div style="vertical-align:top;display:inline-block;direction:ltr;font-size:13px;text-align:left;width:100%">
                                        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" border="0">
                                            <tbody>
                                                <tr>
                                                    <td style="word-wrap:break-word;font-size:0px;padding:0px" align="center">
                                                        <table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border-spacing:0px" align="center" border="0">
                                                            <tbody>
                                                                <tr>
                                                                    <td style="width:600px"><img alt="" title="" height="auto" src="{{ absolute_url(asset('images/bottom-mail.png')) }}" style="border:none;border-radius:0px;font-size:13px;outline:none;text-decoration:none;width:100%;height:auto" width="600" class="m_-657351041605768385hide-mobile CToWUd"></td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div style="margin:0px auto;max-width:600px">
                    <table role="presentation" cellpadding="0" cellspacing="0" style="font-size:0px;width:100%" align="center" border="0">
                        <tbody>
                            <tr>
                                <td style="text-align:center;vertical-align:top;direction:ltr;font-size:0px;padding:20px 0px 20px 0px">
                                    <div style="vertical-align:top;display:inline-block;direction:ltr;font-size:13px;text-align:left;width:100%">
                                        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" border="0">
                                            <tbody>
                                                <tr>
                                                    {% if user is defined %}
                                                    <td style="word-wrap:break-word;font-size:0px;padding:10px 25px" align="center">
                                                        <div style="color:#9b9b9b;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:11px;font-weight:400;line-height:24px;text-align:center">
                                                          <br>Membre n°{{ user.id }} - <a href="mailto:{{ user.email }}" target="_blank">{{ user.email }}</a><br>
                                                        </div>
                                                    </td>
                                                    {% endif %}
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </body>
</html>