{% extends 'emails/base.html.twig' %}

{% block content %}
<div style="margin:0px auto;max-width:600px;background:#fff">
    <table role="presentation" cellpadding="0" cellspacing="0" style="font-size:0px;width:100%;background:#fff" align="center" border="0">
        <tbody>
            <tr>
                <td style="text-align:center;vertical-align:top;direction:ltr;font-size:0px;padding:0px">
                    <div style="vertical-align:top;display:inline-block;direction:ltr;font-size:13px;text-align:left;width:100%">
                        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" border="0">
                            <tbody>
                                <tr>
                                    <td style="word-wrap:break-word;font-size:0px;padding:5px 20px" align="left">
                                        <div style="color:#000000;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;font-weight:400;line-height:24px;text-align:left">
                                          <a style="color:#1572b0;font-weight:500;font-size:17px;line-height:20px;text-decoration:none" target="_blank"> Bonjour,
                                          </a>
                                          <p style="font-size:15px;color:#585858;line-height:20px">Un utilisateur vient de se connecter sur le site Story4Dev avec les informations suivantes:</p>
                                          
                                          <p style="font-size:15px;color:#585858;line-height:20px"><strong>Date :</strong> {{ "now"|date("Y-m-d H:i:s") }}</p>
                                          <p style="font-size:15px;color:#585858;line-height:20px"><strong>Nom :</strong> {{ user.fullname }}</p>
                                          <p style="font-size:15px;color:#585858;line-height:20px"><strong>Email :</strong> {{ user.email }}</p>
                                          <p style="font-size:15px;color:#585858;line-height:20px"><strong>Browser :</strong> {{ app.request.headers.get('User-Agent')}} </p>
                                          <p style="font-size:15px;color:#585858;line-height:20px"><strong>IP :</strong> {{ app.request.server.get("REMOTE_ADDR") }}</p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</div>
{% endblock %}