<!-- begin:: Header -->
<div id="kt_header" class="kt-header kt-grid kt-grid--ver  kt-header--fixed " >
    <!-- begin: Header Menu -->
    <button class="kt-header-menu-wrapper-close" id="kt_header_menu_mobile_close_btn"><i class="la la-close"></i></button>
    <div class="kt-header-menu-wrapper kt-grid__item kt-grid__item--fluid" id="kt_header_menu_wrapper">
        <div id="kt_header_menu" class="kt-header-menu kt-header-menu-mobile  kt-header-menu--layout- "  >
            <ul class="kt-menu__nav ">
                {% if is_granted('ROLE_USER') %}
                    <li class="kt-menu__item"  aria-haspopup="true">
                        <div class="dropdown">
                            <button type="button" class="btn btn-pill {% if project is defined and project is not null and ( project.id > 0 ) %}btn-brand{% else %}btn-default{% endif %} dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                {% if project is defined and project is not null and ( project.id > 0 ) %}
                                    {{ project.title }}
                                {% else %}
                                    {% trans %}my.projects{% endtrans %}
                                {% endif %}
                            </button>
                            <div class="dropdown-menu dropdown-menu-fit dropdown-menu-md" style="">
                                <ul class="kt-nav kt-nav--bold kt-nav--md-space kt-margin-t-20 kt-margin-b-20">
                                    {% for project in header.myprojects(app.user) %}
                                        <li class="kt-nav__item">
                                            <a class="kt-nav__link active" href="{{ path('project_show', { slug : project.slug}) }}">
                                                <span class="kt-nav__link-icon">
                                                    <img width="25px" height="25px" alt="avatar" src="{{ project.picture ? vich_uploader_asset(project, 'pictureFile') | imagine_filter('thumb') : default_picture }}">
                                                </span>
                                                <span class="kt-nav__link-text">{{ project.title }}</span>
                                            </a>
                                        </li>
                                    {% else %}
                                        <li class="kt-nav__item">
                                            <a class="kt-nav__link active" href="#">
                                                <span class="kt-nav__link-icon"><i class="flaticon2-user"></i></span>
                                                <span class="kt-nav__link-text">{% trans %}header.no.projects{% endtrans %}</span>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
    <!-- end: Header Menu -->

    <!-- begin:: Header Topbar -->
    <div class="kt-header__topbar">
        {% if is_granted('ROLE_ADMIN') %}
            <div class="kt-header__topbar-item dropdown">
                <div class="kt-header__topbar-wrapper" data-toggle="dropdown" data-offset="10px,0px">
                    <span class="kt-header__topbar-icon kt-header__topbar-icon--warning"><i class="flaticon2-gear"></i></span>
                </div>
                <div class="dropdown-menu dropdown-menu-fit dropdown-menu-right dropdown-menu-anim dropdown-menu-xl">
                    <form>
                        <div class="kt-head kt-head--skin-light">
                            <h3 class="kt-head__title">
                                {% trans %}button.actions{% endtrans %}
                            </h3>
                        </div>
                        <div class="kt-grid-nav kt-grid-nav--skin-light">
                            <div class="kt-grid-nav__row">
                                <a href="{{ path('admin_user_list') }}" class="kt-grid-nav__item">
                                    <span class="kt-grid-nav__icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--lg">
                                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                <polygon id="Shape" points="0 0 24 0 24 24 0 24"/>
                                                <path d="M18,14 C16.3431458,14 15,12.6568542 15,11 C15,9.34314575 16.3431458,8 18,8 C19.6568542,8 21,9.34314575 21,11 C21,12.6568542 19.6568542,14 18,14 Z M9,11 C6.790861,11 5,9.209139 5,7 C5,4.790861 6.790861,3 9,3 C11.209139,3 13,4.790861 13,7 C13,9.209139 11.209139,11 9,11 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"/>
                                                <path d="M17.6011961,15.0006174 C21.0077043,15.0378534 23.7891749,16.7601418 23.9984937,20.4 C24.0069246,20.5466056 23.9984937,21 23.4559499,21 L19.6,21 C19.6,18.7490654 18.8562935,16.6718327 17.6011961,15.0006174 Z M0.00065168429,20.1992055 C0.388258525,15.4265159 4.26191235,13 8.98334134,13 C13.7712164,13 17.7048837,15.2931929 17.9979143,20.2 C18.0095879,20.3954741 17.9979143,21 17.2466999,21 C13.541124,21 8.03472472,21 0.727502227,21 C0.476712155,21 -0.0204617505,20.45918 0.00065168429,20.1992055 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero"/>
                                            </g>
                                        </svg>
                                    </span>
                                    <span class="kt-grid-nav__title">{% trans %}users{% endtrans %}</span>
                                    <span class="kt-grid-nav__desc">{% trans %}lists{% endtrans %}</span>
                                </a>
                                <a href="{{ path('admin_index') }}" class="kt-grid-nav__item">
                                    <span class="kt-grid-nav__icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--lg">
                                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                <rect id="bound" x="0" y="0" width="24" height="24"/>
                                                <path d="M14.8571499,13 C14.9499122,12.7223297 15,12.4263059 15,12.1190476 L15,6.88095238 C15,5.28984632 13.6568542,4 12,4 L11.7272727,4 C10.2210416,4 9,5.17258756 9,6.61904762 L10.0909091,6.61904762 C10.0909091,5.75117158 10.823534,5.04761905 11.7272727,5.04761905 L12,5.04761905 C13.0543618,5.04761905 13.9090909,5.86843034 13.9090909,6.88095238 L13.9090909,12.1190476 C13.9090909,12.4383379 13.8240964,12.7385644 13.6746497,13 L10.3253503,13 C10.1759036,12.7385644 10.0909091,12.4383379 10.0909091,12.1190476 L10.0909091,9.5 C10.0909091,9.06606198 10.4572216,8.71428571 10.9090909,8.71428571 C11.3609602,8.71428571 11.7272727,9.06606198 11.7272727,9.5 L11.7272727,11.3333333 L12.8181818,11.3333333 L12.8181818,9.5 C12.8181818,8.48747796 11.9634527,7.66666667 10.9090909,7.66666667 C9.85472911,7.66666667 9,8.48747796 9,9.5 L9,12.1190476 C9,12.4263059 9.0500878,12.7223297 9.14285008,13 L6,13 C5.44771525,13 5,12.5522847 5,12 L5,3 C5,2.44771525 5.44771525,2 6,2 L18,2 C18.5522847,2 19,2.44771525 19,3 L19,12 C19,12.5522847 18.5522847,13 18,13 L14.8571499,13 Z" id="Combined-Shape" fill="#000000" opacity="0.3"/>
                                                <path d="M9,10.3333333 L9,12.1190476 C9,13.7101537 10.3431458,15 12,15 C13.6568542,15 15,13.7101537 15,12.1190476 L15,10.3333333 L20.2072547,6.57253826 C20.4311176,6.4108595 20.7436609,6.46126971 20.9053396,6.68513259 C20.9668779,6.77033951 21,6.87277228 21,6.97787787 L21,17 C21,18.1045695 20.1045695,19 19,19 L5,19 C3.8954305,19 3,18.1045695 3,17 L3,6.97787787 C3,6.70173549 3.22385763,6.47787787 3.5,6.47787787 C3.60510559,6.47787787 3.70753836,6.51099993 3.79274528,6.57253826 L9,10.3333333 Z M10.0909091,11.1212121 L12,12.5 L13.9090909,11.1212121 L13.9090909,12.1190476 C13.9090909,13.1315697 13.0543618,13.952381 12,13.952381 C10.9456382,13.952381 10.0909091,13.1315697 10.0909091,12.1190476 L10.0909091,11.1212121 Z" id="Combined-Shape" fill="#000000"/>
                                            </g>
                                        </svg>
                                    </span>
                                    <span class="kt-grid-nav__title">{% trans %}administration{% endtrans %}</span>
                                    <span class="kt-grid-nav__desc">{% trans %}console{% endtrans %}</span>
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        {% endif %}

        <div class="kt-header__topbar-item kt-header__topbar-item--langs kt-hidden">
            <div class="kt-header__topbar-wrapper" data-toggle="dropdown" data-offset="10px,0px">
                <span class="kt-header__topbar-icon kt-header__topbar-icon--brand">
                    <img class="" src="{{ asset('images/flag/flag-en.svg') }}" alt="" />
                </span>	
            </div>
            <div class="dropdown-menu dropdown-menu-fit dropdown-menu-right dropdown-menu-anim">
                <ul class="kt-nav kt-margin-t-10 kt-margin-b-10">
                    <li class="kt-nav__item kt-nav__item--active">
                        <a href="#" class="kt-nav__link">
                            <span class="kt-nav__link-icon"><img src="{{ asset('images/flag/flag-usa.svg') }}" alt="" /></span>
                            <span class="kt-nav__link-text">English</span>
                        </a>
                    </li>
                    <li class="kt-nav__item">
                        <a href="#" class="kt-nav__link">
                            <span class="kt-nav__link-icon"><img src="{{ asset('images/flag/flag-spain.svg') }}" alt="" /></span>
                            <span class="kt-nav__link-text">Spanish</span>
                        </a>
                    </li>
                    <li class="kt-nav__item">
                        <a href="#" class="kt-nav__link">
                            <span class="kt-nav__link-icon"><img src="{{ asset('images/flag/flag-germany.svg') }}" alt="" /></span>
                            <span class="kt-nav__link-text">German</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        {% if is_granted('ROLE_USER') %}
            <div class="kt-header__topbar-item kt-header__topbar-item--user">
                <div class="kt-header__topbar-wrapper" data-toggle="dropdown" data-offset="10px,0px">			
                    <span class="kt-hidden kt-header__topbar-welcome">Hi,</span>
                    <span class="kt-hidden kt-header__topbar-username">{{ app.user.username }}</span>
                    <img class="kt-hidden" alt="avatar" src="{{ app.user.avatar is null ? default_avatar : vich_uploader_asset(app.user, 'avatarFile') }}"/>
                    <span class="kt-header__topbar-icon"><i class="flaticon-avatar"></i></span>
                </div>
                <div class="dropdown-menu dropdown-menu-fit dropdown-menu-right dropdown-menu-anim dropdown-menu-xl">
                    <div class="kt-user-card kt-user-card--skin-light kt-notification-item-padding-x">
                        <div class="kt-user-card__avatar">
                            <img class="kt-hidden-" alt="avatar" src="{{ app.user.avatar is null ? default_avatar : vich_uploader_asset(app.user, 'avatarFile') }}" />
                            <!--use below badge element instead the user avatar to display username's first letter(remove kt-hidden class to display it) -->
                            <span class="kt-badge kt-badge--username kt-badge--unified-success kt-badge--lg kt-badge--rounded kt-badge--bold kt-hidden">S</span>
                        </div>
                        <div class="kt-user-card__name">
                            {{ app.user.fullname }}
                        </div>
                        <div class="kt-user-card__badge kt-hidden">
                            <span class="btn btn-label-primary btn-sm btn-bold btn-font-md">23 messages</span>
                        </div>
                    </div>

                    <div class="kt-notification">
                        <a href="{{ path('account_profile') }}" class="kt-notification__item">
                            <div class="kt-notification__item-icon">
                                <i class="flaticon2-calendar-3 kt-font-success"></i>
                            </div>
                            <div class="kt-notification__item-details">
                                <div class="kt-notification__item-title kt-font-bold">
                                    {% trans %}my.profil{% endtrans %}
                                </div>
                                <div class="kt-notification__item-time">
                                    {% trans %}settings.profil{% endtrans %}
                                </div>
                            </div>
                        </a>
                        <a href="{{ path('project_list') }}" class="kt-notification__item">
                            <div class="kt-notification__item-icon">
                                <i class="flaticon2-mail kt-font-warning"></i>
                            </div>
                            <div class="kt-notification__item-details">
                                <div class="kt-notification__item-title kt-font-bold">
                                    {% trans %}my.projects{% endtrans %}
                                </div>
                                <div class="kt-notification__item-time">
                                    {% trans %}header.projects.subtitle{% endtrans %}
                                </div>
                            </div>
                        </a>
                        <a href="{{ path('account_reports', { slug: app.user.slug } ) }}" class="kt-notification__item">
                            <div class="kt-notification__item-icon">
                                <i class="flaticon2-rocket-1 kt-font-danger"></i>
                            </div>
                            <div class="kt-notification__item-details">
                                <div class="kt-notification__item-title kt-font-bold">
                                    {% trans %}my.reports{% endtrans %}
                                </div>
                                <div class="kt-notification__item-time">
                                    {% trans %}header.reports.subtitle{% endtrans %}
                                </div>
                            </div>
                        </a>
                        <a href="{{ path('file_list') }}" class="kt-notification__item">
                            <div class="kt-notification__item-icon">
                                <i class="flaticon2-hourglass kt-font-brand"></i>
                            </div>
                            <div class="kt-notification__item-details">
                                <div class="kt-notification__item-title kt-font-bold">
                                    {% trans %}my.files{% endtrans %}
                                </div>
                                <div class="kt-notification__item-time">
                                    {% trans %}header.files.subtitle{% endtrans %}
                                </div>
                            </div>
                        </a>
                        <div class="kt-notification__custom kt-space-between">
                            <a href="{{ path('app_logout') }}"class="btn btn-label btn-label-brand btn-sm btn-bold">{% trans %}button.logout{% endtrans %}</a>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
    <!-- end:: Header Topbar -->
</div>
<!-- end:: Header -->