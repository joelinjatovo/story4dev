<!-- begin:: Header -->
<div id="kt_header" class="kt-header kt-grid kt-grid--ver  kt-header--fixed " >
    <!-- begin: Header Menu -->
    <button class="kt-header-menu-wrapper-close" id="kt_header_menu_mobile_close_btn"><i class="la la-close"></i></button>
    <div class="kt-header-menu-wrapper kt-grid__item kt-grid__item--fluid" id="kt_header_menu_wrapper">
        <div id="kt_header_menu" class="kt-header-menu kt-header-menu-mobile  kt-header-menu--layout- "  >
            <ul class="kt-menu__nav ">
                {% if is_granted('ROLE_USER') %}
                    <li class="kt-menu__item"  aria-haspopup="true">
                        <div class="dropdown">
                            <button type="button" class="btn btn-pill {% if project is defined and project is not null and ( project.id > 0 ) %}btn-brand{% else %}btn-default{% endif %} dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                {% if project is defined and project is not null and ( project.id > 0 ) %}
                                    {{ project.title }}
                                {% else %}
                                    {% trans %}my.projects{% endtrans %}
                                {% endif %}
                            </button>
                            <div class="dropdown-menu dropdown-menu-fit dropdown-menu-md" style="">
                                <ul class="kt-nav kt-nav--bold kt-nav--md-space kt-margin-t-20 kt-margin-b-20">
                                    {% for project in header.myprojects(app.user) %}
                                        <li class="kt-nav__item">
                                            <a class="kt-nav__link active" href="{{ path('project_show', { slug : project.slug}) }}">
                                                <span class="kt-nav__link-icon">
                                                    <img width="25px" height="25px" alt="avatar" src="{{ project.picture ? vich_uploader_asset(project, 'pictureFile') | imagine_filter('thumb') : default_picture }}">
                                                </span>
                                                <span class="kt-nav__link-text">{{ project.title }}</span>
                                            </a>
                                        </li>
                                    {% else %}
                                        <li class="kt-nav__item">
                                            <a class="kt-nav__link active" href="#">
                                                <span class="kt-nav__link-icon"><i class="flaticon2-user"></i></span>
                                                <span class="kt-nav__link-text">{% trans %}header.no.projects{% endtrans %}</span>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
    <!-- end: Header Menu -->

    <!-- begin:: Header Topbar -->
    <div class="kt-header__topbar">
        {% set _currentRoute  = app.request.attributes.get('_route') %}
        {% set _currentParams = app.request.attributes.get('_route_params') %}
        {% set _currentLocale = _currentParams['_locale'] ?: 1 %}
        <div class="kt-header__topbar-item kt-header__topbar-item--langs">
            <div class="kt-header__topbar-wrapper" data-toggle="dropdown" data-offset="10px,0px">
                <span class="kt-header__topbar-icon kt-header__topbar-icon--brand">
                    {% if _currentLocale == 'en' %}
                        <img class="" src="{{ asset('images/flag/flag-en.svg') }}" alt="" />
                    {% else %}
                        <img class="" src="{{ asset('images/flag/flag-france.svg') }}" alt="" />
                    {% endif %}
                </span>	
            </div>
            <div class="dropdown-menu dropdown-menu-fit dropdown-menu-right dropdown-menu-anim">
                <ul class="kt-nav kt-margin-t-10 kt-margin-b-10">
                    <li class="kt-nav__item {{ _currentLocale == 'fr' ? 'kt-nav__item--active' : '' }}">
                        <a href="{{ path(_currentRoute, _currentParams|merge({_locale: 'fr'})) }}" class="kt-nav__link">
                            <span class="kt-nav__link-icon"><img src="{{ asset('images/flag/flag-france.svg') }}" alt="" /></span>
                            <span class="kt-nav__link-text">France</span>
                        </a>
                    </li>
                    <li class="kt-nav__item {{ _currentLocale == 'en' ? 'kt-nav__item--active' : '' }}">
                        <a href="{{ path(_currentRoute, _currentParams|merge({_locale: 'en'})) }}" class="kt-nav__link">
                            <span class="kt-nav__link-icon"><img src="{{ asset('images/flag/flag-en.svg') }}" alt="" /></span>
                            <span class="kt-nav__link-text">English</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        {% if is_granted('ROLE_USER') %}
            <div class="kt-header__topbar-item kt-header__topbar-item--user">
                <div class="kt-header__topbar-wrapper" data-toggle="dropdown" data-offset="10px,0px">			
                    <span class="kt-hidden kt-header__topbar-welcome">Hi,</span>
                    <span class="kt-hidden kt-header__topbar-username">{{ app.user.username }}</span>
                    <img class="kt-hidden" alt="avatar" src="{{ app.user.avatar is null ? default_avatar : vich_uploader_asset(app.user, 'avatarFile') }}"/>
                    <span class="kt-header__topbar-icon"><i class="flaticon-avatar"></i></span>
                </div>
                <div class="dropdown-menu dropdown-menu-fit dropdown-menu-right dropdown-menu-anim dropdown-menu-xl">
                    <div class="kt-user-card kt-user-card--skin-light kt-notification-item-padding-x">
                        <div class="kt-user-card__avatar">
                            <img class="kt-hidden-" alt="avatar" src="{{ app.user.avatar is null ? default_avatar : vich_uploader_asset(app.user, 'avatarFile') }}" />
                            <!--use below badge element instead the user avatar to display username's first letter(remove kt-hidden class to display it) -->
                            <span class="kt-badge kt-badge--username kt-badge--unified-success kt-badge--lg kt-badge--rounded kt-badge--bold kt-hidden">S</span>
                        </div>
                        <div class="kt-user-card__name">
                            {{ app.user.fullname }}
                        </div>
                        <div class="kt-user-card__badge kt-hidden">
                            <span class="btn btn-label-primary btn-sm btn-bold btn-font-md">23 messages</span>
                        </div>
                    </div>

                    <div class="kt-notification">
                        <a href="{{ path('account_profile') }}" class="kt-notification__item">
                            <div class="kt-notification__item-icon">
                                <i class="flaticon2-calendar-3 kt-font-success"></i>
                            </div>
                            <div class="kt-notification__item-details">
                                <div class="kt-notification__item-title kt-font-bold">
                                    {% trans %}my.profil{% endtrans %}
                                </div>
                                <div class="kt-notification__item-time">
                                    {% trans %}settings.profil{% endtrans %}
                                </div>
                            </div>
                        </a>
                        <a href="{{ path('project_list') }}" class="kt-notification__item">
                            <div class="kt-notification__item-icon">
                                <i class="flaticon2-mail kt-font-warning"></i>
                            </div>
                            <div class="kt-notification__item-details">
                                <div class="kt-notification__item-title kt-font-bold">
                                    {% trans %}my.projects{% endtrans %}
                                </div>
                                <div class="kt-notification__item-time">
                                    {% trans %}header.projects.subtitle{% endtrans %}
                                </div>
                            </div>
                        </a>
                        <a href="{{ path('account_reports', { slug: app.user.slug } ) }}" class="kt-notification__item">
                            <div class="kt-notification__item-icon">
                                <i class="flaticon2-rocket-1 kt-font-danger"></i>
                            </div>
                            <div class="kt-notification__item-details">
                                <div class="kt-notification__item-title kt-font-bold">
                                    {% trans %}my.reports{% endtrans %}
                                </div>
                                <div class="kt-notification__item-time">
                                    {% trans %}header.reports.subtitle{% endtrans %}
                                </div>
                            </div>
                        </a>
                        <a href="{{ path('file_list') }}" class="kt-notification__item">
                            <div class="kt-notification__item-icon">
                                <i class="flaticon2-hourglass kt-font-brand"></i>
                            </div>
                            <div class="kt-notification__item-details">
                                <div class="kt-notification__item-title kt-font-bold">
                                    {% trans %}my.files{% endtrans %}
                                </div>
                                <div class="kt-notification__item-time">
                                    {% trans %}header.files.subtitle{% endtrans %}
                                </div>
                            </div>
                        </a>
                        <div class="kt-notification__custom kt-space-between">
                            <a href="{{ path('app_logout') }}"class="btn btn-label btn-label-brand btn-sm btn-bold">{% trans %}button.logout{% endtrans %}</a>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
    <!-- end:: Header Topbar -->
</div>
<!-- end:: Header -->