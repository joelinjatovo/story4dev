{% set _currentPage = app.request.attributes.get('_route_params')['page'] ?: 1 %}
{% set _currentRoute = app.request.attributes.get('_route') %}
{% set _currentParams = app.request.query.all %}

{% if pagination.count > 0 %}
    <ul class="kt-pagination__links">
        {% if _currentPage > 1 %}
            <li class="kt-pagination__link--first">
                <a href="{{ path(_currentRoute, _currentParams|merge({'page': 1})) }}">
                    <<
                </a>
            </li>
            <li class="kt-pagination__link--next">
                <a href="{{ path(_currentRoute, _currentParams|merge({'page': _currentPage-1})) }}">
                    <
                </a>
            </li>
        {% endif %}

        {# Affichage de toutes les pages entre p-4 et p+4 sauf si < 1 ou > nbPages #}
        {% for p in range(max(_currentPage-4, 1), min(_currentPage+4, pagination.count)) %}
            <li {% if p == _currentPage %}class="kt-pagination__link--active"{% endif %}>
                <a href="{{ path(_currentRoute, _currentParams|merge({'page': p})) }}">
                    {{ p }}
                </a>
            </li>
        {% endfor %}

        {% if _currentPage < pagination.count %}
            <li class="kt-pagination__link--prev">
                <a href="{{ path(_currentRoute, _currentParams|merge({'page': _currentPage+1})) }}">
                    >
                </a>
            </li>
            <li class="kt-pagination__link--last">
                <a href="{{ path(_currentRoute, _currentParams|merge({'page': pagination.count})) }}">
                    >>
                </a>
            </li>
        {% endif %}
    </ul>
    <div class="kt-pagination__toolbar">
        <select class="form-control kt-font-brand" style="width: 60px">
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="30">30</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
        <span class="pagination__desc">
            Displaying 10 of 230 records
        </span>
    </div>
{% endif %}