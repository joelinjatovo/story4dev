<div style="visibility:hidden; opacity:0; display: none;" class="dropzone-container" aria-modal="true" role="dialog">
    <button class="btn-close" type="button" aria-label="Close Modal" title="Close Modal"><span aria-hidden="true">×</span></button>
    <div class="file-selector-inner">
        <div class="kt-portlet kt-portlet--tabs">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-toolbar">
                    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x nav-tabs-line-right" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-toggle="tab" href="#dropzone_upload" role="tab">
                                <i class="fa fa-calendar-check-o" aria-hidden="true"></i>Téléchargement
                            </a>
                        </li>
                        <li class="nav-item">
                            <a id="btn-dropzone-select" class="nav-link" data-toggle="tab" href="#dropzone_select" role="tab">
                                <i class="fa fa-bar-chart" aria-hidden="true"></i>Selection
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="kt-portlet__body" style="height: 100%;">
                <div class="tab-content" style="height: 100%;">
                    <div class="tab-pane active" id="dropzone_upload" role="tabpanel" style="height: 100%;">
