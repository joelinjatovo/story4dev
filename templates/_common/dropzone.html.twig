<div style="visibility:hidden; opacity:0; display: none;" class="dropzone-container" aria-modal="true" role="dialog">
    <button class="btn-close" type="button" aria-label="Close Modal" title="Close Modal"><span aria-hidden="true">×</span></button>
    <div class="file-selector-inner">
        <div class="kt-portlet kt-portlet--tabs">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-toolbar">
                    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x nav-tabs-line-right" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-toggle="tab" href="#kt_portlet_base_demo_2_3_tab_content" role="tab">
                                <i class="fa fa-calendar-check-o" aria-hidden="true"></i>{% trans %}button.upload{% endtrans %}
                            </a>
                        </li>
                        <li class="nav-item kt-hidden">
                            <a class="nav-link" data-toggle="tab" href="#kt_portlet_base_demo_2_2_tab_content" role="tab">
                                <i class="fa fa-bar-chart" aria-hidden="true"></i>{% trans %}button.select{% endtrans %}
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="kt-portlet__body" style="height: 100%;">
                <div class="tab-content" style="height: 100%;">
                    <div class="tab-pane active" id="kt_portlet_base_demo_2_3_tab_content" role="tabpanel" style="height: 100%;">
                        <div class="dropzone dropzone-default dropzone-success dz-clickable"  style="height: 100%;">
                            <div class="dropzone-msg dz-message needsclick">
                                <h3 class="dropzone-msg-title">{% trans %}dropzone.title{% endtrans %}</h3>
                                <span class="dropzone-msg-desc">{% trans %}dropzone.subtitle{% endtrans %}</span>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane kt-hidden" id="kt_portlet_base_demo_2_2_tab_content" role="tabpanel" style="height: 100%;">
                        &nbsp;
                    </div>
                </div>      
            </div>
        </div>
    </div>
</div>