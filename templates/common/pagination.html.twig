{% if pagination.page.count > 0 %}
    <ul class="kt-pagination__links">
        {% if pagination.page.current > 1 %}
            <li class="kt-pagination__link--first">
                <a href="{{ path(pagination.route.name, pagination.route.params|merge({'page': 1})) }}">
                    <<
                </a>
            </li>
            <li class="kt-pagination__link--next">
                <a href="{{ path(pagination.route.name, pagination.route.params|merge({'page': pagination.page.current-1})) }}">
                    <
                </a>
            </li>
        {% endif %}

        {# Affichage de toutes les pages entre p-4 et p+4 sauf si < 1 ou > nbPages #}
        {% for p in range(max(pagination.page.current-4, 1), min(pagination.page.current+4, pagination.page.count)) %}
            <li {% if p == pagination.page %}class="kt-pagination__link--active"{% endif %}>
                <a href="{{ path(pagination.route.name, pagination.route.params|merge({'page': p})) }}">
                    {{ p }}
                </a>
            </li>
        {% endfor %}

        {% if pagination.page.current < pagination.page.count %}
            <li class="kt-pagination__link--prev">
                <a href="{{ path(pagination.route.name, pagination.route.params|merge({'page': pagination.page.current+1})) }}">
                    >
                </a>
            </li>
            <li class="kt-pagination__link--last">
                <a href="{{ path(pagination.route.name, pagination.route.params|merge({'page': pagination.page.count})) }}">
                    >>
                </a>
            </li>
        {% endif %}
    </ul>
    <div class="kt-pagination__toolbar">
        <select class="form-control kt-font-brand" style="width: 60px">
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="30">30</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
        <span class="pagination__desc">
            Displaying 10 of 230 records
        </span>
    </div>
{% endif %}