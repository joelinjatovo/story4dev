<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <title>{% block title %}
            {% if active_form == 'signin' %}{% trans %}page.title.signin{% endtrans %}
            {% elseif active_form == 'forgot' %}{% trans %}page.title.forgot{% endtrans %}
            {% elseif active_form == 'signup' %}{% trans %}page.title.signup{% endtrans %}
            {% else %}{% trans %}page.title.home{% endtrans %}
            {% endif %}
            - {{ setting.get('seo_title') }}{% endblock %}</title>
        <meta name="keywords" content="{{ setting.get('seo_keywords') }}"> 
        
        {% if active_form == 'signin' %}
            <meta name="description" content="{% trans %}page.description.signin{% endtrans %}"> 
        {% elseif active_form == 'forgot' %}
            <meta name="description" content="{% trans %}page.description.forgot{% endtrans %}"> 
        {% elseif active_form == 'signup' %}
            <meta name="description" content="{% trans %}page.description.signup{% endtrans %}"> 
        {% else %}
            <meta name="description" content="{{ setting.get('seo_description') }}"> 
        {% endif %}

        <link href="{{ asset('css/fonts/poppins/poppins.css') }}" rel="stylesheet">

        {% block stylesheets %}
        <link href="{{ asset('css/vendors.bundle.css') }}" rel="stylesheet" type="text/css"/>
        <link href="{{ asset('css/style.bundle.css') }}" rel="stylesheet" type="text/css"/>
        
        <link href="{{ asset('css/login.css') }}" rel="stylesheet" type="text/css"/>
        {% endblock %}
            
        <link rel="shortcut icon" href="{{ asset('images/favicon.ico') }}" />
        
    </head>
    <body>
        {% block alert %}
            {{ include('_common/alert.html.twig') }}
        {% endblock %}
        <div class="container {{ active_form == 'signup' ? 'right-panel-active' : '' }} {{ active_form == 'forgot' ? 'forgot-panel-active' : '' }}" id="container">
            <div class="form-container sign-up-container">
                <form action="/register" method="post" id="sign-up-form">
                    <h1>{% trans %}signup.title{% endtrans %}</h1>
                    <p>{% trans %}signup.subtitle{% endtrans %}</p>
                    <div class="input-group f_row">
                        <label>{% trans %}email{% endtrans %} *</label>
                        <input type="text" class="input-field" name="email" autocomplete="off">
                        <u></u>
                    </div>
                    <div class="input-group f_row">
                        <label>{% trans %}password{% endtrans %} *</label>
                        <input type="password" class="input-field" id="password" name="password">
                        <u></u>
                    </div>
                    <div class="input-group f_row last">
                        <label>{% trans %}confirmation{% endtrans %} *</label>
                        <input type="password" class="input-field" name="password_confirm">
                        <u></u>
                    </div>
                    <div class="row kt-login__extra">
                        <div class="col kt-align-left">
                            <label class="kt-checkbox">
                                <input type="checkbox" name="agree">{% trans with {'%link%': '#'} %}signup.terms_and_conditions{% endtrans %}
                                <span></span>
                            </label>
                            <span class="form-text text-muted"></span>
                        </div>
                    </div>
                    <button>{% trans %}signup.button{% endtrans %}</button>
                </form>
            </div>
            <div class="form-container sign-in-container">
                <form action="/login" method="post" id="sign-in-form">
                    <h1>{% trans %}signin.title{% endtrans %}</h1>
                    <p>{% trans %}signin.subtitle{% endtrans %}</p>
                    <div class="social-container kt-hidden">
                        <a href="{{ path('connect_facebook_start') }}" class="social"><i class="fab fa-facebook-f"></i></a>
                        <a href="{{ path('connect_google_start') }}" class="social"><i class="fab fa-google-plus-g"></i></a>
                    </div>
                    <p class="kt-hidden" style="margin-top: 0;">{% trans %}signin.separator{% endtrans %}</p>
                    <div class="input-group f_row {{ last_username is null ? '' : 'focus' }}">
                        <label>{% trans %}email{% endtrans %}</label>
                        <input value="{{ last_username }}" class="input-field" type="text" name="email"  autocomplete="off" />
                        <u></u>
                    </div>
                    <div class="input-group f_row last">
                        <label>{% trans %}password{% endtrans %}</label>
                        <input type="password" class="input-field" name="password" />
                        <u></u>
                    </div>
                    <!--
                    <label class="kt-checkbox">
                        <input type="checkbox" name="_remember_me"> Remember me
                        <span></span>
                    </label>
                    -->
                    <a href="javascript:;" id="forgot">{% trans %}signin.forgot{% endtrans %}</a>
                    <button>{% trans %}signin.button{% endtrans %}</button>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" >
                </form>
            </div>
            <div class="form-container forgot-container">
                <form action="/forgot" method="post" id="forgot-form">
                    <h1>{% trans %}forgot.title{% endtrans %}</h1>
                    <p>{% trans %}forgot.subtitle{% endtrans %}</p>
                    <div class="input-group f_row last">
                        <label>{% trans %}email{% endtrans %}</label>
                        <input class="input-field" type="text" name="email" autocomplete="off" />
                        <u></u>
                    </div>
                    <button>{% trans %}forgot.button1{% endtrans %}</button>
                    <a href="javascript:;" id="cancelForgot">{% trans %}forgot.button2{% endtrans %}</a>
                </form>
            </div>
            <div class="form-container message-container">
                <div class="message">
                    <h1 id="message-title"></h1>
                    <p id="message-content"></p>
                    <button class="ghost" id="btnOk">{% trans %}button.ok{% endtrans %}</button>
                </div>
            </div>
            <div class="overlay-container">
                <div class="overlay">
                    <div class="overlay-panel overlay-left">
                        <h1 class="hidden-mobile">{% trans %}overlay.left.title{% endtrans %}</h1>
                        <p class="hidden-mobile">{% trans %}overlay.left.subtitle{% endtrans %}</p>
                        <button class="ghost" id="signIn">{% trans %}overlay.left.button{% endtrans %}</button>
                        <p class="hidden-mobile kt-hidden">{% trans %}overlay.left.separator{% endtrans %}</p>
                        <div class="social-container hidden-mobile kt-hidden">
                            <a href="{{ path('connect_facebook_start') }}" class="social"><i class="fab fa-facebook-f"></i></a>
                            <a href="{{ path('connect_google_start') }}" class="social"><i class="fab fa-google-plus-g"></i></a>
                        </div>
                    </div>
                    <div class="overlay-panel overlay-right">
                        <h1 class="hidden-mobile">{% trans %}overlay.right.title{% endtrans %}</h1>
                        <p class="hidden-mobile">{% trans %}overlay.right.subtitle{% endtrans %}</p>
                        <button class="ghost" id="signUp">{% trans %}overlay.right.button{% endtrans %}</button>
                    </div>
                </div>
            </div>
        </div>

        {% block javascripts %}
            <script>
                var KTAppMessages = {"waiting": "{% trans %}please_wait{% endtrans %}"};
                var KTAppOptions = {"colors":{"state":{"brand":"#22b9ff","light":"#ffffff","dark":"#282a3c","primary":"#5867dd","success":"#34bfa3","info":"#36a3f7","warning":"#ffb822","danger":"#fd3995"},"base":{"label":["#c5cbe3","#a1a8c3","#3d4465","#3e4466"],"shape":["#f0f3ff","#d9dffa","#afb4d4","#646c9a"]}}};
            </script>
            <script src="{{ asset('js/vendors.bundle.js') }}" type="text/javascript" ></script>
            <script src="{{ asset('js/scripts.bundle.js') }}" type="text/javascript" ></script>
            <script src="{{ asset('js/login.js') }}" type="text/javascript" ></script>
        {% endblock %}
    </body>
</html>