    <html>
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
            <title>{% block title %}Message{% endblock %} - Story4Dev</title>
            <style>
                {# here, define your CSS styles as usual #}
                h3 {
                    color: red;
                }
            </style>
        </head>
