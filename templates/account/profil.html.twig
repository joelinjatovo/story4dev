{% extends 'account/base.html.twig' %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}profil{% endtrans %}</h3>
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__group" id="kt_subheader_search">
                <span class="kt-subheader__desc" id="kt_subheader_total">{{ user.fullname }}</span>
            </div>
        </div>        
        <div class="kt-subheader__toolbar">
            <div class="btn-group">
                <button form="account_profile" type="submit" class="btn btn-brand btn-bold">{% trans %}button.save{% endtrans %}</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block subcontent %}
<div class="row">
    <div class="col-xl-12">
        <div class="kt-portlet">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label">
                    <h3 class="kt-portlet__head-title">{% trans %}form.title.account.profil{% endtrans %}</h3>
                </div>
            </div>
            {{ form_start( form, { 'method' : 'POST', 'attr' : {'id': 'account_profile', 'class' : 'kt-form kt-form--label-right' } } ) }}
                <div class="kt-portlet__body">
                    <div class="kt-section kt-section--first">
                        <div class="kt-section__body">
                            <div class="row">
                                <label class="col-xl-3"></label>
                                <div class="col-lg-9 col-xl-6">
                                    <h3 class="kt-section__title kt-section__title-sm">{% trans %}form.info{% endtrans %}:</h3>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-xl-3 col-lg-3 col-form-label">{% trans %}form.avatar{% endtrans %}</label>
                                <div class="col-lg-9 col-xl-6">
                                    <div class="kt-avatar kt-avatar--outline" id="kt_user_avatar">
                                        <div class="kt-avatar__holder" style="background-image: url('{{ user.avatar ? vich_uploader_asset(user, 'avatarFile') | imagine_filter('thumb') : default_avatar }}');"></div>
                                        <label class="kt-avatar__upload" data-toggle="kt-tooltip" title="" data-original-title="Sélectionner avatar">
                                            <i class="fa fa-pen"></i>
                                            <input type="file" id="account_profile_avatarFile_file" name="account_profile[avatarFile][file]" accept=".jpeg, .png, .jpg, .gif">
                                        </label>
                                        <span class="kt-avatar__cancel" data-toggle="kt-tooltip" title="" data-original-title="Supprimer avatar">
                                            <i class="fa fa-times"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.fullname, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    {{ form_widget( form.fullname, { 'attr' : { 'class' : 'form-control', 'required' : 'required' } } ) }}
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.company, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    {{ form_widget( form.company, { 'attr' : { 'class' : 'form-control' } } ) }}
                                    <span class="form-text text-muted"></span>
                                </div>
                            </div>

                            <div class="row">
                                <label class="col-xl-3"></label>
                                <div class="col-lg-9 col-xl-6">
                                    <h3 class="kt-section__title kt-section__title-sm">{% trans %}form.label.contact{% endtrans %}:</h3>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-xl-3 col-lg-3 col-form-label">{% trans %}form.label.email{% endtrans %}</label>
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        <div class="input-group-prepend"><span class="input-group-text"><i class="la la-at"></i></span></div>
                                        <input type="text" class="form-control" value="{{ user.email }}" placeholder="{% trans %}email{% endtrans %}" aria-describedby="basic-addon1" readonly>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.phone, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        <div class="input-group-prepend"><span class="input-group-text"><i class="la la-phone"></i></span></div>
                                        {{ form_widget( form.phone, { 'attr' : { 'class' : 'form-control', 'aria-describedby' : 'basic-addon1'} } ) }}
                                    </div>
                                    <span class="form-text text-muted"></span>
                                </div>
                            </div>
                            <div class="form-group form-group-last row">
                                {{ form_label( form.website, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        <div class="input-group-prepend"><span class="input-group-text"><i class="la la-at"></i></span></div>
                                        {{ form_widget( form.website, { 'attr' : { 'class' : 'form-control'} } ) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="kt-portlet__foot">
                    <div class="kt-form__actions">
                        <div class="row">
                            <div class="col-lg-3 col-xl-3">
                            </div>
                            <div class="col-lg-9 col-xl-9">
                                <button type="submit" class="btn btn-success">{% trans %}button.save{% endtrans %}</button>&nbsp;
                                <button type="reset" class="btn btn-secondary">{% trans %}button.cancel{% endtrans %}</button>
                            </div>
                        </div>
                    </div>
                </div>
                {{ form_row( form._token ) }}
            {{ form_end( form, {'render_rest': false}) }}
        </div>
    </div>  
</div>  
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/profile.js') }}" type="text/javascript" ></script>
{% endblock %}
