{% extends 'base.html.twig' %}

{% block title %}{% trans %}reports{% endtrans %} - {{ user.fullname }} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans with {'%name%': user.fullname } %}reports.by{% endtrans %}</h3>
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__group" id="kt_subheader_search">
                <span class="kt-subheader__desc" id="kt_subheader_total">{% trans with {'%count%': reports.count } %}reports.total{% endtrans %}</span>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}

<div class="row">
    {% for report in reports %}
        <div class="col-xl-6">
            {{ include('account/_report_item.html.twig', {'report': report}) }}
        </div>
    {% endfor %}
</div>
    
<div class="row">
    <div class="col-xl-12">       
        <div class="kt-portlet">
            <div class="kt-portlet__body">
                <!--begin: Pagination-->
                <div class="kt-pagination kt-pagination--brand">
                    {{ include('_common/pagination.html.twig', {'pagination': reports}) }}
                </div>
                <!--end: Pagination-->
            </div>
        </div>
    </div>           
</div>
{% endblock %}


{% block javascripts %}
{% endblock %}
