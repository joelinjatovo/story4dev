<!--begin:: Portlet-->
<div class="kt-portlet kt-portlet--height-fluid">
    <div class="kt-portlet__body kt-portlet__body--fit">
        <!--begin::Widget -->
        <div class="kt-widget kt-widget--project-1">
            <div class="kt-widget__head">
                <div class="kt-widget__label">
                    <div class="kt-widget__media">
                        <span class="kt-media kt-media--lg kt-media--circle"> 
                            <img src="{{ report.author.avatar ? vich_uploader_asset(report.author, 'avatarFile') : default_avatar }}" alt="image">
                        </span>
                    </div>
                    <div class="kt-widget__info kt-margin-t-5">
                        <a href="{% if is_granted('view', report) %}{{ path('report_show', { 'slug': report.activity.project.slug, 'activity_id': report.activity.id, 'report_id': report.id}) }}{% else %}#{% endif %}" class="kt-widget__title">
                            {{ report.title }}                                                
                        </a>
                        <span class="kt-widget__desc">
                            {{ report.activity.title }}
                        </span>
                    </div>
                </div>
                <div class="kt-portlet__head-toolbar">
                    <a href="#" class="btn btn-clean btn-sm btn-icon btn-icon-md" data-toggle="dropdown">
                        <i class="flaticon-more-1"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-fit dropdown-menu-right">
                        <ul class="kt-nav">
                            {% if is_granted('view', report) %}
                            <li class="kt-nav__item">
                                <a href="{{ path('report_show', { 'slug': report.activity.project.slug, 'activity_id': report.activity.id, 'report_id': report.id}) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-line-chart"></i>
                                    <span class="kt-nav__link-text">{% trans %}button.details{% endtrans %}</span>
                                </a>
                            </li>
                            {% endif %}
                            {% if is_granted('edit', report) %}
                                <li class="kt-nav__item">
                                    <a href="{{ path('report_edit', { 'slug': report.activity.project.slug, 'activity_id': report.activity.id, 'report_id': report.id}) }}" class="kt-nav__link">
                                        <i class="kt-nav__link-icon flaticon2-settings"></i>
                                        <span class="kt-nav__link-text">{% trans %}button.edit{% endtrans %}</span>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>

            <div class="kt-widget__body">
                <div class="kt-widget__stats">
                    <div class="kt-widget__item">
                        <span class="kt-widget__date">
                            {% trans %}date.created{% endtrans %}
                        </span>
                        <div class="kt-widget__label">
                            <span class="btn btn-label-brand btn-sm btn-bold btn-upper">{{ report.createdat is empty ? "" : report.createdat | date('Y-m-d H:i:s') }}</span>
                        </div>
                    </div>

                    <div class="kt-widget__item">
                        <span class="kt-widget__date">
                            {% trans %}date.synced{% endtrans %}
                        </span>
                        <div class="kt-widget__label">
                            <span class="btn btn-label-danger btn-sm btn-bold btn-upper">{{ report.syncedat is empty ? "" : report.syncedat | date('Y-m-d H:i:s') }}</span>
                        </div>
                    </div>
                </div>

                <span class="kt-widget__text">
                    {{ report.description|excerpt }}                         
                </span>

                <div class="kt-widget__content">
                    <div class="kt-widget__details">
                        <span class="kt-widget__subtitle">{% trans %}results{% endtrans %}</span>
                        <span class="kt-widget__value">{{ report.results.count }}</span>
                    </div>
                    <div class="kt-widget__details">
                        <span class="kt-widget__subtitle">{% trans %}documents{% endtrans %}</span>
                        <div class="kt-media-group">
                            {% for reportFile in report.reportFiles %}
                                {% if reportFile.file %}
                                    {% if reportFile.file.image %}
                                        <a href="#" class="kt-media kt-media--sm kt-media--circle" data-toggle="kt-tooltip" data-skin="brand" data-placement="top" title="" data-original-title="{% trans %}image{% endtrans %}">
                                            <img src="{{ asset( reportFile.file.icone ) | imagine_filter('thumb') }}" alt="{% trans %}image{% endtrans %}">
                                        </a>
                                    {% else %}
                                        <a href="{{ path( 'file_download', {id:reportFile.file.id}) }}" target="_blank" class="kt-media kt-media--sm kt-media--circle" data-toggle="kt-tooltip" data-skin="brand" data-placement="top" title="" data-original-title="Cliquez pour le télécharger.">
                                            <img src="{{ asset( reportFile.file.icone ) }}" alt="{% trans %}image{% endtrans %}">
                                        </a>
                                    {% endif %}
                                {% endif %}
                            {% else %}
                                {% trans %}no.document.report{% endtrans %}
                            {% endfor %}
                        </div>                                 
                    </div>
                </div>
            </div>
        </div>
        <!--end::Widget -->
    </div>
</div>
<!--end:: Portlet-->