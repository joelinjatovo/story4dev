{% extends 'account/base.html.twig' %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}profil{% endtrans %}</h3>
            <span class="kt-subheader__separator kt-subheader__separator--v"></span>
            <div class="kt-subheader__group" id="kt_subheader_search">
                <span class="kt-subheader__desc" id="kt_subheader_total">{{ user.fullname }}</span>
            </div>
        </div>        
        <div class="kt-subheader__toolbar">
            <div class="btn-group">
                <button form="account_info" type="submit" class="btn btn-brand btn-bold">{% trans %}button.save{% endtrans %}</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block subcontent %}
<div class="row">
    <div class="col-xl-12">
        <div class="kt-portlet">
            <div class="kt-portlet__head">
                <div class="kt-portlet__head-label">
                    <h3 class="kt-portlet__head-title">{% trans %}form.title.account.info{% endtrans %}</h3>
                </div>
            </div>
            
            {{ form_start( form, { 'method' : 'POST', 'attr' : {'id': 'account_info', 'class' : 'kt-form kt-form--label-right' } } ) }}
                <div class="kt-portlet__body">
                    <div class="kt-section kt-section--first">
                        <div class="kt-section__body">
                            <div class="row">
                                <label class="col-xl-3"></label>
                                <div class="col-lg-9 col-xl-6">
                                    <h3 class="kt-section__title kt-section__title-sm">{% trans %}account{% endtrans %}:</h3>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.username, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        {{ form_widget( form.username, { 'attr' : { 'class' : 'form-control' } } ) }}
                                    </div>
                                    <span class="form-text text-muted">{% trans %}form.help.username{% endtrans %}</span>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.email, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        <div class="input-group-prepend"><span class="input-group-text"><i class="la la-at"></i></span></div>
                                        {{ form_widget( form.email, { 'attr' : { 'class' : 'form-control' } } ) }}
                                    </div>
                                    <span class="form-text text-muted">{% trans %}form.help.email{% endtrans %}</span>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.language, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    {{ form_widget( form.language, { 'attr' : { 'class' : 'form-control' } } ) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="kt-portlet__foot">
                    <div class="kt-form__actions">
                        <div class="row">
                            <div class="col-lg-3 col-xl-3">
                            </div>
                            <div class="col-lg-9 col-xl-9">
                                <button type="submit" class="btn btn-success">{% trans %}button.save{% endtrans %}</button>&nbsp;
                                <button type="reset" class="btn btn-secondary">{% trans %}button.cancel{% endtrans %}</button>
                            </div>
                        </div>
                    </div>
                </div>
                {{ form_row( form._token ) }}
            {{ form_end( form, {'render_rest': false}) }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script type="text/javascript">
function readURL(input) {
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function (e) {
            $('.kt-avatar__holder').css({ 'background-image' : 'url("' + e.target.result + '")', 'background-size' : 'cover', 'background-repeat' : 'no-repeat', 'background-position' : 'center center'  });
        }
        reader.readAsDataURL(input.files[0]);
    }
}
$("#avatar-img").change(function(){
    readURL(this);
});
</script>
{% endblock %}
