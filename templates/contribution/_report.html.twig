<div class="kt-widget5__item">
    <div class="kt-widget5__content">
        <div class="kt-widget5__section">
            <a href="{{ path('report_show', { 'report_id' : report.id,  'activity_id' : report.activity.id, 'slug' : report.activity.project.slug } ) }}" class="kt-widget5__title">
                {{ report.title }}
            </a>
            <p class="kt-widget5__desc">
                {{ report.description|excerpt }} 
            </p>
            <div class="kt-widget5__info">
                <span>Activité:</span>
                <span class="kt-font-info">{{ report.activity.title }}</span>
                <span>{% trans %}date.report{% endtrans %}:</span>
                <span class="kt-font-info">{{ report.createdat is empty ? "" : report.createdat | date('Y-m-d H:i:s') }}</span>
            </div>
        </div>
    </div>						
    <div class="kt-widget5__content">
        <div class="kt-widget5__stats">
            <span class="kt-widget5__number">{{ report.results.count }}</span>
            <span class="kt-widget5__sales">{% trans %}reports{% endtrans %}</span>
        </div>
        <div class="kt-widget5__stats">
            <span class="kt-widget5__number">{{ report.reportFiles.count }}</span>
            <span class="kt-widget5__votes">{% trans %}files{% endtrans %}</span>
        </div>
    </div>	
</div>