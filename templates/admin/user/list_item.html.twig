 <tr data-row="0" class="kt-datatable__row user-item" style="left: 0px;">
    <td data-field="{% trans %}user{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="width: 222px;">
            <div class="kt-user-card-v2">
                <div class="kt-user-card-v2__pic">
                    <img alt="{% trans %}avatar{% endtrans %}" src="{{ user.avatar ? vich_uploader_asset(user, 'avatarFile') | imagine_filter('thumb') : default_avatar }}">
                </div>
                <div class="kt-user-card-v2__details">
                    <a class="kt-user-card-v2__name" href="{{ url('admin_user_show', {'id': user.id}) }}">{{ user.fullname }}</a>
                    <span class="kt-user-card-v2__email">{{ user.email }}</span>
                    {% if user.verified %}
                        <i class="flaticon2-correct"></i>    
                    {% endif %}   
                </div>
            </div>
        </span>
    </td>
    <td data-field="{% trans %}last.activity{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="kt-font-bold">{{ user.lastActivityAt ? user.lastActivityAt|ago : '-' }}</span></span>
    </td>
    <td data-field="{% trans %}status{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="btn btn-bold btn-sm btn-font-sm  btn-label-{{ user.statusClass }}">{{ user.status }}</span></span>
    </td>
    <td data-field="{% trans %}role{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="btn btn-bold btn-sm btn-font-sm  btn-label-{{ user.admin ? 'danger' : 'brand' }}">{{ user.admin ? 'admin' : 'customer' }}</span></span>
    </td>
    <td data-field="{% trans %}data{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 100px;">{% transchoice user.projectContributions.count %}choice.project{% endtranschoice %} / {% transchoice user.reports.count %}choice.report{% endtranschoice %}</span>
    </td>
    <td data-field="{% trans %}action{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="overflow: visible; position: relative; width: 150px;">
            <a href="{{ path('admin_user_edit', {id: user.id} ) }}" title="{% trans %}button.edit{% endtrans %}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                <i class="la la-edit"></i>
            </a>
            <a href="{{ path('admin_user_show', {id: user.id} ) }}" title="{% trans %}button.view{% endtrans %}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                <i class="la la-eye"></i>
            </a>
            <a href="{{ path('user_show', {slug: user.slug} ) }}" title="{% trans %}button.view{% endtrans %}" class="btn btn-sm btn-clean btn-icon btn-icon-md kt-hidden">
                <i class="la la-desktop"></i>
            </a>
            {% if is_granted('ROLE_SUPER_ADMIN') %}
                <a title="{% trans %}button.delete{% endtrans %}" data-id="{{ user.id }}"  class="btn btn-sm btn-clean btn-icon btn-icon-md btn-remove">
                    <i class="la la-trash"></i>
                </a>
            {% endif %}
        </span>
    </td>
</tr>