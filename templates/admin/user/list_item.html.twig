 <tr data-row="0" class="kt-datatable__row" style="left: 0px;">
    <td data-field="User" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="width: 222px;">
            <div class="kt-user-card-v2">
                <div class="kt-user-card-v2__pic">
                    <img alt="avatar" src="{{ user.avatar ? vich_uploader_asset(user, 'avatarFile') : default_avatar }}">
                </div>
                <div class="kt-user-card-v2__details">
                    <a class="kt-user-card-v2__name" href="{{ url('admin_user_show', {'id': user.id}) }}">{{ user.fullname }}</a>
                    <span class="kt-user-card-v2__email">{{ user.email }}</span>
                    {% if user.verified %}
                        <i class="flaticon2-correct"></i>    
                    {% endif %}   
                </div>
            </div>
        </span>
    </td>
    <td data-field="Country" class="kt-datatable__cell">
        <span style="width: 50px;"><span class="kt-font-bold">{{ user.address is not null ? user.address.country : '' }}</span></span>
    </td>
    <td data-field="Date" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="kt-font-bold">{{ user.createdat|ago }}</span></span>
    </td>
    <td data-field="Status" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="btn btn-bold btn-sm btn-font-sm  btn-label-{{ user.statusClass }}">{{ user.status }}</span></span>
    </td>
    <td data-field="Roles" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="btn btn-bold btn-sm btn-font-sm  btn-label-{{ user.admin ? 'danger' : 'brand' }}">{{ user.admin ? 'admin' : 'customer' }}</span></span>
    </td>
    <td data-field="Data" class="kt-datatable__cell">
        <span style="width: 100px;">{{ user.projectContributions.count }} projets / {{ user.reports.count }} rapports </span>
    </td>
    <td data-field="Actions" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="overflow: visible; position: relative; width: 80px;">
            <div class="dropdown">
                <a data-toggle="dropdown" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                    <i class="flaticon-more-1"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right">
                    <ul class="kt-nav">
                        <li class="kt-nav__item">
                            <a class="kt-nav__link" href="{{ url('admin_user_show', {'id': user.id}) }}">
                                <i class="kt-nav__link-icon flaticon2-expand"></i>
                                <span class="kt-nav__link-text">Afficher</span>
                            </a>
                        </li>
                        <li class="kt-nav__item">
                            <a class="kt-nav__link" href="{{ url('admin_user_edit', {'id': user.id}) }}">
                                <i class="kt-nav__link-icon flaticon2-contract"></i>
                                <span class="kt-nav__link-text">Modifier</span>
                            </a>
                        </li>
                        <li class="kt-nav__item">
                            <a class="kt-nav__link" href="#">
                                <i class="kt-nav__link-icon flaticon2-trash"></i>
                                <span class="kt-nav__link-text">Supprimer</span>
                            </a>
                        </li>
                        <li class="kt-nav__item">
                            <a class="kt-nav__link" href="{{ url('user_show', {'slug': user.slug}) }}">
                                <i class="kt-nav__link-icon flaticon2-mail-1"></i>
                                <span class="kt-nav__link-text">Ouvrir</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </span>
    </td>
</tr>
<tr class="kt-datatable__row-detail kt-hidden">
    <td class="kt-datatable__detail" colspan="9">
        <table>
            <tr class="kt-datatable__row">
                <td class="kt-datatable__cell"><span>Status</span></td>
                <td data-field="Status" class="kt-datatable__cell" style="">
                    <span style="width: 100px;">
                        <span class="btn btn-bold btn-sm btn-font-sm  btn-label-danger">Processing</span>
                    </span>
                </td>
            </tr>
        </table>
    </td>
</tr>