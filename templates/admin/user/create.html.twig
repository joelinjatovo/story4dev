{% extends 'admin/base.html.twig' %}

{% block title %}{% trans %}form.title.user.create{% endtrans %} - {% trans %}admin{% endtrans %} - {{ app.user.fullname }}{% endblock %}


{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}form.title.user.create{% endtrans %}</h3>
        </div>
        <div class="kt-subheader__toolbar">
            <div class="kt-subheader__wrapper">
               <a href="{{ url('admin_user_list') }}" class="btn btn-clean kt-margin-r-10"><i class="la la-arrow-left"></i><span class="kt-hidden-mobile">{% trans %}all.users{% endtrans %}</span></a>
                <div class="btn-group">
                    <button type="submit" form="user" name="submit" value="save-default" class="btn btn-brand">
                        <i class="la la-check"></i> 
                        <span class="kt-hidden-mobile">{% trans %}button.save{% endtrans %}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-xl-12">
		<div class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
            {{ form_start( form, { 'method' : 'POST', 'attr' : {'class' : 'kt-form kt-form--label-right', 'id': 'user' } } ) }}
                <div class="kt-portlet__body">
                    <div class="kt-section kt-section--first">
                        <div class="kt-section__body">
                            <div class="row">
                                <label class="col-xl-3"></label>
                                <div class="col-lg-9 col-xl-6">
                                    <h3 class="kt-section__title kt-section__title-sm">{% trans %}informations{% endtrans %}:</h3>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-xl-3 col-lg-3 col-form-label"></label>
                                <div class="col-lg-9 col-xl-6">
                                    <div class="kt-checkbox-list">
                                        <label class="kt-checkbox kt-checkbox--bold kt-checkbox--danger label-danger">
                                            {{ form_widget( form.isVerified ) }} {% trans %}set.as.verified{% endtrans %}
                                            <span></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-xl-3 col-lg-3 col-form-label">{% trans %}avatar{% endtrans %}</label>
                                <div class="col-lg-9 col-xl-6">
                                    <div class="kt-avatar kt-avatar--outline" id="kt_user_avatar">
                                        <div class="kt-avatar__holder" style="background-image: url('{{ user.avatar ? vich_uploader_asset(user, 'avatarFile') : default_avatar }}');"></div>
                                        <label class="kt-avatar__upload" data-toggle="kt-tooltip" title="" data-original-title="{% trans %}button.change.avatar{% endtrans %}">
                                            <i class="fa fa-pen"></i>
                                            <input type="file" id="user_avatarFile_file" name="user[avatarFile][file]" accept=".jpeg, .png, .jpg, .gif">
                                        </label>
                                        <span class="kt-avatar__cancel" data-toggle="kt-tooltip" title="" data-original-title="{% trans %}button.remove.avatar{% endtrans %}">
                                            <i class="fa fa-times"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.username, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                    {{ form_widget( form.username, { 'attr' : { 'class' : 'form-control' } } ) }}
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.email, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        <div class="input-group-prepend"><span class="input-group-text"><i class="la la-at"></i></span></div>
                                    {{ form_widget( form.email, { 'attr' : { 'class' : 'form-control' } } ) }}
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.fullname, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    {{ form_widget( form.fullname, { 'attr' : { 'class' : 'form-control' } } ) }}
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.status, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        {{ form_widget( form.status, { 'attr' : { 'class' : 'form-control' } } ) }}
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-xl-3 col-lg-3 col-form-label">{% trans %}role.user{% endtrans %}</label>
                                <div class="col-lg-9 col-xl-6">
                                    <div class="kt-checkbox-inline">
                                        <label class="kt-checkbox">
                                            <input type="hidden" name="user[roles][]" value="ROLE_USER" >
                                            <input type="checkbox" id="user_roles_1" class="changed-input" checked disabled>{% trans %}role.customer{% endtrans %}
                                            <span></span>
                                        </label>
                                        <label class="kt-checkbox">
                                            <input type="checkbox" id="user_roles_2" name="user[roles][]" value="ROLE_ADMIN" class="changed-input" {{ user.admin? 'checked' : '' }} >{% trans %}role.admin{% endtrans %}
                                            <span></span>
                                        </label>
                                        <label class="kt-checkbox">
                                            <input type="checkbox" id="user_roles_3" name="user[roles][]" value="ROLE_SUPER_ADMIN" class="changed-input" {{ user.superadmin? 'checked' : '' }} >{% trans %}role.superadmin{% endtrans %}
                                            <span></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-xl-3"></label>
                                <div class="col-lg-9 col-xl-6">
                                    <h3 class="kt-section__title kt-section__title-sm">{% trans %}contacts.and.others{% endtrans %}:</h3>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.company, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    {{ form_widget( form.company, { 'attr' : { 'class' : 'form-control' } } ) }}
                                    <span class="form-text text-muted"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.phone, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        <div class="input-group-prepend"><span class="input-group-text"><i class="la la-phone"></i></span></div>
                                        {{ form_widget( form.phone, { 'attr' : { 'class' : 'form-control', 'aria-describedby' : 'basic-addon1'} } ) }}
                                    </div>
                                    <span class="form-text text-muted"></span>
                                </div>
                            </div>
                            <div class="form-group form-group-last row">
                                {{ form_label( form.website, null , { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        <div class="input-group-prepend"><span class="input-group-text"><i class="la la-at"></i></span></div>
                                        {{ form_widget( form.website, { 'attr' : { 'class' : 'form-control'} } ) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{ form_row( form._token ) }}
            {{ form_end( form, {'render_rest': false}) }}
        </div>
    </div>  
</div>  
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/add-user.js') }}" type="text/javascript" ></script>
{% endblock %}
