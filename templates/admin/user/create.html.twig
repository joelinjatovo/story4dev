{% extends 'admin/base.html.twig' %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<br>
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-xl-12">
		<div class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
			<div class="kt-portlet__head kt-portlet__head--lg" style="">
				<div class="kt-portlet__head-label">
                    {% block headtitle %}
                        <h3 class="kt-portlet__head-title">Ajouter un utilisateur <small>Entrer les informations du compte puis enregistrer</small></h3>
                    {% endblock %}
				</div>
				<div class="kt-portlet__head-toolbar">
					<a href="{{ path('admin_user_list') }}" class="btn btn-clean kt-margin-r-10">
						<i class="la la-arrow-left"></i>
						<span class="kt-hidden-mobile">Retours</span>
					</a>
					<div class="btn-group">
						<button type="submit" form="user" name="submit" value="save-default" class="btn btn-brand">
							<i class="la la-check"></i> 
							<span class="kt-hidden-mobile">Enregister</span>
						</button>
						<button type="button" class="btn btn-brand dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
						</button>
						<div class="dropdown-menu dropdown-menu-right">
							<ul class="kt-nav">
								<li class="kt-nav__item">
									<button type="submit" form="user" name="submit" value="save-continue" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-reload"></i>
										<span class="kt-nav__link-text">Save &amp; continue</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="user" name="submit" value="save-exit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-power"></i>
										<span class="kt-nav__link-text">Save &amp; exit</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="user" name="submit" value="save-edit" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-edit-interface-symbol-of-pencil-tool"></i>
										<span class="kt-nav__link-text">Save &amp; edit</span>
									</button>
								</li>
								<li class="kt-nav__item">
									<button type="submit" form="user" name="submit" value="save-create" class="kt-nav__link">
										<i class="kt-nav__link-icon flaticon2-add-1"></i>
										<span class="kt-nav__link-text">Save &amp; add new</span>
									</button>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

            {{ form_start( form, { 'method' : 'POST', 'attr' : {'class' : 'kt-form kt-form--label-right', 'id': 'user' } } ) }}
                <div class="kt-portlet__body">
                    <div class="kt-section kt-section--first">
                        <div class="kt-section__body">
                            <div class="row">
                                <label class="col-xl-3"></label>
                                <div class="col-lg-9 col-xl-6">
                                    <h3 class="kt-section__title kt-section__title-sm">Informations:</h3>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-xl-3 col-lg-3 col-form-label"></label>
                                <div class="col-lg-9 col-xl-6">
                                    <div class="kt-checkbox-list">
                                        <label class="kt-checkbox kt-checkbox--bold kt-checkbox--danger label-danger">
                                            {{ form_widget( form.isVerified ) }} Marquez comme vérifié
                                            <span></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-xl-3 col-lg-3 col-form-label">Avatar</label>
                                <div class="col-lg-9 col-xl-6">
                                    <div class="kt-avatar kt-avatar--outline" id="kt_user_avatar">
                                        <div class="kt-avatar__holder" style="background-image: url('{{ user.avatar ? vich_uploader_asset(user, 'avatarFile') : default_avatar }}');"></div>
                                        <label class="kt-avatar__upload" data-toggle="kt-tooltip" title="" data-original-title="Change avatar">
                                            <i class="fa fa-pen"></i>
                                            <input type="file" id="user_avatarFile_file" name="user[avatarFile][file]" accept=".jpeg, .png, .jpg, .gif">
                                        </label>
                                        <span class="kt-avatar__cancel" data-toggle="kt-tooltip" title="" data-original-title="Cancel avatar">
                                            <i class="fa fa-times"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.username, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                    {{ form_widget( form.username, { 'attr' : { 'class' : 'form-control' } } ) }}
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.email, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        <div class="input-group-prepend"><span class="input-group-text"><i class="la la-at"></i></span></div>
                                    {{ form_widget( form.email, { 'attr' : { 'class' : 'form-control' } } ) }}
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.fullname, "Nom complet", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    {{ form_widget( form.fullname, { 'attr' : { 'class' : 'form-control' } } ) }}
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.status, "Statut", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        {{ form_widget( form.status, { 'attr' : { 'class' : 'form-control' } } ) }}
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-xl-3 col-lg-3 col-form-label">Rôle de l'utilisateur</label>
                                <div class="col-lg-9 col-xl-6">
                                    <div class="kt-checkbox-inline">
                                        <label class="kt-checkbox">
                                            <input type="hidden" name="user[roles][]" value="ROLE_USER" >
                                            <input type="checkbox" id="user_roles_1" class="changed-input" checked disabled>Client
                                            <span></span>
                                        </label>
                                        <label class="kt-checkbox">
                                            <input type="checkbox" id="user_roles_2" name="user[roles][]" value="ROLE_ADMIN" class="changed-input" {{ user.admin? 'checked' : '' }} >Admin
                                            <span></span>
                                        </label>
                                        <label class="kt-checkbox">
                                            <input type="checkbox" id="user_roles_3" name="user[roles][]" value="ROLE_SUPER_ADMIN" class="changed-input" {{ user.superadmin? 'checked' : '' }} >SuperAdmin
                                            <span></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-xl-3"></label>
                                <div class="col-lg-9 col-xl-6">
                                    <h3 class="kt-section__title kt-section__title-sm">Contacts et autres:</h3>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.company, "Entreprise", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    {{ form_widget( form.company, { 'attr' : { 'class' : 'form-control' } } ) }}
                                    <span class="form-text text-muted"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                {{ form_label( form.phone, "Télephone", { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        <div class="input-group-prepend"><span class="input-group-text"><i class="la la-phone"></i></span></div>
                                        {{ form_widget( form.phone, { 'attr' : { 'class' : 'form-control', 'aria-describedby' : 'basic-addon1'} } ) }}
                                    </div>
                                    <span class="form-text text-muted"></span>
                                </div>
                            </div>
                            <div class="form-group form-group-last row">
                                {{ form_label( form.website, "Site web" , { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                <div class="col-lg-9 col-xl-6">
                                    <div class="input-group">
                                        <div class="input-group-prepend"><span class="input-group-text"><i class="la la-at"></i></span></div>
                                        {{ form_widget( form.website, { 'attr' : { 'class' : 'form-control'} } ) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{ form_row( form._token ) }}
            {{ form_end( form, {'render_rest': false}) }}
        </div>
    </div>  
</div>  
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/add-user.js') }}" type="text/javascript" ></script>
{% endblock %}
