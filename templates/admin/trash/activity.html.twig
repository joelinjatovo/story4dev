 <tr data-row="0" class="kt-datatable__row activity-item" style="left: 0px;">
    <td data-field="{% trans %}activity{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="width: 222px;">
            <div class="kt-user-card-v2">
                <div class="kt-user-card-v2__pic">
                    <img alt="avatar" src="{{ activity.project.picture ? vich_uploader_asset(activity.project, 'pictureFile') : default_picture }}">
                </div>
                <div class="kt-user-card-v2__details">
                    <a class="kt-user-card-v2__name" href="#">{{ activity.title }}</a>
                    <span class="kt-user-card-v2__email">{{ activity.project.title }}</span>
                </div>
            </div>
        </span>
    </td>
    <td data-field="{% trans %}project{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="kt-font-bold">{{ activity.project.title }}</span></span>
    </td>
    <td data-field="{% trans %}indicator{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="kt-font-bold">{% transchoice activity.indicators.count %}choice.indicator{% endtranschoice %}</span>
    </td>
    <td data-field="{% trans %}reports{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="kt-font-bold">{% transchoice activity.reports.count %}choice.report{% endtranschoice %}</span>
    </td>
    <td data-field="{% trans %}actions{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="overflow: visible; position: relative; width: 100px;">
            {% if is_granted('ROLE_SUPER_ADMIN') %}
                <a title="{% trans %}button.restore.activity{% endtrans %}" data-id="{{ activity.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-restore">
                    <i class="la la-recycle"></i>
                </a>
                <a title="{% trans %}button.delete{% endtrans %}" data-id="{{ activity.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-remove">
                    <i class="la la-trash"></i>
                </a>
            {% endif %}
        </span>
    </td>
</tr>