{% extends 'admin/base.html.twig' %}

{% block title %}{% trans %}all.periodicities{% endtrans %} - Admin - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}all.periodicities{% endtrans %}</h3>
        </div>        
        <div class="kt-subheader__toolbar">
            <a href="{{ path( 'admin_periodicity_index' ) }}" class="btn btn-label-brand btn-bold">{% trans %}button.add{% endtrans %}</a>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
	<div class="col-xl-8 col-lg-12 order-lg-1 order-xl-1">
		<div class="kt-portlet kt-portlet--height-fluid kt-portlet--mobile ">
            <div class="kt-portlet__body kt-portlet__body--fit">
                <!--begin: Datatable -->
                <div class="kt-datatable kt-datatable--default kt-datatable--brand kt-datatable--loaded" id="local_data" style="">
                    <table class="kt-datatable__table" style="display: block;">
                        <thead class="kt-datatable__head">
                            <tr class="kt-datatable__row" style="left: 0px;">
                                <th data-field="{% trans %}periodicities{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 222px;">{% trans %}periodicities{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}delay{% endtrans %}" class="kt-datatable__cell">
                                    <span style="width: 80px;">{% trans %}delay{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}projects{% endtrans %}" class="kt-datatable__cell">
                                    <span style="width: 120px;">{% trans %}projects{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}actions{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 110px;">{% trans %}actions{% endtrans %}</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="kt-datatable__body">
                            {% for periodicity in periodicities %}
                             <tr data-row="0" class="kt-datatable__row periodicity-item" style="left: 0px;">
                                <td data-field="{% trans %}periodicities{% endtrans %}" class="kt-datatable__cell">
                                    <span style="width: 222px;"><span class="kt-font-bold">{{ periodicity.title }}</span></span>
                                </td>
                                <td data-field="{% trans %}delay{% endtrans %}" class="kt-datatable__cell">
                                    <span style="width: 80px;"><span class="kt-font-bold">{% transchoice periodicity.delay %}choice.day{% endtranschoice %}</span></span>
                                </td>
                                <td data-field="{% trans %}projects{% endtrans %}" class="kt-datatable__cell">
                                    <span style="width: 120px;"><span class="kt-font-bold">{% transchoice periodicity.projects.count %}choice.project{% endtranschoice %}</span></span>
                                </td>
                                <td data-field="{% trans %}actions{% endtrans %}" class="kt-datatable__cell">
                                    <span style="overflow: visible; position: relative; width: 110px;">
                                        <a href="{{ path('admin_periodicity_edit', {id: periodicity.id} ) }}" title="{% trans %}button.edit{% endtrans %}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                                            <i class="la la-edit"></i>
                                        </a>
                                        <a title="{% trans %}button.delete{% endtrans %}" data-id="{{ periodicity.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-remove">
                                            <i class="la la-trash"></i>
                                        </a>
                                    </span>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <!--end: Datatable -->
            </div>
        </div>
    </div>
</div>
{% endblock %}


{% block javascripts %}
<script type="text/javascript">
jQuery(document).ready(function($){
    $(document).on('click', '.btn-remove', function(e){
        e.preventDefault();
        var $this = $(this);
            swal.fire({
                title:"{% trans %}swal.remove.title{% endtrans %}",
                text:"{% trans %}swal.remove.content.activity{% endtrans %}",
                type:"warning",
                showCancelButton:!0,
                confirmButtonText:"{% trans %}button.confirm.delete2{% endtrans %}",
                cancelButtonText:"{% trans %}button.cancel{% endtrans %}"
            }).then(function(e){
                if(e.value){
                    KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
                    $.post("/admin/periodicity/remove", { id: $this.attr('data-id') })
                    .done(function( data ) {
                        KTApp.unblockPage();
                        if(data.success){
                            $this.closest('.periodicity-item').remove();
                            toastr.success(data.message);
                        }else{
                            toastr.error(data.message, data.title);
                        }
                    })
                    .fail(function() {
                        KTApp.unblockPage();
                        toastr.error("{% trans %}swal.error{% endtrans %}");
                    });
                }
            })
    });
});
</script>
{% endblock %}
