{% extends 'base.html.twig' %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">Periodicité</h3>
        </div>        
        <div class="kt-subheader__toolbar">
            <div class="btn-group">
                <a href="{{ path('admin_periodicity_list') }}" class="btn btn-clean btn-icon-sm"><i class="la la-long-arrow-left"></i>Retour</a>
                <button form="periodicity" type="submit" class="btn btn-brand btn-bold">Enregistrer</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="kt-portlet">
    <div class="kt-portlet__body">
        <div class="tab-content  kt-margin-t-20">
            {{ form_start( form, { 'method' : 'POST', 'attr' : {'class' : 'kt-form kt-form--label-right', 'id': 'periodicity' } } ) }}
                <div class="kt-form__body">
                    <div class="kt-section kt-section--first">
                        <div class="kt-section__body">
                            <div class="row">
                                <label class="col-xl-3"></label>
                                <div class="col-lg-9 col-xl-6">
                                    <h3 class="kt-section__title kt-section__title-sm">Periodicité:</h3>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-xl-3 col-lg-3 col-form-label">Titre</label>
                                <div class="col-lg-9 col-xl-6">
                                    {{ form_widget( form.title, { 'attr' : { 'class' : 'form-control'} } ) }}
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-xl-3 col-lg-3 col-form-label">Durée</label>
                                <div class="col-lg-9 col-xl-6">
                                    {{ form_widget( form.delay, { 'attr' : { 'class' : 'form-control'} } ) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="kt-separator kt-separator--space-lg kt-separator--fit kt-separator--border-solid"></div>

                <div class="kt-form__actions">
                    <div class="row">
                        <div class="col-xl-3"></div>
                        <div class="col-lg-9 col-xl-6">
                            <button type="submit" class="btn btn-success">Enregistrer</button>&nbsp;
                            <button type="reset" class="btn btn-secondary">Annuler</button>
                        </div>
                    </div>
                </div>
                {{ form_row( form._token ) }}
            {{ form_end( form, {'render_rest': false}) }}
        </div>
    </div>
</div>
{% endblock %}


{% block javascripts %}
{% endblock %}
