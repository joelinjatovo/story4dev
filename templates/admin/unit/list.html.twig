{% extends 'admin/base.html.twig' %}

{% block title %}{% trans %}all.units{% endtrans %} - {% trans %}admin{% endtrans %} - {{ app.user.fullname }}{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
        <div class="kt-subheader__main">
            <h3 class="kt-subheader__title">{% trans %}all.units{% endtrans %}</h3>
        </div>        
        <div class="kt-subheader__toolbar">
            <a href="{{ path( 'admin_unit_index' ) }}" class="btn btn-label-brand btn-bold">{% trans %}button.add{% endtrans %}</a>
            <div class="kt-subheader__wrapper">
                <div class="dropdown dropdown-inline" data-toggle="kt-tooltip-" title="{% trans %}actions{% endtrans %}" data-placement="left">
                    <a href="#" class="btn btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1" class="kt-svg-icon kt-svg-icon--success kt-svg-icon--md">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <polygon id="Shape" points="0 0 24 0 24 24 0 24"></polygon>
                                <path d="M5.85714286,2 L13.7364114,2 C14.0910962,2 14.4343066,2.12568431 14.7051108,2.35473959 L19.4686994,6.3839416 C19.8056532,6.66894833 20,7.08787823 20,7.52920201 L20,20.0833333 C20,21.8738751 19.9795521,22 18.1428571,22 L5.85714286,22 C4.02044787,22 4,21.8738751 4,20.0833333 L4,3.91666667 C4,2.12612489 4.02044787,2 5.85714286,2 Z" id="Combined-Shape" fill="#000000" fill-rule="nonzero" opacity="0.3"></path>
                                <path d="M11,14 L9,14 C8.44771525,14 8,13.5522847 8,13 C8,12.4477153 8.44771525,12 9,12 L11,12 L11,10 C11,9.44771525 11.4477153,9 12,9 C12.5522847,9 13,9.44771525 13,10 L13,12 L15,12 C15.5522847,12 16,12.4477153 16,13 C16,13.5522847 15.5522847,14 15,14 L13,14 L13,16 C13,16.5522847 12.5522847,17 12,17 C11.4477153,17 11,16.5522847 11,16 L11,14 Z" id="Combined-Shape" fill="#000000"></path>
                            </g>
                        </svg>
                    </a>
                    <div class="dropdown-menu dropdown-menu-fit dropdown-menu-md dropdown-menu-right">
                        <!--begin::Nav-->
                        <ul class="kt-nav">
                            <li class="kt-nav__head">
                                {% trans %}button.new{% endtrans %}:                                    
                                <i class="flaticon2-information" data-toggle="kt-tooltip" data-placement="right" title="" data-original-title="{% trans %}button.new{% endtrans %}"></i>
                            </li>
                            <li class="kt-nav__separator"></li>
                            <li class="kt-nav__item">
                                <a href="{{ path( 'admin_project_index' ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-drop"></i>
                                    <span class="kt-nav__link-text">{% trans %}project{% endtrans %}</span>
                                </a>
                            </li>        
                            <li class="kt-nav__item">
                                <a href="{{ path( 'admin_user_index' ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-drop"></i>
                                    <span class="kt-nav__link-text">{% trans %}user{% endtrans %}</span>
                                </a>
                            </li>                        
                            <li class="kt-nav__item">
                                <a href="{{ path( 'admin_unit_index' ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-new-email"></i>
                                    <span class="kt-nav__link-text">{% trans %}unit{% endtrans %}</span>
                                </a>
                            </li>                        
                            <li class="kt-nav__item">
                                <a href="{{ path( 'admin_periodicity_index' ) }}" class="kt-nav__link">
                                    <i class="kt-nav__link-icon flaticon2-new-email"></i>
                                    <span class="kt-nav__link-text">{% trans %}periodicity{% endtrans %}</span>
                                </a>
                            </li>
                        </ul>
                        <!--end::Nav-->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
	<div class="col-xl-8 col-lg-12 order-lg-1 order-xl-1">
		<div class="kt-portlet kt-portlet--height-fluid kt-portlet--mobile ">
            <div class="kt-portlet__body kt-portlet__body--fit">
                <!--begin: Datatable -->
                <div class="kt-datatable kt-datatable--default kt-datatable--brand kt-datatable--loaded" id="local_data" style="">
                    <table class="kt-datatable__table" style="display: block;">
                        <thead class="kt-datatable__head">
                            <tr class="kt-datatable__row" style="left: 0px;">
                                <th data-field="{% trans %}units{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 222px;">{% trans %}units{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}labels{% endtrans %}" class="kt-datatable__cell">
                                    <span style="width: 80px;">{% trans %}labels{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}indicators{% endtrans %}" class="kt-datatable__cell">
                                    <span style="width: 120px;">{% trans %}indicators{% endtrans %}</span>
                                </th>
                                <th data-field="{% trans %}actions{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell kt-datatable__cell--sort">
                                    <span style="width: 110px;">{% trans %}actions{% endtrans %}</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="kt-datatable__body">
                            {% for unit in units %}
                             <tr data-row="0" class="kt-datatable__row unit-item" style="left: 0px;">
                                <td data-field="{% trans %}unit{% endtrans %}" class="kt-datatable__cell">
                                    <span style="width: 222px;"><span class="kt-font-bold">{{ unit.title }}</span></span>
                                </td>
                                <td data-field="{% trans %}label{% endtrans %}" class="kt-datatable__cell">
                                    <span style="width: 80px;"><span class="kt-font-bold">{{ unit.label }}</span></span>
                                </td>
                                <td data-field="{% trans %}indicator{% endtrans %}" class="kt-datatable__cell">
                                    <span style="width: 120px;"><span class="kt-font-bold">{% transchoice unit.indicators.count %}choice.indicator{% endtranschoice %}</span></span>
                                </td>
                                <td data-field="{% trans %}action{% endtrans %}" class="kt-datatable__cell">
                                    <span style="overflow: visible; position: relative; width: 110px;">
                                        <a href="{{ path('admin_unit_edit', {id: unit.id} ) }}" title="{% trans %}button.edit{% endtrans %}" class="btn btn-sm btn-clean btn-icon btn-icon-md">
                                            <i class="la la-edit"></i>
                                        </a>
                                        <a title="{% trans %}button.delete{% endtrans %}" data-id="{{ unit.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-remove">
                                            <i class="la la-trash"></i>
                                        </a>
                                    </span>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <!--end: Datatable -->
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script type="text/javascript">
jQuery(document).ready(function($){
    $(document).on('click', '.btn-remove', function(e){
        e.preventDefault();
        var $this = $(this);
            swal.fire({
                title:"{% trans %}swal.remove.title{% endtrans %}",
                text:"{% trans %}swal.remove.content.report{% endtrans %}",
                type:"warning",
                showCancelButton:!0,
                confirmButtonText:"{% trans %}button.confirm.delete2{% endtrans %}",
                cancelButtonText:"{% trans %}button.cancel{% endtrans %}"
            }).then(function(e){
                if(e.value){
                    KTApp.blockPage({overlayColor: '#000000',type: 'v2',state: 'success',size: 'xl'});
                    $.post("/admin/unit/remove", { id: $this.attr('data-id') })
                    .done(function( data ) {
                        KTApp.unblockPage();
                        if(data.success){
                            $this.closest('.unit-item').remove();
                            toastr.success(data.message);
                        }else{
                            toastr.error(data.message, data.title);
                        }
                    })
                    .fail(function() {
                        KTApp.unblockPage();
                        toastr.error("{% trans %}swal.error{% endtrans %}");
                    });
                }
            })
    });
});
</script>
{% endblock %}
