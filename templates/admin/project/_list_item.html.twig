 <tr data-row="0" class="kt-datatable__row project-item" style="left: 0px;">
    <td data-field="{% trans %}project{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="width: 222px;">
            <div class="kt-user-card-v2">
                <div class="kt-user-card-v2__pic">
                    <img alt="avatar" src="{{ project.picture ? vich_uploader_asset(project, 'pictureFile') | imagine_filter('thumb') : default_picture }}">
                </div>
                <div class="kt-user-card-v2__details">
                    {% if is_granted('view', project) %}
                        <a class="kt-user-card-v2__name" href="{{ url('project_show', { slug : project.slug}) }}">{{ project.title }}</a>
                    {% else %}
                        <a class="kt-user-card-v2__name" href="#">{{ project.title }}</a>
                    {% endif %}
                    <span class="kt-user-card-v2__email">{{ project.author.email }}</span>
                </div>
            </div>
        </span>
    </td>
    <td data-field="{% trans %}user{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="kt-font-bold">{{ project.author.fullname }}</span></span>
    </td>
    <td data-field="{% trans %}date.started{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="btn btn-bold btn-sm btn-font-sm  btn-label-success">{{ project.startat|date("Y-m-d") }}</span></span>
    </td>
    <td data-field="{% trans %}date.ended{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 100px;"><span class="btn btn-bold btn-sm btn-font-sm  btn-label-danger">{{ project.endat|date("Y-m-d") }}</span></span>
    </td>
    <td data-field="{% trans %}data{% endtrans %}" class="kt-datatable__cell">
        <span style="width: 100px;">{{ project.contributions.count }} contributeurs / {% transchoice project.activities.count %}choice.activity{% endtranschoice %} </span>
    </td>
    <td data-field="{% trans %}action{% endtrans %}" data-autohide-disabled="false" class="kt-datatable__cell">
        <span style="overflow: visible; position: relative; width: 100px;">
            {% if is_granted('ROLE_SUPER_ADMIN') %}
                <a title="{% trans %}button.delete.project{% endtrans %}" data-id="{{ project.id }}" class="btn btn-sm btn-clean btn-icon btn-icon-md btn-remove">
                    <i class="la la-trash"></i>
                </a>
            {% endif %}
        </span>
    </td>
</tr>