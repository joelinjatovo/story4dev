<!--begin::Modal-->
<div class="modal fade" id="kt_modal_add_activity" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <form method="post" class="modal-dialog modal-sm" role="document">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" >
        <input type="hidden" name="project" value="{{ project.id }}" >
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">New activity</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="activity-title" class="form-control-label">Title:</label>
                    <input type="text" class="form-control" id="activity-title" name="title">
                </div>
                <div class="form-group">
                    <label for="activity-budget" class="form-control-label">Budget:</label>
                    <input type="text" class="form-control" id="activity-budget" name="budget">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="kt_add_activity_submit">Save activity</button>
            </div>
        </div>
    </form>
</div>
<!--end::Modal-->
    
