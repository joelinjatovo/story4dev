{% extends 'base.html.twig' %}

{% block stylesheets %}
{% endblock %}

{% block subheader %}
<div class="kt-subheader   kt-grid__item" id="kt_subheader">
    <div class="kt-container  kt-container--fluid ">
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
   	<div class="col-lg-12">	
        <div style="min-height: 800px;" class="kt-portlet kt-portlet--last kt-portlet--head-lg kt-portlet--responsive-mobile" id="kt_page_portlet">
            <div class="kt-portlet__head kt-portlet__head--lg" style="">
                <div class="kt-portlet__head-label">
                    <h3 class="kt-portlet__head-title">Paramètres <small>configurer le site web ici</small></h3>
                </div>
                <div class="kt-portlet__head-toolbar">
                    <a href="{{ path('admin_index') }}" class="btn btn-clean kt-margin-r-10">
                        <i class="la la-arrow-left"></i>
                        <span class="kt-hidden-mobile">Retour</span>
                    </a>
                    <div class="btn-group">
                        <button type="submit" form="setting" name="submit" value="save-default" class="btn btn-brand">
                            <i class="la la-check"></i> 
                            <span class="kt-hidden-mobile">Enregistrer</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="kt-portlet__body">
                {{ form_start( form, { 'method' : 'POST', 'attr' : {'class' : 'kt-form kt-form--label-right', 'id': 'settings' } } ) }}
                    <div class="kt-form__body">
                        <div class="kt-section kt-section--first">
                            <div class="kt-section__body">
                                {% for form_child in form %}
                                    {% if '__row_group' in form_child.vars.name %}
                                        <div class="row">
                                            <label class="col-xl-3"></label>
                                            <div class="col-lg-9 col-xl-6">
                                                <h3 class="kt-section__title kt-section__title-sm">{{ form_child.vars.label }} :</h3>
                                            </div>
                                        </div>
                                    {% elseif form_child.vars.name != '_token' %}
                                        <div class="form-group row">
                                            {{ form_label( form_child, null, { 'label_attr': { 'class': 'col-xl-3 col-lg-3 col-form-label' } } ) }}
                                            <div class="col-lg-9 col-xl-6">
                                                {% for form_child2 in form_child %}
                                                    {{ form_widget(form_child2, { 'attr' : { 'class' : 'form-control'} } ) }}
                                                {% endfor %}
                                                {% if form_child.vars.help is not empty %}
                                                    <span class="form-text text-muted">{{ form_child.vars.help }}</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    {{ form_row( form._token ) }}
                {{ form_end( form, {'render_rest': false}) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}


{% block javascripts %}
{% endblock %}
